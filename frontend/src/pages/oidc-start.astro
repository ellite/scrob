---
import { api } from "../lib/api";
import { getLocale } from "../paraglide/runtime.js";
import { m } from "../paraglide/messages.js";

// Initiate the OIDC flow: get the provider's auth URL + a fresh state token from
// the backend, set the state as an httpOnly cookie on the browser, then redirect
// the browser to the provider. The backend is never contacted by the browser directly.

let errorMsg = "";

// Same validation as login.astro's `next` handling - only a same-site path
// is a safe redirect target once the provider sends the browser back.
const rawNext = Astro.url.searchParams.get("next") || "";
const nextPath = rawNext.startsWith("/") && !rawNext.startsWith("//") ? rawNext : "/";

try {
  const { auth_url, state } = await api.auth.oidcAuthorize();

  Astro.cookies.set("oidc_state", state, {
    path: "/",
    httpOnly: true,
    secure: import.meta.env.PROD,
    sameSite: "lax",
    maxAge: 600, // 10 minutes
  });
  Astro.cookies.set("oidc_next", nextPath, {
    path: "/",
    httpOnly: true,
    secure: import.meta.env.PROD,
    sameSite: "lax",
    maxAge: 600, // 10 minutes
  });

  return Astro.redirect(auth_url);
} catch (e: unknown) {
  errorMsg = e instanceof Error ? e.message : m.oidc_start_failed();
}
---

<!DOCTYPE html>
<html lang={getLocale()}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{m.oidc_error_title()}</title>
  </head>
  <body>
    <p>{errorMsg}</p>
    <a href="/login">{m.auth_back_to_login()}</a>
  </body>
</html>
