---
import { PAGE_SIZES } from "../lib/page-size.js";
import { m } from "../paraglide/messages.js";
interface Props { value: number }
const { value } = Astro.props;
---
<label class="inline-flex items-center gap-2 text-sm text-zinc-400">
  {m.pagination_items_per_page()}
  <select data-page-size class="bg-zinc-900 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-100 focus:ring-2 focus:ring-blue-500">
    {PAGE_SIZES.map(size => <option value={size} selected={size === value}>{size}</option>)}
  </select>
</label>
<script>
  import { pageSizeUrl } from "../lib/page-size.js";
  document.querySelectorAll<HTMLSelectElement>('[data-page-size]').forEach(select => {
    select.addEventListener('change', () => {
      window.location.href = pageSizeUrl(window.location.href, Number(select.value));
    });
  });
</script>
