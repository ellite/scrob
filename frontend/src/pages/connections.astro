---
import Base from "../layouts/Base.astro";
import { api } from "../lib/api";

const { token } = Astro.locals;
const [settings, me, connections, scrobbleConnections, seasonOverrides] = await Promise.all([
  api.auth.getSettings(token!),
  api.auth.me(token!),
  api.auth.getConnections(token!),
  api.auth.getScrobbleConnections(token!),
  api.sync.getSeasonOverrides(token!).catch(() => []),
]);
const hasTmdbKey = settings.has_effective_tmdb_key;
const AUTO_SYNC_INTERVAL_OPTIONS = [
  { value: 0.25, label: "Every 15m" },
  { value: 0.5, label: "Every 30m" },
  { value: 1, label: "Every 1h" },
  { value: 3, label: "Every 3h" },
  { value: 6, label: "Every 6h" },
  { value: 12, label: "Every 12h" },
  { value: 24, label: "Every 24h" },
  { value: 48, label: "Every 48h" },
];
const traktConfigured    = !!(settings.trakt_connected || settings.trakt_client_id);
const radarrConfigured   = !!(settings.radarr_url && settings.radarr_token);
const sonarrConfigured   = !!(settings.sonarr_url && settings.sonarr_token);
---

<Base title="Connections">
  <div id="app-data" data-token={token} class="hidden" aria-hidden="true"></div>
  <div class="max-w-4xl mx-auto">
    <h1 class="page-title mb-8">Connections</h1>

    <div id="js-message" class="hidden fixed top-4 right-4 z-[200] max-w-sm p-4 rounded-lg shadow-2xl border"></div>

    <div class="space-y-12">
      <section>
        <form id="connections-form" class="space-y-6">
          <!-- ======== SYNC SECTION ======== -->
          <div class="space-y-3 mt-8">
            <h2 class="section-headline border-b border-zinc-800 pb-2">Media Players</h2>

            <!-- Connections list (server-side rendered, managed client-side) -->
            <div id="connections-list" class="space-y-3">
            {connections.map((conn) => {
              const typeColor = conn.type === "jellyfin" ? "bg-purple-500" : conn.type === "emby" ? "bg-green-500" : conn.type === "plex" ? "bg-yellow-500" : conn.type === "stremio" ? "bg-blue-500" : "bg-cyan-500";
              const typeLabel = conn.type === "jellyfin" ? "Jellyfin" : conn.type === "emby" ? "Emby" : conn.type === "plex" ? "Plex" : conn.type === "stremio" ? "Stremio" : "Nuvio";
              return (
              <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden" data-connection-id={conn.id}>
                <div class="collapsible-header flex items-center justify-between px-6 py-4 hover:bg-zinc-900/40 cursor-pointer transition-colors select-none" data-target={`conn-body-${conn.id}`}>
                  <div class="flex items-center gap-3 pointer-events-none">
                    <span class={`w-2 h-2 ${typeColor} rounded-full shrink-0`}></span>
                    <div class="flex flex-col gap-0.5">
                      <span class="font-medium text-zinc-200 flex items-center gap-2">
                        {conn.name}
                        <span id={`conn-status-${conn.id}`} class="hidden text-xs font-normal px-1.5 py-0.5 rounded pointer-events-auto"></span>
                      </span>
                      <span class="text-xs text-zinc-500">{typeLabel} · {conn.url}</span>
                    </div>
                  </div>
                  <div class="flex items-center gap-2">
                    <div class="flex items-center gap-2" onclick="event.stopPropagation()">
                      <button type="button" data-action="delete_connection" data-conn-id={conn.id} data-conn-name={conn.name}
                        class="js-action-btn text-sm bg-zinc-800 hover:bg-red-900/30 text-red-400 border border-zinc-700 hover:border-red-700 px-3 py-1.5 rounded-lg transition-colors cursor-pointer"
                      >Delete</button>
                    </div>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="collapsible-chevron w-4 h-4 text-zinc-500 transition-transform pointer-events-none ml-1 shrink-0">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                  </div>
                </div>
                <!-- Per-connection sync/push progress strip -->
                <div id={`conn-progress-${conn.id}`} class="hidden border-t border-zinc-800 px-6 py-3">
                  <div class="flex justify-between items-center mb-1.5">
                    <span id={`conn-job-label-${conn.id}`} class="text-xs font-semibold uppercase tracking-wider text-zinc-500">Working…</span>
                    <div class="flex items-center gap-3">
                      <span id={`conn-job-pct-${conn.id}`} class="text-xs font-bold text-zinc-400">0%</span>
                      <button type="button" id={`conn-job-cancel-${conn.id}`} class="hidden cursor-pointer text-xs font-semibold text-zinc-400 hover:text-red-400 border border-zinc-700 hover:border-red-500/50 px-2 py-0.5 rounded-md transition-colors">Cancel</button>
                    </div>
                  </div>
                  <div class="w-full bg-zinc-800 rounded-full h-1.5 overflow-hidden">
                    <div id={`conn-job-bar-${conn.id}`} class="h-1.5 rounded-full transition-all duration-500 bg-blue-600" style="width: 0%"></div>
                  </div>
                  <div class="flex justify-between text-xs text-zinc-500 mt-1">
                    <span id={`conn-job-items-${conn.id}`}></span>
                    <span id={`conn-job-status-${conn.id}`}></span>
                  </div>
                </div>
                <div id={`conn-warnings-${conn.id}`} class="hidden px-4 pb-3 pt-0"></div>
                <div id={`conn-body-${conn.id}`} class="border-t border-zinc-800 hidden">
                  <div class="grid md:grid-cols-2 gap-8 px-6 py-6">
                    <!-- Left: Connection details -->
                    <div class="space-y-4">
                      <div class={`space-y-2 ${conn.type === "stremio" ? "hidden" : ""}`}>
                        <label class="block text-sm font-medium text-zinc-400">{conn.type === "nuvio" ? "Cloud API URL" : "Server URL"}</label>
                        <input type="url" class="conn-url-input w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all disabled:opacity-70" value={conn.url} data-conn-id={conn.id} disabled={conn.type === "nuvio"} />
                      </div>
                      <div class={`space-y-2 ${conn.type === "stremio" ? "hidden" : ""}`}>
                        <label class="block text-sm font-medium text-zinc-400">{conn.type === "plex" ? "X-Plex-Token" : conn.type === "nuvio" ? "Refresh Token" : "API Token"}</label>
                        <div class="relative">
                          <input type="password" class="conn-token-input w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" value={conn.token} data-conn-id={conn.id} />
                          <button type="button" class="password-toggle absolute right-2 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 p-1 cursor-pointer transition-colors" aria-label="Toggle token visibility">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-icon"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.644C3.412 7.943 7.213 5 12 5c4.787 0 8.588 2.943 9.964 6.678.066.18.066.362 0 .544C20.588 16.057 16.787 19 12 19c-4.787 0-8.588-2.943-9.964-6.678z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-slash-icon hidden"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" /></svg>
                          </button>
                        </div>
                      </div>
                      {conn.type === "stremio" && (
                        <div class="rounded-xl border border-blue-500/20 bg-blue-500/5 p-4 space-y-1">
                          <p class="text-sm font-medium text-zinc-200">Connected Stremio account</p>
                          <p class="text-sm text-zinc-400">{conn.server_username || "Account connected"}</p>
                          <p class="text-xs text-zinc-500">The account key is stored server-side and is never exposed here.</p>
                        </div>
                      )}
                      {conn.type === "stremio" && (
                        <div class="stremio-reauth hidden space-y-2" data-conn-id={conn.id}>
                          <button type="button" class="stremio-reauth-toggle text-sm text-blue-400 hover:text-blue-300 cursor-pointer transition-colors">
                            Disconnected? Reconnect Stremio
                          </button>
                          <div class="stremio-reauth-panel hidden space-y-3 rounded-xl border border-zinc-800 bg-zinc-950/50 p-4">
                            <p class="text-xs text-zinc-500">Reconnecting replaces the stored account key and keeps your existing sync settings.</p>
                            <button type="button" class="stremio-reauth-start text-sm bg-blue-600 hover:bg-blue-500 text-white px-3 py-1.5 rounded-lg transition-colors cursor-pointer">Reconnect Stremio</button>
                            <div class="stremio-reauth-details hidden space-y-3">
                              <a class="stremio-reauth-url block text-sm text-blue-400 hover:text-blue-300 underline" href="#" target="_blank" rel="noopener noreferrer">Open Stremio authorization</a>
                              <p class="text-sm text-zinc-400">Code: <strong class="stremio-reauth-code font-mono text-zinc-100"></strong></p>
                              <img class="stremio-reauth-qr w-40 h-40 rounded-lg bg-white p-2" alt="Stremio authorization QR code" />
                              <p class="stremio-reauth-status text-xs text-zinc-500">Waiting for authorization…</p>
                            </div>
                          </div>
                        </div>
                      )}
                      {conn.type === "nuvio" && (
                        <div class="nuvio-reauth hidden space-y-2" data-conn-id={conn.id}>
                          <button type="button" class="nuvio-reauth-toggle text-sm text-blue-400 hover:text-blue-300 cursor-pointer transition-colors">
                            Refresh token stopped working? Sign in again
                          </button>
                          <div class="nuvio-reauth-form hidden space-y-2 rounded-xl border border-zinc-800 bg-zinc-950/50 p-4">
                            <p class="text-xs text-zinc-500">Signing in replaces the refresh token above with a fresh one and reconnects immediately.</p>
                            <input type="email" class="nuvio-reauth-email w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" placeholder="Nuvio email" autocomplete="username" />
                            <input type="password" class="nuvio-reauth-password w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" placeholder="Nuvio password" autocomplete="current-password" />
                            <div class="flex items-center gap-2">
                              <button type="button" class="nuvio-reauth-submit text-sm bg-blue-600 hover:bg-blue-500 text-white px-3 py-1.5 rounded-lg transition-colors cursor-pointer">Sign in</button>
                              <span class="nuvio-reauth-status text-xs text-zinc-500"></span>
                            </div>
                          </div>
                        </div>
                      )}
                      {conn.type === "nuvio" ? (
                        <div class="space-y-2">
                          <label class="block text-sm font-medium text-zinc-400">Nuvio Profile</label>
                          <select aria-label="Nuvio profile" class="conn-user-id-input w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all cursor-pointer" data-conn-id={conn.id}>
                            <option value={conn.server_user_id || ""}>{conn.server_username || `Profile ${conn.server_user_id}`} (#{conn.server_user_id})</option>
                          </select>
                        </div>
                      ) : conn.type !== "plex" && conn.type !== "stremio" && (
                        <div class="space-y-2">
                          <label class="block text-sm font-medium text-zinc-400">User ID</label>
                          <input type="text" class="conn-user-id-input w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" value={conn.server_user_id || ""} data-conn-id={conn.id} />
                        </div>
                      )}
                      {conn.type === "plex" && (
                        <div class="space-y-2">
                          <label class="block text-sm font-medium text-zinc-400">Plex Username</label>
                          <p class="text-xs text-zinc-500">Required to attribute events when multiple users share a server.</p>
                          <input type="text" class="conn-username-input w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" value={conn.server_username || ""} data-conn-id={conn.id} />
                        </div>
                      )}
                      {conn.type !== "nuvio" && conn.type !== "stremio" && (
                        <>
                          <div class="space-y-2">
                            <label class="block text-sm font-medium text-zinc-400">Libraries to sync</label>
                            <div class={`conn-library-picker`} data-conn-id={conn.id} data-conn-type={conn.type}>
                              <div class="conn-libraries-list space-y-1 text-sm text-zinc-500 italic">Checking connection…</div>
                              <p class="text-xs text-zinc-400 mt-1">Leave all unchecked to sync every library.</p>
                              <div class="mt-3">
                                <button type="button" data-action="scan_libraries" data-conn-id={conn.id} class="js-action-btn text-sm bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 px-4 py-2 rounded-lg transition-colors cursor-pointer">Trigger library scan</button>
                              </div>
                            </div>
                          </div>
                          <div class="space-y-2">
                            <label class="block text-sm font-medium text-zinc-400">Webhook URL</label>
                            <div class="flex gap-2">
                              <input type="text" readonly class="conn-webhook-url flex-1 bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-zinc-300 font-mono text-xs focus:outline-none cursor-default select-all" value="" data-conn-id={conn.id} data-conn-type={conn.type} />
                              <button type="button" class="conn-copy-webhook px-3 py-2 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 rounded-lg transition-colors cursor-pointer" data-conn-id={conn.id}>
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" /></svg>
                              </button>
                            </div>
                          </div>
                        </>
                      )}
                    </div>
                    <!-- Right: Sync Preferences -->
                    <div class="space-y-4">
                      <div class="bg-zinc-950 rounded-xl p-4 space-y-3">
                        <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">{typeLabel} → Scrob</p>
                        {[
                          { key: "sync_collection", label: "Collection status" },
                          { key: "sync_watched", label: "Watched status" },
                          ...(conn.type === "nuvio" || conn.type === "stremio" ? [] : [{ key: "sync_ratings", label: "Ratings" }]),
                          { key: "sync_playback", label: conn.type === "nuvio" || conn.type === "stremio" ? "Playback progress" : "Playback events" },
                          ...(conn.type === "plex" ? [{ key: "plex_sync_watchlist", label: "Watchlist" }] : []),
                        ].map(({ key, label }) => (
                          <label class="flex items-center gap-3 cursor-pointer group">
                            <input type="checkbox" class="conn-pref-checkbox w-4 h-4 rounded cursor-pointer" data-conn-id={conn.id} data-pref={key} checked={conn[key as keyof typeof conn] !== false} />
                            <span class="text-sm text-zinc-300 group-hover:text-zinc-100 transition-colors">{label}</span>
                          </label>
                        ))}
                        <div class="flex items-center gap-3">
                          <button type="button" data-action="sync_connection" data-conn-id={conn.id} data-conn-type={conn.type} data-conn-name={conn.name}
                            disabled={!hasTmdbKey}
                            title={!hasTmdbKey ? "TMDB Read Access Token is required for sync" : conn.type === "nuvio" || conn.type === "stremio" ? `Sync ${typeLabel} library, watched status, and playback progress` : `Pull from ${conn.name}`}
                            class={`js-action-btn text-sm px-3 py-1.5 rounded-lg transition-colors cursor-pointer disabled:opacity-50 ${hasTmdbKey ? "bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700" : "bg-zinc-800 text-zinc-400 border border-zinc-700 opacity-50"}`}
                          >{conn.type === "nuvio" || conn.type === "stremio" ? "Sync now" : "Pull"}</button>
                          {conn.type === "stremio" && (
                            <button type="button" data-action="full_resync_connection" data-conn-id={conn.id} data-conn-name={conn.name}
                              disabled={!hasTmdbKey}
                              class="js-action-btn text-sm px-3 py-1.5 rounded-lg transition-colors cursor-pointer disabled:opacity-50 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700"
                            >Full resync</button>
                          )}
                          <span id={`${conn.type}-last-sync`} class="hidden text-xs text-zinc-500"></span>
                        </div>
                      </div>
                      <div class="bg-zinc-950 rounded-xl p-4 space-y-3">
                        <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Scrob → {typeLabel}</p>
                        {[
                          ...(conn.type === "nuvio" || conn.type === "stremio" ? [{ key: "push_collection", label: "Collection status" }] : []),
                          { key: "push_watched", label: "Watched status" },
                          ...(conn.type === "nuvio" || conn.type === "stremio" ? [{ key: "push_playback", label: "Playback progress" }] : []),
                          ...(conn.type === "nuvio" || conn.type === "stremio" ? [] : [{ key: "push_ratings", label: "Ratings" }]),
                          ...(conn.type === "plex" ? [{ key: "plex_push_watchlist", label: "Watchlist" }] : []),
                        ].map(({ key, label }) => (
                          <label class="flex items-center gap-3 cursor-pointer group">
                            <input type="checkbox" class="conn-pref-checkbox w-4 h-4 rounded cursor-pointer" data-conn-id={conn.id} data-pref={key} checked={!!conn[key as keyof typeof conn]} />
                            <span class="text-sm text-zinc-300 group-hover:text-zinc-100 transition-colors">{label}</span>
                          </label>
                        ))}
                        <button type="button" data-action="push_upstream" data-conn-id={conn.id} data-conn-name={conn.name}
                          title={`Push enabled data from Scrob to ${conn.name}`}
                          class="js-action-btn text-sm bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 px-3 py-1.5 rounded-lg transition-colors cursor-pointer"
                        >Push</button>
                      </div>
                      <div class="bg-zinc-950 rounded-xl p-4 space-y-3">
                        <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Auto Sync</p>
                        <div class="flex items-center justify-between gap-4">
                          <label class="text-sm text-zinc-300">Pull interval</label>
                          <select class="conn-auto-sync bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-sm text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all cursor-pointer" data-conn-id={conn.id}>
                            <option value="" selected={!conn.auto_sync_interval}>Disabled</option>
                            {AUTO_SYNC_INTERVAL_OPTIONS.map(({ value, label }) => (
                              <option value={String(value)} selected={conn.auto_sync_interval === value}>{label}</option>
                            ))}
                          </select>
                        </div>
                        <div class="flex items-center justify-between gap-4">
                          <label class="text-sm text-zinc-300">Push interval</label>
                          <select class="conn-auto-push bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-sm text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all cursor-pointer" data-conn-id={conn.id}>
                            <option value="" selected={!conn.auto_push_interval}>Disabled</option>
                            {AUTO_SYNC_INTERVAL_OPTIONS.map(({ value, label }) => (
                              <option value={String(value)} selected={conn.auto_push_interval === value}>{label}</option>
                            ))}
                          </select>
                        </div>
                      </div>
                      {conn.type === "plex" && (
                        <div class="bg-zinc-950 rounded-xl p-4 space-y-3">
                          <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">Watchlist → Radarr / Sonarr</p>
                          <p class="text-xs text-zinc-500">Automatically request items added to your Plex watchlist. Requires Radarr / Sonarr to be configured in settings.</p>
                          {[
                            { key: "watchlist_to_radarr", label: "Movies → Radarr" },
                            { key: "watchlist_to_sonarr", label: "Shows → Sonarr" },
                          ].map(({ key, label }) => (
                            <label class="flex items-center gap-3 cursor-pointer group">
                              <input type="checkbox" class="conn-pref-checkbox w-4 h-4 rounded cursor-pointer" data-conn-id={conn.id} data-pref={key} checked={!!conn[key as keyof typeof conn]} />
                              <span class="text-sm text-zinc-300 group-hover:text-zinc-100 transition-colors">{label}</span>
                            </label>
                          ))}
                          <div class="flex items-center justify-between gap-3">
                            <label class="flex items-center gap-3 cursor-pointer group">
                              <input
                                type="checkbox"
                                class="conn-pref-checkbox plex-monitor-users-toggle w-4 h-4 rounded cursor-pointer"
                                data-conn-id={conn.id}
                                data-pref="watchlist_all_users"
                                checked={!!conn.watchlist_all_users}
                              />
                              <span class="text-sm text-zinc-300 group-hover:text-zinc-100 transition-colors">Also monitor users</span>
                            </label>
                            <button type="button" class="plex-user-picker-toggle text-xs text-zinc-400 hover:text-zinc-200 transition-colors flex items-center gap-1" data-conn-id={conn.id}>
                              <span class="plex-user-picker-toggle-label">Select users</span>
                              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="plex-user-picker-chevron w-3 h-3 transition-transform"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                            </button>
                          </div>
                          <div class="plex-user-picker space-y-2 hidden" data-conn-id={conn.id} data-monitored={JSON.stringify(conn.watchlist_monitored_users || [])}>
                            <div class="plex-user-list pl-1 space-y-2">
