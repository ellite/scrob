    // ── Customize-on-add modal (admin-only - root folder/quality profile/
    // tags/season-folder override for one Radarr/Sonarr add) ────────────────
    let _customizeAddTags: number[] = [];

    function closeCustomizeAddPopover() {
      document.getElementById('customize-add-popover')!.classList.add('hidden');
    }

    function renderCustomizeAddTags(tags: any[], selectedIds: number[]) {
      const container = document.getElementById('customize-add-tags')!;
      if (!tags || tags.length === 0) {
        container.innerHTML = '<span class="text-xs text-zinc-500 italic px-1">No tags found</span>';
        return;
      }
      container.innerHTML = tags.map((tag: any) => {
        const isSelected = selectedIds.includes(tag.id);
        return `<button type="button" data-tag-id="${tag.id}" class="customize-add-tag-pill px-2 py-1 text-xs font-medium rounded-md border transition-colors cursor-pointer ${isSelected ? 'ring-1 ring-blue-500 border-blue-500/50 bg-blue-500/10 text-zinc-100' : 'bg-zinc-800 hover:bg-zinc-700 border-zinc-700 text-zinc-300'}">${esc(tag.label)}</button>`;
      }).join('');
      container.querySelectorAll('.customize-add-tag-pill').forEach((pill) => {
        pill.addEventListener('click', () => {
          const id = parseInt((pill as HTMLElement).dataset.tagId!);
          const selected = _customizeAddTags.includes(id);
          if (selected) {
            _customizeAddTags = _customizeAddTags.filter(t => t !== id);
          } else {
            _customizeAddTags.push(id);
          }
          pill.classList.toggle('ring-1', !selected);
          pill.classList.toggle('ring-blue-500', !selected);
          pill.classList.toggle('border-blue-500/50', !selected);
          pill.classList.toggle('bg-blue-500/10', !selected);
          pill.classList.toggle('text-zinc-100', !selected);
          pill.classList.toggle('bg-zinc-800', selected);
          pill.classList.toggle('text-zinc-300', selected);
        });
      });
    }

    async function openCustomizeAddPopover(mediaType: string, onConfirm: (overrides: Record<string, unknown>) => Promise<void>) {
      const popover = document.getElementById('customize-add-popover')!;
      const loading = document.getElementById('customize-add-loading')!;
      const body = document.getElementById('customize-add-body')!;
      const footer = document.getElementById('customize-add-footer')!;
      const errorEl = document.getElementById('customize-add-error')!;
      const seasonRow = document.getElementById('customize-add-season-folder-row')!;
      const isSeries = mediaType === 'series';

      document.getElementById('customize-add-title')!.textContent = isSeries ? 'Add to Sonarr' : 'Add to Radarr';
      loading.classList.remove('hidden');
      body.classList.add('hidden');
      footer.classList.add('hidden');
      errorEl.classList.add('hidden');
      seasonRow.classList.toggle('hidden', !isSeries);
      popover.classList.remove('hidden');

      try {
        const opts = await apiFetch(`/media/${mediaType}/customize-options`);

        const rootSelect = document.getElementById('customize-add-root-folder') as HTMLSelectElement;
        rootSelect.innerHTML = opts.root_folders.map((f: any) =>
          `<option value="${esc(f.path)}" ${f.path === opts.current.root_folder ? 'selected' : ''}>${esc(f.path)}</option>`
        ).join('');

        const qualitySelect = document.getElementById('customize-add-quality-profile') as HTMLSelectElement;
        qualitySelect.innerHTML = opts.quality_profiles.map((p: any) =>
          `<option value="${p.id}" ${p.id === opts.current.quality_profile ? 'selected' : ''}>${esc(p.name)}</option>`
        ).join('');

        _customizeAddTags = [...(opts.current.tags || [])];
        renderCustomizeAddTags(opts.tags, _customizeAddTags);

        if (isSeries) {
          (document.getElementById('customize-add-season-folder') as HTMLInputElement).checked = opts.current.season_folder !== false;
        }

        loading.classList.add('hidden');
        body.classList.remove('hidden');
        footer.classList.remove('hidden');
      } catch {
        loading.classList.add('hidden');
        body.classList.remove('hidden');
        errorEl.textContent = 'Could not load options.';
        errorEl.classList.remove('hidden');
        return;
      }

      document.getElementById('customize-add-confirm')!.onclick = async () => {
        const overrides: Record<string, unknown> = {
          root_folder: (document.getElementById('customize-add-root-folder') as HTMLSelectElement).value,
          quality_profile: parseInt((document.getElementById('customize-add-quality-profile') as HTMLSelectElement).value),
          tags: _customizeAddTags,
        };
        if (isSeries) {
          overrides.season_folder = (document.getElementById('customize-add-season-folder') as HTMLInputElement).checked;
        }
        closeCustomizeAddPopover();
        await onConfirm(overrides);
      };
    }

