---
// Lokal patch (Popcornmeter). Laddas först i <body> i Base.astro, så att kort
// som ritas av andra skript får rätt ikon innan sidan hinner visa ★.
import { popcornMap, popcornBigKeys, ratingIcons } from "../lib/extRatings";
const known = popcornMap();
const bigKeys = popcornBigKeys();
const icons = ratingIcons();
---
<script is:inline define:vars={{ known, bigKeys, icons }}>
(() => {
  if (window.__extRatings) return;
  window.__extRatings = true;
  const map = Object.assign({}, known);
  const big = new Set(bigKeys);
  const inflight = new Map();
  let active = 0;
  const waiting = [];
  const slot = () => active < 4 ? (active++, Promise.resolve()) : new Promise((r) => waiting.push(() => { active++; r(); }));
  const release = () => { active--; const n = waiting.shift(); if (n) n(); };
  const COLORS = ["text-yellow-400", "text-red-400", "text-green-400", "text-cyan-400", "text-zinc-100", "text-zinc-500", "animate-pulse"];
  const FALLBACK = { fresh: "🍅", rotten: "🟢", noScore: "·", banner: "🍅" };

  function color(p) {
    return "text-zinc-100"; // mjukvit på alla nivåer
  }
  function icon(name) {
    const svg = icons[name];
    return svg ? '<span class="w-3.5 h-3.5 inline-flex shrink-0">' + svg + "</span>" : FALLBACK[name];
  }
  function iconFor(p, isBig) {
    if (p == null) return "noScore";
    if (isBig && p >= 90) return "banner";
    return p >= 60 ? "fresh" : "rotten";
  }
  function target(b) {
    const card = b.closest("[data-card]");
    const t = card && card.dataset.mediaType;
    const kind = b.dataset.extKind || (t === "movie" ? "movie" : (t === "series" || t === "episode") ? "show" : "");
    const id = b.dataset.extId || (kind === "show"
      ? (card && card.dataset.showTmdbId) || (t === "series" ? card && card.dataset.tmdbId : "")
      : card && card.dataset.tmdbId) || "";
    return kind && id ? kind + "/" + id : "";
  }
  function show(b, p, isBig) {
    b.classList.remove(...COLORS, "hidden");
    b.classList.add(color(p));
    b.title = "Rotten Tomatoes Popcornmeter";
    b.innerHTML = icon(iconFor(p, isBig)) + p + "%";
    b.dataset.extDone = "1";
  }
  function noScore(b) {
    b.dataset.extDone = "1";
    if (b.classList.contains("hidden")) { b.remove(); return; }
    b.classList.remove(...COLORS);
    b.classList.add("text-zinc-100");
    b.title = "Inget Popcornmeter-betyg";
    b.innerHTML = icon("noScore") + "–";
  }
  function pending(b) {
    b.classList.remove("text-yellow-400");
    b.classList.add("text-zinc-500", "animate-pulse");
    b.innerHTML = icon("noScore") + "…";
  }
  function fetchPop(key) {
    if (!inflight.has(key)) {
      inflight.set(key, slot().then(() =>
        fetch("/api/proxy/ext-ratings/" + key, { credentials: "same-origin" })
          .then((r) => r.ok ? r.json() : null)
          .then((d) => d && d.popcorn != null && isFinite(+d.popcorn) ? { p: +d.popcorn, big: +d.popcorn >= 90 && +d.votes >= 500 } : null)
          .catch(() => null)
          .finally(release)));
    }
    return inflight.get(key);
  }
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      const b = e.target;
      io.unobserve(b);
      const key = target(b);
      fetchPop(key).then((r) => {
        if (r == null) return noScore(b);
        map[key] = r.p;
        if (r.big) big.add(key);
        show(b, r.p, r.big);
      });
    }
  }, { rootMargin: "400px" });

  function handle(b) {
    if (b.dataset.extSeen) return;
    b.dataset.extSeen = "1";
    if (b.dataset.extDone) return;
    const key = target(b);
    if (!key) return;
    if (map[key] != null) return show(b, map[key], big.has(key));
    if (!b.classList.contains("hidden")) pending(b);
    io.observe(b);
  }
  function scan() { document.querySelectorAll(".ext-rate:not([data-ext-seen])").forEach(handle); }

  new MutationObserver(scan).observe(document.documentElement, { childList: true, subtree: true });
  document.addEventListener("DOMContentLoaded", scan);
  document.addEventListener("astro:page-load", scan);
  scan();
})();
</script>
