    function openRewatchPopover(btn: HTMLElement, seriesTmdbId: string) {
      _activeRewatchBtn = btn;
      const popover = document.getElementById('rewatch-popover')!;

      document.getElementById('rewatch-popover-restart')!.onclick = async () => {
        closeRewatchPopover();
        try {
          await apiFetch(`/history/rewatch?series_tmdb_id=${seriesTmdbId}`, 'POST');
          window.location.reload();
        } catch (err: any) {
          alertFromError(err, 'Failed to restart rewatch');
        }
      };

      document.getElementById('rewatch-popover-cancel')!.onclick = async () => {
        closeRewatchPopover();
        try {
          await apiFetch(`/history/rewatch?series_tmdb_id=${seriesTmdbId}`, 'DELETE');
          window.location.reload();
        } catch (err: any) {
          alertFromError(err, 'Failed to cancel rewatch');
        }
      };

      const rect = btn.getBoundingClientRect();
      popover.classList.remove('hidden');
      const popW = popover.offsetWidth;
      const left = Math.min(rect.left + window.scrollX, window.innerWidth - popW - 8);
      popover.style.left = `${Math.max(8, left)}px`;
      popover.style.top = `${rect.bottom + window.scrollY + 6}px`;
