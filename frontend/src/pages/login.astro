<style is:global>
  /* Guarantees hero text legibility over the poster wall regardless of what
     poster happens to sit behind any given word. */
  .hero-copy { text-shadow: 0 1px 8px rgba(0, 0, 0, 0.65), 0 1px 3px rgba(0, 0, 0, 0.5); }
  html.light .hero-copy { text-shadow: 0 1px 8px rgba(255, 255, 255, 0.75), 0 1px 3px rgba(255, 255, 255, 0.6); }
  /* A text-shadow on a background-clip:text/transparent-fill span paints as a
     solid smear instead of following the glyph's gradient fill, so opt it out. */
  .hero-copy .hero-gradient-text { text-shadow: none; }
  .hero-lead { color: #fff; }
  html.light .hero-lead { color: #000; }
  .hero-highlight-mark {
    background-color: #ec4899;
    color: #fff;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    padding: 0.15em 0.35em;
    border-radius: 0.3em;
  }

  /* ── Login poster-wall background ── */
  .poster-wall {
    position: absolute;
    inset: -10%;
    display: flex;
    justify-content: center;
    gap: clamp(1.5rem, 2.6vw, 3rem);
    transform: rotate(-4deg);
  }
  .pw-col {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 2.6vw, 3rem);
    flex: 0 0 auto;
    width: clamp(140px, 13vw, 210px);
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }
  .pw-col:nth-child(even) { margin-top: -6rem; }
  .pw-card {
    aspect-ratio: 2 / 3;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pw-icon { width: 34%; color: rgba(255, 255, 255, 0.16); }
  .pw-icon svg { width: 100%; height: auto; }

  .pw-card--poster {
    overflow: hidden;
    background: #111;
    box-shadow: 0 14px 34px -14px rgba(0, 0, 0, 0.65);
  }
  .pw-card--poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(1.02) brightness(0.98);
  }

  .pw-g0 { background: linear-gradient(160deg, #312e81, #1e1b4b); }
  .pw-g1 { background: linear-gradient(160deg, #581c87, #3b0764); }
  .pw-g2 { background: linear-gradient(160deg, #881337, #4c0519); }
  .pw-g3 { background: linear-gradient(160deg, #115e59, #042f2e); }
  .pw-g4 { background: linear-gradient(160deg, #075985, #082f49); }

  .pw-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        115deg,
        color-mix(in srgb, var(--color-bg-page) 62%, transparent) 0%,
        color-mix(in srgb, var(--color-bg-page) 34%, transparent) 30%,
        transparent 56%
      ),
      radial-gradient(
        70% 65% at 50% 50%,
        color-mix(in srgb, var(--color-bg-page) 18%, transparent) 0%,
        color-mix(in srgb, var(--color-bg-page) 45%, transparent) 55%,
        color-mix(in srgb, var(--color-bg-page) 68%, transparent) 100%
      );
  }
  html.light .pw-overlay {
    background:
      linear-gradient(
        115deg,
        color-mix(in srgb, var(--color-bg-page) 72%, transparent) 0%,
        color-mix(in srgb, var(--color-bg-page) 45%, transparent) 30%,
        transparent 56%
      ),
      radial-gradient(
        70% 65% at 50% 50%,
        color-mix(in srgb, var(--color-bg-page) 32%, transparent) 0%,
        color-mix(in srgb, var(--color-bg-page) 58%, transparent) 55%,
        color-mix(in srgb, var(--color-bg-page) 78%, transparent) 100%
      );
  }

  @keyframes pw-drift {
    from { translate: 0 -1.5%; }
    to { translate: 0 1.5%; }
  }
  .pw-drift-0 { animation: pw-drift 22s ease-in-out infinite alternate; }
  .pw-drift-1 { animation: pw-drift 28s ease-in-out infinite alternate-reverse; }
  .pw-drift-2 { animation: pw-drift 34s ease-in-out infinite alternate; }
  @media (prefers-reduced-motion: reduce) {
    .pw-drift-0, .pw-drift-1, .pw-drift-2 { animation: none; }
    .pw-col { transition: none; }
  }
</style>

<!-- Bootstrap Restore Confirmation Modal -->
<div id="bootstrap-restore-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div id="bootstrap-restore-modal-backdrop" class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>
  <div class="relative bg-zinc-900 border border-zinc-800 rounded-3xl p-8 w-full max-w-md shadow-2xl">
    <h2 class="text-xl font-black text-zinc-100 mb-2">Restore Database?</h2>
    <p class="text-sm text-zinc-400 mb-1">Restoring from:</p>
    <p id="bootstrap-restore-modal-filename" class="text-sm text-zinc-100 font-medium mb-4 break-all"></p>
    <div class="bg-red-500/10 border border-red-500/20 rounded-xl px-4 py-3 mb-6">
      <p class="text-sm text-red-400 font-medium">All existing data will be permanently overwritten. This cannot be undone.</p>
    </div>
    <div class="flex gap-3">
      <button type="button" id="bootstrap-restore-cancel-btn"
        class="flex-1 px-4 py-3 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 font-bold rounded-xl transition-colors text-sm cursor-pointer">
        Cancel
      </button>
      <button type="button" id="bootstrap-restore-confirm-btn"
        class="flex-1 px-4 py-3 bg-red-600 hover:bg-red-500 text-white font-bold rounded-xl transition-colors text-sm cursor-pointer">
        Restore
      </button>
    </div>
  </div>
</div>

<script>
  function setupPasswordToggles() {
    const toggles = document.querySelectorAll('.password-toggle');
    toggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        const input = toggle.parentElement?.querySelector('input');
        if (!input) return;

        const isPassword = input.type === 'password';
        input.type = isPassword ? 'text' : 'password';

        const eyeIcon = toggle.querySelector('.eye-icon');
        const eyeSlashIcon = toggle.querySelector('.eye-slash-icon');

        if (isPassword) {
          eyeIcon?.classList.add('hidden');
          eyeSlashIcon?.classList.remove('hidden');
        } else {
          eyeIcon?.classList.remove('hidden');
          eyeSlashIcon?.classList.add('hidden');
        }
      });
    });
  }

  setupPasswordToggles();
  document.addEventListener('astro:after-swap', setupPasswordToggles);

  // ── Poster-wall mouse parallax ──
  function setupPosterParallax() {
    const viewport = document.getElementById('poster-wall-viewport');
    if (!viewport || viewport.dataset.parallaxBound === 'true') return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const cols = Array.from(viewport.querySelectorAll<HTMLElement>('.pw-col'));
    if (!cols.length) return;
    viewport.dataset.parallaxBound = 'true';

    const MAX_PX = 24;
    let raf = 0;
    window.addEventListener('mousemove', (e) => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        const nx = (e.clientX / window.innerWidth - 0.5) * 2;
        const ny = (e.clientY / window.innerHeight - 0.5) * 2;
        for (const col of cols) {
          const depth = parseFloat(col.dataset.depth || '0.7');
          const tx = nx * MAX_PX * depth;
          const ty = ny * MAX_PX * depth * 0.6;
          col.style.transform = `translate3d(${tx}px, ${ty}px, 0)`;
        }
      });
    });
  }

  setupPosterParallax();
  document.addEventListener('astro:after-swap', setupPosterParallax);

  // ── Bootstrap restore ──
  const bootstrapFile = document.getElementById('bootstrap-restore-file') as HTMLInputElement | null;
  const bootstrapBtn = document.getElementById('bootstrap-restore-btn') as HTMLButtonElement | null;
  const bootstrapModal = document.getElementById('bootstrap-restore-modal');

  if (bootstrapFile && bootstrapBtn && bootstrapModal) {
    function openModal() {
      const file = bootstrapFile!.files?.[0];
      if (!file) return;
      document.getElementById('bootstrap-restore-modal-filename')!.textContent = file.name;
      bootstrapModal!.classList.remove('hidden');
    }
    function closeModal() {
      bootstrapModal!.classList.add('hidden');
    }

    bootstrapFile.addEventListener('change', () => {
      bootstrapBtn!.disabled = !bootstrapFile.files?.length;
    });
    bootstrapBtn.addEventListener('click', openModal);
    document.getElementById('bootstrap-restore-cancel-btn')?.addEventListener('click', closeModal);
    document.getElementById('bootstrap-restore-modal-backdrop')?.addEventListener('click', closeModal);

    document.getElementById('bootstrap-restore-confirm-btn')?.addEventListener('click', async () => {
      const file = bootstrapFile.files?.[0];
      if (!file) return;
      closeModal();
      bootstrapBtn!.disabled = true;
      bootstrapBtn!.textContent = 'Restoring…';
      document.getElementById('bootstrap-restore-error')!.classList.add('hidden');
      try {
        const fd = new FormData();
        fd.append('file', file);
        const res = await fetch('/api/proxy/auth/bootstrap-restore', { method: 'POST', body: fd });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.detail || 'Restore failed');
        }
        window.location.href = '/login?restored=true';
      } catch (err: unknown) {
        const errEl = document.getElementById('bootstrap-restore-error')!;
        errEl.textContent = err instanceof Error ? err.message : 'Restore failed';
        errEl.classList.remove('hidden');
        bootstrapBtn!.disabled = false;
        bootstrapBtn!.textContent = 'Restore Database';
      }
    });
  }
</script>
