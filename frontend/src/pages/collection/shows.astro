---
import Base from "../../layouts/Base.astro";
import MediaCard from "../../components/MediaCard.astro";
import Pagination from "../../components/Pagination.astro";
import FilterPanel from "../../components/FilterPanel.astro";
import SortButton from "../../components/SortButton.astro";
import { api } from "../../lib/api";
import { formatNumber } from "../../lib/format";
import { genreLabel, showStatusLabel, sortByLabel } from "../../lib/labels";
import { m } from "../../paraglide/messages.js";
export const prerender = false;

const sort = Astro.url.searchParams.get("sort") ?? "title";
const genres = Astro.url.searchParams.getAll("genre");
const years = Astro.url.searchParams.getAll("year").map(Number).filter((n) => !Number.isNaN(n));
const statuses = Astro.url.searchParams.getAll("status");
const watched = Astro.url.searchParams.getAll("watched");
const inList = Astro.url.searchParams.get("in_list") ?? "";
const page = Number(Astro.url.searchParams.get("page") ?? 1);
const { token } = Astro.locals;
Astro.response.headers.set("Cache-Control", "no-store");

const data = await api.shows.list({
  sort,
  page,
  genre: genres,
  year: years,
  status: statuses,
  watched,
  ...(inList ? { in_list: inList } : {}),
}, token);

const TV_GENRES = [
  "Action & Adventure", "Animation", "Comedy", "Crime", "Documentary",
  "Drama", "Family", "Kids", "Mystery", "News", "Reality",
  "Sci-Fi & Fantasy", "Soap", "Talk", "War & Politics", "Western",
];

const TV_STATUSES = ["Returning Series", "In Production", "Planned", "Ended", "Canceled"];

const hasFilters = genres.length > 0 || years.length > 0 || statuses.length > 0 || watched.length > 0 || !!inList;

// Build base URL preserving active filters (without page)
const baseParams = new URLSearchParams();
baseParams.set("sort", sort);
genres.forEach((g) => baseParams.append("genre", g));
years.forEach((y) => baseParams.append("year", String(y)));
statuses.forEach((s) => baseParams.append("status", s));
watched.forEach((w) => baseParams.append("watched", w));
if (inList) baseParams.set("in_list", inList);
const baseUrl = `/collection/shows?${baseParams.toString()}`;
---

<Base title={m.collection_my_shows()}>
  <div class="flex items-center gap-1 mb-6 bg-zinc-900 border border-zinc-800 rounded-xl p-1 w-fit">
    <a href="/shows" class="px-4 py-1.5 rounded-lg text-sm font-medium text-zinc-400 hover:text-zinc-100 transition-colors active:scale-95 active:opacity-70">{m.explore_tab()}</a>
    <a href="/collection/shows" class="px-4 py-1.5 rounded-lg text-sm font-semibold bg-blue-600 text-white transition-colors active:scale-95 active:opacity-70">{m.explore_my_collection()}</a>
  </div>
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-10">
    <div class="flex items-baseline gap-3">
      <h1 class="page-title">{m.collection_my_shows()}</h1>
      <span class="text-zinc-500 font-medium">{m.common_total_count({ count: formatNumber(data.total_results) })}</span>
    </div>

    <!-- Sort & filter controls -->
    <div class="flex items-center gap-3">
      <SortButton
        id="show-sort"
        current={sort}
        options={[
          { value: "title", label: m.sort_az() },
          { value: "rating", label: m.sort_top() },
          { value: "release_date", label: m.sort_newest() },
          { value: "created_at", label: m.sort_recently_added() },
          { value: "last_watched", label: m.sort_recently_watched() },
        ]}
      />
      <FilterPanel
        id="show-filters"
        basePath="/collection/shows"
        currentSort={sort}
        sections={[
          { key: "genre", label: m.filter_genre(), options: sortByLabel(TV_GENRES.map((g) => ({ value: g, label: genreLabel(g) }))), selected: genres },
          { key: "year", label: m.filter_year(), selected: years.map(String), dynamic: true, endpoint: "/api/proxy/shows/years" },
          { key: "status", label: m.filter_status(), options: TV_STATUSES.map((s) => ({ value: s, label: showStatusLabel(s) })), selected: statuses },
          { key: "watched", label: m.filter_progress(), options: [{ value: "watched", label: m.filter_started() }, { value: "unwatched", label: m.filter_not_started() }], selected: watched },
          { key: "in_list", label: m.filter_lists(), options: [{ value: "in", label: m.filter_in_a_list() }, { value: "out", label: m.filter_not_in_a_list() }], selected: inList ? [inList] : [], multi: false },
        ]}
      />
    </div>
  </div>

  {data.results.length === 0 ? (
    <div class="bg-zinc-900/50 rounded-2xl p-12 text-center border border-dashed border-zinc-800">
      <div class="text-zinc-500 mb-4 text-lg">
        {hasFilters ? m.collection_no_shows_match() : m.collection_library_empty()}
      </div>
      {!hasFilters && (
        <a href="/settings" class="inline-flex items-center px-6 py-3 bg-zinc-100 text-zinc-950 font-bold rounded-xl hover:bg-zinc-200 transition">
          {m.collection_set_up_sync()}
        </a>
      )}
    </div>
  ) : (
    <>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6">
        {data.results.map(item => <MediaCard item={{...item, type: 'series', in_library: true}} />)}
      </div>

      <Pagination
        currentPage={data.page}
        totalPages={data.total_pages}
        baseUrl={baseUrl}
      />
    </>
  )}
</Base>
