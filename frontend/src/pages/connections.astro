    // Trakt Device Auth
    function setupTraktAuth() {
      const connectBtn = document.getElementById('trakt-connect-btn');
      const disconnectBtn = document.getElementById('trakt-disconnect-btn');

      if (connectBtn) {
        connectBtn.onclick = async () => {
          connectBtn.disabled = true;
          connectBtn.textContent = 'Starting…';
          try {
            // If credentials aren't saved yet, save them from the input fields first
            const clientIdInput = document.getElementById('trakt_client_id') as HTMLInputElement | null;
            const clientSecretInput = document.getElementById('trakt_client_secret') as HTMLInputElement | null;
            const clientId = clientIdInput?.value.trim() || '';
            const clientSecret = clientSecretInput?.value.trim() || '';
            if (clientId && clientSecret) {
              const saveRes = await fetch('/api/proxy/auth/settings', {
                method: 'PATCH',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ trakt_client_id: clientId, trakt_client_secret: clientSecret }),
              });
              if (!saveRes.ok) {
                const err = await saveRes.json();
                throw new Error(err.detail || 'Failed to save Trakt credentials');
              }
            }

            const res = await fetch('/api/proxy/trakt/auth/device/start', {
              method: 'POST',
              headers: { 'Authorization': `Bearer ${token}` },
            });
            if (!res.ok) {
              const err = await res.json();
              throw new Error(err.detail || 'Failed to start Trakt auth');
            }
            const data = await res.json();

            const panel = document.getElementById('trakt-auth-panel');
            const urlEl = document.getElementById('trakt-verify-url');
            const codeEl = document.getElementById('trakt-user-code');
            const statusEl = document.getElementById('trakt-auth-status');
            if (panel) panel.classList.remove('hidden');
            if (urlEl) urlEl.textContent = data.verification_url;
            if (codeEl) codeEl.textContent = data.user_code;
            connectBtn.textContent = 'Waiting…';

            // Poll for token
            const interval = (data.interval || 5) * 1000;
            const deadline = Date.now() + data.expires_in * 1000;
            const poll = async () => {
              if (Date.now() > deadline) {
                if (statusEl) statusEl.textContent = 'Authorization timed out. Please try again.';
                connectBtn.disabled = false;
                connectBtn.textContent = 'Connect Trakt';
                return;
              }
              try {
                const pollRes = await fetch('/api/proxy/trakt/auth/device/poll', {
                  method: 'POST',
                  headers: { 'Authorization': `Bearer ${token}` },
                });
                if (pollRes.ok) {
                  const pollData = await pollRes.json();
                  if (pollData.status === 'connected') {
                    if (statusEl) statusEl.textContent = 'Connected! Reloading…';
                    window.location.reload();
                    return;
                  }
                } else {
                  const err = await pollRes.json();
                  if (statusEl) statusEl.textContent = `Error: ${err.detail || 'Authorization failed'}`;
                  connectBtn.disabled = false;
                  connectBtn.textContent = 'Connect Trakt';
                  return;
                }
              } catch (e) {}
              setTimeout(poll, interval);
            };
            setTimeout(poll, interval);
          } catch (e) {
            showMessage(e.message, 'error');
            connectBtn.disabled = false;
            connectBtn.textContent = 'Connect Trakt';
          }
        };
      }

      if (disconnectBtn) {
        disconnectBtn.onclick = async () => {
          if (!confirm('Disconnect Trakt? This will remove your Trakt tokens from Scrob.')) return;
          disconnectBtn.disabled = true;
          disconnectBtn.textContent = 'Disconnecting…';
          try {
            await fetch('/api/proxy/trakt/auth/disconnect', {
              method: 'DELETE',
              headers: { 'Authorization': `Bearer ${token}` },
            });
            window.location.reload();
          } catch (e) {
            showMessage('Failed to disconnect Trakt', 'error');
            disconnectBtn.disabled = false;
            disconnectBtn.textContent = 'Disconnect';
          }
        };
      }
    }
    setupTraktAuth();

    // Import tabs (currently just Trakt — more services can register a
    // data-import-tab button + matching data-import-panel later).
    function setupImportTabs() {
      const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.import-tab-btn'));
      if (tabs.length === 0) return;
      const activate = (name: string) => {
        tabs.forEach((tab) => {
          const active = tab.getAttribute('data-import-tab') === name;
          tab.classList.toggle('bg-blue-600', active);
          tab.classList.toggle('text-white', active);
          tab.classList.toggle('font-semibold', active);
          tab.classList.toggle('text-zinc-400', !active);
          tab.classList.toggle('font-medium', !active);
        });
        document.querySelectorAll<HTMLElement>('[data-import-panel]').forEach((panel) => {
          panel.classList.toggle('hidden', panel.getAttribute('data-import-panel') !== name);
        });
      };
      tabs.forEach((tab) => tab.addEventListener('click', () => activate(tab.getAttribute('data-import-tab')!)));
      activate(tabs[0].getAttribute('data-import-tab')!);
    }
    setupImportTabs();

    // Trakt Export Import (no VIP / API app required)
    function setupTraktExportImport() {
      const dropzone = document.getElementById('trakt-import-dropzone') as HTMLDivElement | null;
      const fileInput = document.getElementById('trakt_export_file') as HTMLInputElement | null;
      if (!dropzone || !fileInput) return;

      const uploadFile = async (file: File) => {
        if (!file.name.toLowerCase().endsWith('.zip')) {
          showMessage('Please select a .zip export file.', 'error');
          return;
        }

        const selection = await showTraktImportModal(file.name);
        if (!selection) return;
        if (!selection.watched && !selection.ratings && !selection.lists) {
          showMessage('Select at least one item to import.', 'error');
          return;
        }

        try {
          const form = new FormData();
          form.append('file', file);
          form.append('sync_watched', String(selection.watched));
          form.append('sync_ratings', String(selection.ratings));
          form.append('sync_lists', String(selection.lists));
          const res = await fetch('/api/proxy/trakt/import/upload', {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}` },
            body: form,
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.detail || 'Import failed');
          showMessage(data.message || 'Import started!', 'success', { scroll: false });
          startTraktPoller();
          if (data.job_id) startTraktImportPoller(data.job_id);
        } catch (e) {
          showMessage(e instanceof Error ? e.message : 'Import failed', 'error');
        }
      };

      dropzone.addEventListener('click', () => {
        if (!fileInput.disabled) fileInput.click();
      });

      fileInput.addEventListener('change', () => {
        const file = fileInput.files?.[0];
        if (file) uploadFile(file);
        fileInput.value = '';
      });

      ['dragover', 'dragenter'].forEach((evt) => {
        dropzone.addEventListener(evt, (e) => {
          e.preventDefault();
          if (!fileInput.disabled) dropzone.classList.add('border-blue-500', 'bg-zinc-900/70');
        });
      });
      ['dragleave', 'dragend'].forEach((evt) => {
        dropzone.addEventListener(evt, () => dropzone.classList.remove('border-blue-500', 'bg-zinc-900/70'));
      });
      dropzone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropzone.classList.remove('border-blue-500', 'bg-zinc-900/70');
        if (fileInput.disabled) return;
        const file = e.dataTransfer?.files?.[0];
        if (file) uploadFile(file);
      });
    }
    setupTraktExportImport();

    // Scrob data export import
    function setupScrobExportImport() {
      const dropzone = document.getElementById('scrob-import-dropzone') as HTMLDivElement | null;
      const fileInput = document.getElementById('scrob_export_file') as HTMLInputElement | null;
      if (!dropzone || !fileInput) return;

      const uploadFile = async (file: File) => {
        if (!file.name.toLowerCase().endsWith('.zip')) {
          showMessage('Please select a .zip export file.', 'error');
          return;
        }

        const selection = await showScrobImportModal(file.name);
        if (!selection) return;

        try {
          const form = new FormData();
          form.append('file', file);
          form.append('watched', String(selection.watched));
          form.append('ratings', String(selection.ratings));
          form.append('collection', String(selection.collection));
          form.append('lists', String(selection.lists));
          form.append('comments', String(selection.comments));
          form.append('api_keys', String(selection.api_keys));
          form.append('media_connections', String(selection.media_connections));
          form.append('scrobble_connections', String(selection.scrobble_connections));
          form.append('connections', String(selection.connections));
          const res = await fetch('/api/proxy/export/import', {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${token}` },
            body: form,
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.detail || 'Import failed');
          showMessage(data.message || 'Import started!', 'success', { scroll: false });
          if (data.job_id) startScrobImportPoller(data.job_id);
        } catch (e) {
          showMessage(e instanceof Error ? e.message : 'Import failed', 'error');
        }
      };

      dropzone.addEventListener('click', () => {
        if (!fileInput.disabled) fileInput.click();
      });

      fileInput.addEventListener('change', () => {
        const file = fileInput.files?.[0];
        if (file) uploadFile(file);
        fileInput.value = '';
      });

      ['dragover', 'dragenter'].forEach((evt) => {
        dropzone.addEventListener(evt, (e) => {
          e.preventDefault();
          if (!fileInput.disabled) dropzone.classList.add('border-blue-500', 'bg-zinc-900/70');
        });
      });
      ['dragleave', 'dragend'].forEach((evt) => {
        dropzone.addEventListener(evt, () => dropzone.classList.remove('border-blue-500', 'bg-zinc-900/70'));
      });
      dropzone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropzone.classList.remove('border-blue-500', 'bg-zinc-900/70');
        if (fileInput.disabled) return;
        const file = e.dataTransfer?.files?.[0];
        if (file) uploadFile(file);
      });
    }
    setupScrobExportImport();

    // Simkl PIN Auth
    function setupSimklAuth() {
      const connectBtn = document.getElementById('simkl-connect-btn');
      const disconnectBtn = document.getElementById('simkl-disconnect-btn');

      if (connectBtn) {
        connectBtn.onclick = async () => {
          connectBtn.disabled = true;
          connectBtn.textContent = 'Starting…';
          try {
            // Auto-save client_id if not yet persisted
            const clientIdInput = document.getElementById('simkl_client_id') as HTMLInputElement | null;
            const clientId = clientIdInput?.value.trim() || '';
            if (clientId) {
              const saveRes = await fetch('/api/proxy/auth/settings', {
                method: 'PATCH',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ simkl_client_id: clientId }),
              });
              if (!saveRes.ok) {
                const err = await saveRes.json();
                throw new Error(err.detail || 'Failed to save Simkl Client ID');
              }
            }

            const res = await fetch('/api/proxy/simkl/auth/pin/start', {
              method: 'POST',
              headers: { 'Authorization': `Bearer ${token}` },
            });
            if (!res.ok) {
              const err = await res.json();
              throw new Error(err.detail || 'Failed to start Simkl auth');
            }
            const data = await res.json();

            const panel   = document.getElementById('simkl-auth-panel');
            const urlEl   = document.getElementById('simkl-verify-url');
            const codeEl  = document.getElementById('simkl-user-code');
            const statusEl = document.getElementById('simkl-auth-status');
            if (panel)  panel.classList.remove('hidden');
            if (urlEl)  urlEl.textContent = data.url;
            if (codeEl) codeEl.textContent = data.user_code;
            connectBtn.textContent = 'Waiting…';

            const interval = (data.interval || 5) * 1000;
            const deadline = Date.now() + data.expires_in * 1000;
            const poll = async () => {
              if (Date.now() > deadline) {
                if (statusEl) statusEl.textContent = 'Authorization timed out. Please try again.';
                connectBtn.disabled = false;
                connectBtn.textContent = 'Connect Simkl';
                return;
              }
              try {
                const pollRes = await fetch('/api/proxy/simkl/auth/pin/poll', {
                  method: 'POST',
                  headers: { 'Authorization': `Bearer ${token}` },
                });
                if (pollRes.ok) {
                  const pollData = await pollRes.json();
                  if (pollData.status === 'connected') {
                    if (statusEl) statusEl.textContent = 'Connected! Reloading…';
                    window.location.reload();
                    return;
                  }
                } else {
                  const err = await pollRes.json();
                  if (statusEl) statusEl.textContent = `Error: ${err.detail || 'Authorization failed'}`;
                  connectBtn.disabled = false;
                  connectBtn.textContent = 'Connect Simkl';
                  return;
                }
              } catch (e) {}
              setTimeout(poll, interval);
            };
            setTimeout(poll, interval);
          } catch (e) {
            showMessage(e.message, 'error');
            connectBtn.disabled = false;
            connectBtn.textContent = 'Connect Simkl';
          }
        };
      }

      if (disconnectBtn) {
        disconnectBtn.onclick = async () => {
          if (!confirm('Disconnect Simkl? This will remove your Simkl token from Scrob.')) return;
          disconnectBtn.disabled = true;
          disconnectBtn.textContent = 'Disconnecting…';
          try {
            await fetch('/api/proxy/simkl/auth/disconnect', {
              method: 'DELETE',
              headers: { 'Authorization': `Bearer ${token}` },
            });
            window.location.reload();
          } catch (e) {
            showMessage('Failed to disconnect Simkl', 'error');
            disconnectBtn.disabled = false;
            disconnectBtn.textContent = 'Disconnect';
          }
        };
      }
    }
    setupSimklAuth();

    // MDBList disconnect
    function setupMdblistAuth() {
      const disconnectBtn = document.getElementById('mdblist-disconnect-btn');
