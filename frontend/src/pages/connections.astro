<script>
  const appData = document.getElementById('app-data');
  const token = appData?.dataset.token ?? '';

  function esc(s) {
    if (s == null) return '';
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function showMessage(text, type = 'success', opts: { scroll?: boolean } = {}) {
    const msg = document.getElementById('js-message');
    if (!msg) return;
    msg.textContent = text;
    msg.className = `fixed top-4 right-4 z-[200] max-w-sm p-4 rounded-lg shadow-2xl border ${
      type === 'success'
        ? 'bg-zinc-900 border-green-500/50 text-green-400'
        : 'bg-zinc-900 border-red-500/50 text-red-400'
    }`;
    msg.classList.remove('hidden');

    if (window._messageTimeout) clearTimeout(window._messageTimeout);
    window._messageTimeout = setTimeout(() => msg.classList.add('hidden'), 4000);
  }

  // ── Shared sync-job cancellation ──────────────────────────────────────────
  // The background job only notices on its next cooperative checkpoint, so the
  // strip keeps showing "Cancelling…" until the next poll reflects status=cancelled.
  async function cancelSyncJob(jobId: number, btn: HTMLButtonElement | null) {
    if (btn) { btn.disabled = true; btn.textContent = 'Cancelling…'; }
    try {
      await fetch(`/api/proxy/sync/${jobId}/cancel`, {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}` },
      });
    } catch {
      // best-effort — the next poll reflects the real state either way
    }
  }

  function wireCancelButton(btn: HTMLButtonElement | null, job: any) {
    if (!btn) return;
    btn.classList.remove('hidden');
    btn.disabled = false;
    btn.textContent = 'Cancel';
    btn.onclick = () => cancelSyncJob(job.id, btn);
  }

  // ── Per-connection progress tracking ─────────────────────────────────────
  const connPollers = new Map<string, ReturnType<typeof setTimeout>>();

  function renderConnProgress(connId: string, job: any) {
    const strip = document.getElementById(`conn-progress-${connId}`);
    const bar   = document.getElementById(`conn-job-bar-${connId}`);
    const pctEl = document.getElementById(`conn-job-pct-${connId}`);
    const label = document.getElementById(`conn-job-label-${connId}`);
    const items = document.getElementById(`conn-job-items-${connId}`);
    const statusEl = document.getElementById(`conn-job-status-${connId}`);
    const cancelBtn = document.getElementById(`conn-job-cancel-${connId}`) as HTMLButtonElement | null;
    if (!strip) return;

    if (!job) { strip.classList.add('hidden'); return; }

    strip.classList.remove('hidden');

    const isPush = job.job_type === 'push';
    const isFailed = job.status === 'failed';
    const isCancelled = job.status === 'cancelled';
    const isCompleted = job.status === 'completed';
    const isPending = job.status === 'pending';

    if (isFailed || isCancelled) {
      if (cancelBtn) cancelBtn.classList.add('hidden');
      if (bar) { bar.className = 'h-1.5 rounded-full transition-all duration-500 bg-red-500'; bar.style.width = '100%'; }
      if (label) label.textContent = isCancelled ? (isPush ? 'Push cancelled' : 'Pull cancelled') : (isPush ? 'Push failed' : 'Pull failed');
