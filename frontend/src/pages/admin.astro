  async function testGlobalApiKey(
    provider: 'tmdb' | 'tvdb' | 'mdblist',
    label: string,
    keyInputId: string,
    statusId: string,
    pinInputId?: string,
  ): Promise<void> {
    const key = (document.getElementById(keyInputId) as HTMLInputElement).value.trim();
    if (!key) { showMessage(m.admin_enter_api_key_first({ service: label }), 'error'); return; }

    const button = document.getElementById(`test-${provider}-btn`) as HTMLButtonElement;
    const body: { key: string; pin?: string } = { key };
    if (pinInputId) {
      const pin = (document.getElementById(pinInputId) as HTMLInputElement).value.trim();
      if (pin) body.pin = pin;
    }
    button.disabled = true;
    setConnStatus(statusId, 'checking');
    try {
      const response = await fetch(`/api/proxy/admin/settings/test-${provider}`, {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!response.ok) {
        setConnStatus(statusId, 'disconnected');
        const error: unknown = await response.json();
        const detail = typeof error === 'object' && error !== null && 'detail' in error
          ? String(error.detail)
          : m.admin_failed_to_connect_to({ service: label });
        throw new Error(detail);
      }
      setConnStatus(statusId, 'connected');
      showMessage(m.admin_connection_successful({ service: label }));
    } catch (error: unknown) {
      setConnStatus(statusId, 'disconnected');
      showMessage(error instanceof Error ? error.message : m.admin_service_error({ service: label }), 'error');
    } finally {
      button.disabled = false;
    }
  }

