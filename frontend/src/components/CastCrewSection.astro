---
import PersonCard from "./PersonCard.astro";
import { crewJobLabel } from "../lib/labels";
import { m } from "../paraglide/messages.js";

interface Person {
  tmdb_id?: number | null;
  person_id?: number | null;
  name: string;
  character?: string | null;
  job?: string | null;
  profile_path?: string | null;
}

interface Props {
  cast?: Person[];
  crew?: Person[];
  guestStars?: Person[];
}

const { cast = [], crew = [], guestStars = [] } = Astro.props;
const hasCast = cast.length > 0 || guestStars.length > 0;
const hasGuestStars = guestStars.length > 0;
const hasCrew = crew.length > 0;
---

{hasCast && (
<div class="mt-24 border-zinc-900 pt-16" data-castcrew>
  <div class="flex items-center gap-2 mb-10">
    <button type="button" class="castcrew-tab-btn px-5 py-3 text-sm font-black uppercase tracking-wide text-zinc-100 border-b-2 border-blue-500 transition-colors cursor-pointer" data-tab="cast">
      {m.castcrew_cast()}
    </button>
    {hasCrew && (
      <button type="button" class="castcrew-tab-btn px-5 py-3 text-sm font-black uppercase tracking-wide text-zinc-500 hover:text-zinc-300 border-b-2 border-transparent transition-colors cursor-pointer" data-tab="crew">
        {m.castcrew_crew()}
      </button>
    )}
  </div>

  <div class="castcrew-panel" data-panel="cast">
    {cast.length > 0 && (
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6">
        {cast.map((person) => <PersonCard person={person} subtitle={person.character} />)}
      </div>
    )}
    {hasGuestStars && (
      <div class={cast.length > 0 ? "mt-12" : undefined}>
        <h3 class="group-label mb-5">{m.episode_guest_stars()}</h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6">
          {guestStars.map((person) => <PersonCard person={person} subtitle={person.character} />)}
        </div>
      </div>
    )}
  </div>

  {hasCrew && (
    <div class="castcrew-panel hidden grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6" data-panel="crew">
      {crew.map((person) => <PersonCard person={person} subtitle={person.job ? crewJobLabel(person.job) : person.job} />)}
    </div>
  )}
</div>
)}

<script>
  document.querySelectorAll('[data-castcrew]').forEach((container) => {
    const buttons = container.querySelectorAll<HTMLButtonElement>('.castcrew-tab-btn');
    const panels = container.querySelectorAll<HTMLElement>('.castcrew-panel');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.tab;
        buttons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('border-blue-500', active);
          b.classList.toggle('text-zinc-100', active);
          b.classList.toggle('border-transparent', !active);
          b.classList.toggle('text-zinc-500', !active);
        });
        panels.forEach((p) => {
          p.classList.toggle('hidden', p.dataset.panel !== target);
        });
      });
    });
  });
</script>
