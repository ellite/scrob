</section>
<script>
  const appData = document.getElementById('app-data');
  const token = appData?.dataset.token ?? '';

  function esc(s) {
    if (s == null) return '';
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function showMessage(text, type = 'success', opts: { scroll?: boolean } = {}) {
    const msg = document.getElementById('js-message');
    if (!msg) return;
    msg.textContent = text;
    msg.className = `fixed top-4 right-4 z-[200] max-w-sm p-4 rounded-lg shadow-2xl border ${
      type === 'success'
        ? 'bg-zinc-900 border-green-500/50 text-green-400'
        : 'bg-zinc-900 border-red-500/50 text-red-400'
    }`;
    msg.classList.remove('hidden');

    // Always hide after 4 seconds
    if (window._messageTimeout) clearTimeout(window._messageTimeout);
    window._messageTimeout = setTimeout(() => msg.classList.add('hidden'), 4000);
  }

  // ── Heal progress tracking ────────────────────────────────────────────────
  let healPoller: ReturnType<typeof setTimeout> | null = null;

  function renderHealProgress(job: any) {
    const strip = document.getElementById('heal-progress');
    const bar   = document.getElementById('heal-job-bar');
    const pctEl = document.getElementById('heal-job-pct');
    const label = document.getElementById('heal-job-label');
    const items = document.getElementById('heal-job-items');
    const cancelBtn = document.getElementById('heal-job-cancel') as HTMLButtonElement | null;
    if (!strip) return;

    if (!job) { strip.classList.add('hidden'); return; }
    strip.classList.remove('hidden');

    const isFailed    = job.status === 'failed';
    const isCancelled = job.status === 'cancelled';
    const isCompleted = job.status === 'completed';
    const isPending   = job.status === 'pending';

    if (isFailed || isCancelled) {
      if (cancelBtn) cancelBtn.classList.add('hidden');
      if (bar) { bar.className = 'h-1.5 rounded-full transition-all duration-500 bg-red-500'; bar.style.width = '100%'; }
      if (label) label.textContent = isCancelled ? 'Heal cancelled' : 'Heal failed';
      if (pctEl) pctEl.textContent = '';
      if (items) items.textContent = isCancelled ? '' : esc(job.error_message || 'Unknown error');
      return;
    }

    if (isCompleted) {
      if (cancelBtn) cancelBtn.classList.add('hidden');
      if (bar) { bar.className = 'h-1.5 rounded-full transition-all duration-500 bg-blue-600'; bar.style.width = '100%'; }
      if (label) label.textContent = 'Heal complete';
      if (pctEl) pctEl.textContent = '100%';
      if (items) items.textContent = `${job.processed_items} item${job.processed_items !== 1 ? 's' : ''} healed`;
      return;
    }

    wireCancelButton(cancelBtn, job);
    const pct = job.total_items > 0 ? Math.min(100, Math.round((job.processed_items / job.total_items) * 100)) : 0;
    const indeterminate = isPending || pct === 0;
    if (bar) {
      bar.className = `h-1.5 rounded-full transition-all duration-500 bg-blue-600${indeterminate ? ' animate-pulse' : ''}`;
      bar.style.width = indeterminate ? '100%' : `${pct}%`;
    }
    if (label) label.textContent = isPending ? 'Heal queued…' : 'Healing…';
    if (pctEl) pctEl.textContent = pct > 0 ? `${pct}%` : '';
    if (items) items.textContent = job.total_items > 0 ? `${job.processed_items} / ${job.total_items} items` : 'Loading…';
  }

  async function pollHealJob() {
    try {
      const res = await fetch('/api/proxy/sync/status', { headers: { 'Authorization': `Bearer ${token}` } });
      if (!res.ok) return;
      const jobs: any[] = await res.json();
      const job = jobs.find((j: any) => j.source === 'tmdb' && j.job_type === 'heal');
      const isActive = job && (job.status === 'pending' || job.status === 'running');
      const isRecentDone = job && (job.status === 'completed' || job.status === 'failed' || job.status === 'cancelled')
        && new Date(job.updated_at).getTime() > Date.now() - 8000;
      renderHealProgress((isActive || isRecentDone) ? job : null);
      if (isActive) {
        healPoller = setTimeout(pollHealJob, 2000);
      } else if (isRecentDone) {
        healPoller = setTimeout(() => { renderHealProgress(null); healPoller = null; }, 4000);
      } else {
        healPoller = null;
      }
    } catch {
      healPoller = null;
    }
  }

  function startHealPoller() {
    if (healPoller != null) clearTimeout(healPoller);
    pollHealJob();
  }

  // On page load, resume any in-progress jobs
  (async () => {
    try {
      const res = await fetch('/api/proxy/sync/status', {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      if (!res.ok) return;
      const jobs: any[] = await res.json();
      for (const job of jobs) {
        if (job.source === 'tmdb' && job.job_type === 'heal' && (job.status === 'pending' || job.status === 'running')) {
          startHealPoller();
        }
      }
    } catch { /* non-fatal */ }
  })();
  // ── End progress tracking ─────────────────────────────────────────────────

  function showConfirmModal(title: string, body: string, confirmLabel: string, infoOnly = false): Promise<boolean> {
    return new Promise(resolve => {
      const modal = document.getElementById('confirm-action-modal');
      const titleEl = document.getElementById('confirm-action-title');
      const bodyEl = document.getElementById('confirm-action-body');
      const confirmBtn = document.getElementById('confirm-action') as HTMLButtonElement | null;
      const cancelBtn = document.getElementById('cancel-action') as HTMLButtonElement | null;
      if (!modal || !titleEl || !bodyEl || !confirmBtn || !cancelBtn) { resolve(false); return; }
      titleEl.textContent = title;
      bodyEl.textContent = body;
      confirmBtn.textContent = confirmLabel;
      cancelBtn.classList.toggle('hidden', infoOnly);
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      const cleanup = (result: boolean) => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        cancelBtn.classList.remove('hidden');
        confirmBtn.removeEventListener('click', onConfirm);
        cancelBtn.removeEventListener('click', onCancel);
        resolve(result);
      };
      const onConfirm = () => cleanup(infoOnly ? false : true);
      const onCancel = () => cleanup(false);
      confirmBtn.addEventListener('click', onConfirm, { once: true });
      cancelBtn.addEventListener('click', onCancel, { once: true });
    });
  }

  function showExportDataModal(): Promise<ExportSelection | null> {
    return new Promise(resolve => {
      const modal = document.getElementById('export-data-modal');
      const confirmBtn = document.getElementById('export-data-modal-confirm') as HTMLButtonElement | null;
      const cancelBtn = document.getElementById('export-data-modal-cancel') as HTMLButtonElement | null;
      const options = Array.from(document.querySelectorAll<HTMLButtonElement>('.export-option'));
      if (!modal || !confirmBtn || !cancelBtn || options.length === 0) { resolve(null); return; }

      // The plaintext-secret options (data-secret="true") start unselected;
      // everything else is preselected by default.
      const selected = new Set(
        options.filter(o => o.getAttribute('data-secret') !== 'true').map(o => o.getAttribute('data-export-option')!)
      );

      const syncOptionUI = () => {
        options.forEach(opt => {
          const isOn = selected.has(opt.getAttribute('data-export-option')!);
          const isSecret = opt.getAttribute('data-secret') === 'true';
          const icon = opt.querySelector('.check-icon');
          icon?.classList.toggle('invisible', !isOn);
          opt.classList.toggle(isSecret ? 'border-amber-500' : 'border-blue-500', isOn);
          opt.classList.toggle('border-transparent', !isOn);
        });
        confirmBtn.disabled = selected.size === 0;
      };
      syncOptionUI();

      const optionHandlers = options.map(opt => {
        const handler = () => {
          const name = opt.getAttribute('data-export-option')!;
          if (selected.has(name)) selected.delete(name); else selected.add(name);
          syncOptionUI();
        };
        opt.addEventListener('click', handler);
        return { opt, handler };
      });

      modal.classList.remove('hidden');
      modal.classList.add('flex');

      const cleanup = (result: ExportSelection | null) => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        confirmBtn.removeEventListener('click', onConfirm);
        cancelBtn.removeEventListener('click', onCancel);
        optionHandlers.forEach(({ opt, handler }) => opt.removeEventListener('click', handler));
        resolve(result);
      };
      const onConfirm = () => cleanup({
        watched: selected.has('watched'),
        ratings: selected.has('ratings'),
        collection: selected.has('collection'),
        lists: selected.has('lists'),
        comments: selected.has('comments'),
        api_keys: selected.has('api_keys'),
        media_connections: selected.has('media_connections'),
        scrobble_connections: selected.has('scrobble_connections'),
        connections: selected.has('connections'),
      });
      const onCancel = () => cleanup(null);
      confirmBtn.addEventListener('click', onConfirm, { once: true });
      cancelBtn.addEventListener('click', onCancel, { once: true });
    });
  }

  function setupActions() {
    const btns = document.querySelectorAll('.js-action-btn');
    btns.forEach(btn => {
      // Clean up previous listeners if any (important for Astro View Transitions)
      const newBtn = btn.cloneNode(true);
      if (btn.parentNode) {
        btn.parentNode.replaceChild(newBtn, btn);
      }
      
      newBtn.addEventListener('click', async () => {
        const action = newBtn.getAttribute('data-action');
        newBtn.disabled = true;
        const originalHTML = newBtn.innerHTML;
        newBtn.textContent = '...';

        try {
          let url = '';
          let method = 'POST';
          let requestBody: Record<string, string> | undefined;

          if (action === 'test_tmdb') {
            const val = (document.getElementById('tmdb_api_key') as HTMLInputElement).value;
            url = '/api/proxy/auth/test-tmdb';
            requestBody = { key: val };
          } else if (action === 'test_tvdb') {
            const val = (document.getElementById('tvdb_api_key') as HTMLInputElement).value;
            url = '/api/proxy/auth/test-tvdb';
            requestBody = { key: val };
          }

          const res = await fetch(url, {
            method,
            headers: {
              'Authorization': `Bearer ${token}`,
              ...(requestBody ? { 'Content-Type': 'application/json' } : {}),
            },
            body: requestBody ? JSON.stringify(requestBody) : undefined,
          });
          const data = await res.json();

          if (res.ok) {
            showMessage(data.message || 'Action successful!');
          } else {
            throw new Error(data.detail || 'Action failed');
          }
        } catch (e) {
          showMessage(e.message, 'error');
        } finally {
          newBtn.disabled = false;
          newBtn.innerHTML = originalHTML;
        }
      });
    });

    // Delete Account Logic
    const deleteBtn = document.getElementById('delete-account-btn');
    const modal = document.getElementById('delete-modal');
    const cancelBtn = document.getElementById('cancel-delete');
    const confirmBtn = document.getElementById('confirm-delete');
    const clearHistoryBtn = document.getElementById('clear-history-btn');

    if (clearHistoryBtn) {
      clearHistoryBtn.onclick = async () => {
        const ok = await showConfirmModal(
          'Clear watch history?',
          'Are you sure you want to clear your entire watch history? This cannot be undone.',
          'Clear History'
        );
        if (!ok) return;

        clearHistoryBtn.disabled = true;
        clearHistoryBtn.textContent = 'Clearing...';
        
        try {
          const res = await fetch(`/api/proxy/history`, {
            method: 'DELETE',
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (res.ok) {
            showMessage('Watch history cleared successfully!');
          } else {
            const data = await res.json();
            throw new Error(data.detail || 'Failed to clear history');
          }
        } catch (e) {
          showMessage(e.message, 'error');
        } finally {
          clearHistoryBtn.disabled = false;
          clearHistoryBtn.textContent = 'Clear History';
        }
      };
    }

    const clearRatingsBtn = document.getElementById('clear-ratings-btn') as HTMLButtonElement | null;
    if (clearRatingsBtn) {
      clearRatingsBtn.onclick = async () => {
        const ok = await showConfirmModal(
          'Clear ratings?',
          'Are you sure you want to clear all your ratings? This cannot be undone.',
          'Clear Ratings'
        );
        if (!ok) return;
        clearRatingsBtn.disabled = true;
        clearRatingsBtn.textContent = 'Clearing...';
        try {
          const res = await fetch(`/api/proxy/ratings/all`, {
            method: 'DELETE',
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (res.ok) {
            showMessage('Ratings cleared successfully!');
          } else {
            const data = await res.json();
            throw new Error(data.detail || 'Failed to clear ratings');
          }
        } catch (e: any) {
          showMessage(e.message, 'error');
        } finally {
          clearRatingsBtn.disabled = false;
          clearRatingsBtn.textContent = 'Clear Ratings';
        }
      };
    }

    const clearCollectionBtn = document.getElementById('clear-collection-btn') as HTMLButtonElement | null;
    if (clearCollectionBtn) {
      clearCollectionBtn.onclick = async () => {
        const ok = await showConfirmModal(
          'Clear collection?',
          'Are you sure you want to clear your entire collection? This cannot be undone.',
          'Clear Collection'
        );
        if (!ok) return;
        clearCollectionBtn.disabled = true;
        clearCollectionBtn.textContent = 'Clearing...';
        try {
          const res = await fetch(`/api/proxy/media/collect/all`, {
            method: 'DELETE',
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (res.ok) {
            showMessage('Collection cleared successfully!');
          } else {
            const data = await res.json();
            throw new Error(data.detail || 'Failed to clear collection');
          }
        } catch (e: any) {
          showMessage(e.message, 'error');
        } finally {
          clearCollectionBtn.disabled = false;
          clearCollectionBtn.textContent = 'Clear Collection';
        }
      };
    }

    if (deleteBtn && modal && cancelBtn && confirmBtn) {
      deleteBtn.onclick = () => {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      };

      cancelBtn.onclick = () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      };

      confirmBtn.onclick = async () => {
        confirmBtn.disabled = true;
        confirmBtn.textContent = 'Deleting...';
        try {
          const res = await fetch(`/api/proxy/auth/me`, {
            method: 'DELETE',
            headers: { 'Authorization': `Bearer ${token}` }
          });
          if (res.ok) {
            window.location.href = '/logout';
          } else {
            const data = await res.json();
            throw new Error(data.detail || 'Failed to delete account');
          }
        } catch (e) {
          showMessage(e.message, 'error');
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          confirmBtn.disabled = false;
          confirmBtn.textContent = 'Yes, delete';
        }
      };
    }
  }

  function setupPasswordToggles() {
    const toggles = document.querySelectorAll('.password-toggle');
    toggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        const input = toggle.parentElement?.querySelector('input');
        if (!input) return;

        const isPassword = input.type === 'password';
        input.type = isPassword ? 'text' : 'password';

        const eyeIcon = toggle.querySelector('.eye-icon');
        const eyeSlashIcon = toggle.querySelector('.eye-slash-icon');

        if (isPassword) {
          eyeIcon?.classList.add('hidden');
          eyeSlashIcon?.classList.remove('hidden');
        } else {
          eyeIcon?.classList.remove('hidden');
          eyeSlashIcon?.classList.add('hidden');
        }
      });
    });
  }

  function setupAccentSwatches() {
    const saved = localStorage.getItem('accentTheme') || 'blue';

    function applyAccent(id) {
      if (id === 'blue') {
        document.documentElement.removeAttribute('data-accent');
      } else {
        document.documentElement.setAttribute('data-accent', id);
      }
      localStorage.setItem('accentTheme', id);

      document.querySelectorAll('.accent-swatch').forEach(btn => {
        const isActive = btn.getAttribute('data-accent-id') === id;
        btn.classList.toggle('border-zinc-100', isActive);
        btn.classList.toggle('text-zinc-100', isActive);
        btn.classList.toggle('border-zinc-800', !isActive);
        btn.classList.toggle('text-zinc-400', !isActive);
      });
    }

    applyAccent(saved);

    document.querySelectorAll('.accent-swatch').forEach(btn => {
      btn.addEventListener('click', () => applyAccent(btn.getAttribute('data-accent-id')));
    });
  }

  function setupSettingsForm() {
    const form = document.getElementById('settings-form');
    const saveBtn = document.getElementById('save-settings-btn');
    if (!form || !saveBtn) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      saveBtn.disabled = true;
      const originalText = saveBtn.textContent;
      saveBtn.textContent = 'Saving...';

      try {
        const formData = new FormData(form);
        const settings = {
          tmdb_api_key: formData.get('tmdb_api_key') || null,
          tvdb_api_key: formData.get('tvdb_api_key') || null,
        };

        const res = await fetch(`/api/proxy/auth/settings`, {
          method: 'PATCH',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify(settings),
        });

        if (!res.ok) {
          const data = await res.json();
          throw new Error(data.detail || 'Failed to update settings');
        }

        showMessage('Settings updated successfully!');
      } catch (e) {
        showMessage(e.message, 'error');
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = originalText;
      }
    });
  }

  function setupPasswordForm() {
    const form = document.getElementById('password-form');
    const updateBtn = document.getElementById('update-password-btn');
    if (!form || !updateBtn) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const current_password = formData.get('current_password') || null;
      const new_password = formData.get('new_password');
      const confirm_password = formData.get('confirm_password');

      if (new_password !== confirm_password) {
        showMessage('New passwords do not match', 'error');
        return;
      }

      updateBtn.disabled = true;
      const originalText = updateBtn.textContent;
      updateBtn.textContent = 'Updating...';

      try {
        const res = await fetch(`/api/proxy/auth/change-password`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ current_password, new_password }),
        });

        if (res.ok) {
          showMessage('Password updated successfully!');
          form.reset();
        } else {
          const data = await res.json();
          throw new Error(data.detail || 'Failed to update password');
        }
      } catch (e) {
        showMessage(e.message, 'error');
      } finally {
        updateBtn.disabled = false;
        updateBtn.textContent = originalText;
      }
    });
  }

  function setupExportData() {
    const btn = document.getElementById('export-data-btn') as HTMLButtonElement | null;
    if (!btn) return;

    btn.addEventListener('click', async () => {
      const selection = await showExportDataModal();
      if (!selection) return;

      btn.disabled = true;
      const originalText = btn.textContent;
      btn.textContent = 'Preparing…';

      try {
        const params = new URLSearchParams({
          watched: String(selection.watched),
          ratings: String(selection.ratings),
          collection: String(selection.collection),
          lists: String(selection.lists),
          comments: String(selection.comments),
          api_keys: String(selection.api_keys),
          media_connections: String(selection.media_connections),
          scrobble_connections: String(selection.scrobble_connections),
          connections: String(selection.connections),
        });
        const res = await fetch(`/api/proxy/export/data?${params}`, {
          headers: { 'Authorization': `Bearer ${token}` },
        });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.detail || 'Export failed');
        }
        const cd = res.headers.get('Content-Disposition');
        const filename = cd?.match(/filename="([^"]+)"/)?.[1] ?? 'scrob-export.zip';
        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        a.click();
        URL.revokeObjectURL(url);
        showMessage('Export downloaded successfully!');
      } catch (e) {
        showMessage(e instanceof Error ? e.message : 'Export failed', 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = originalText;
      }
    });
  }

  function setupHealButton() {
    const btn = document.getElementById('heal-btn');
    const modal = document.getElementById('heal-modal');
    const cancelBtn = document.getElementById('cancel-heal');
    const confirmBtn = document.getElementById('confirm-heal');
    if (!btn || !modal || !cancelBtn || !confirmBtn) return;

    btn.addEventListener('click', () => {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    });

    cancelBtn.addEventListener('click', () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    });

    confirmBtn.addEventListener('click', async () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      btn.disabled = true;
      const originalText = btn.textContent;
      btn.textContent = 'Healing...';
      try {
        const res = await fetch('/api/proxy/sync/heal', {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}` },
        });
        if (res.ok) {
          startHealPoller();
        } else {
          const data = await res.json();
          throw new Error(data.detail || 'Failed to start heal');
        }
      } catch (e) {
        showMessage(e.message, 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = originalText;
      }
    });
  }

  function setupClearSessionsButton() {
    const btn = document.getElementById('clear-sessions-btn');
    if (!btn) return;
    btn.addEventListener('click', async () => {
      const tok = (document.getElementById('app-data') as HTMLElement | null)?.dataset.token ?? '';
      const original = btn.textContent;
      btn.textContent = 'Clearing…';
      (btn as HTMLButtonElement).disabled = true;
      try {
        const res = await fetch('/api/proxy/history/sessions', {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${tok}` },
        });
        if (!res.ok) throw new Error('Failed');
        btn.textContent = 'Cleared';
        setTimeout(() => { btn.textContent = original; (btn as HTMLButtonElement).disabled = false; }, 2000);
      } catch {
        btn.textContent = 'Error';
        setTimeout(() => { btn.textContent = original; (btn as HTMLButtonElement).disabled = false; }, 2000);
      }
    });

    const healStubBtn = document.getElementById('heal-stub-titles-btn');
    if (healStubBtn) {
      healStubBtn.addEventListener('click', async () => {
        const tok = (document.getElementById('app-data') as HTMLElement | null)?.dataset.token ?? '';
        const original = healStubBtn.textContent;
        healStubBtn.textContent = 'Healing…';
        (healStubBtn as HTMLButtonElement).disabled = true;
        try {
          const res = await fetch('/api/proxy/sync/heal-stub-show-titles', {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${tok}` },
          });
          if (!res.ok) throw new Error('Failed');
          const data = await res.json();
          healStubBtn.textContent = data.healed > 0 ? `Healed ${data.healed}` : 'Nothing to heal';
          setTimeout(() => { healStubBtn.textContent = original; (healStubBtn as HTMLButtonElement).disabled = false; }, 3000);
        } catch {
          healStubBtn.textContent = 'Error';
          setTimeout(() => { healStubBtn.textContent = original; (healStubBtn as HTMLButtonElement).disabled = false; }, 2000);
        }
      });
    }
  }

  setupAccentSwatches();
  setupActions();
  setupPasswordToggles();
  setupSettingsForm();
  setupPasswordForm();

  // Sync blur_explicit cookie from the server-rendered value on page load.
  // Picks up changes made on another device/browser.
  const blurToggle = document.getElementById('blur-explicit-toggle') as HTMLInputElement | null;
  if (blurToggle) {
    const val = blurToggle.checked ? 'true' : 'false';
    document.cookie = `blur_explicit=${val}; path=/; SameSite=Lax; Max-Age=31536000`;
    document.documentElement.classList.toggle('blur-explicit', blurToggle.checked);

    blurToggle.addEventListener('change', async () => {
      const v = blurToggle.checked ? 'true' : 'false';
      document.cookie = `blur_explicit=${v}; path=/; SameSite=Lax; Max-Age=31536000`;
      document.documentElement.classList.toggle('blur-explicit', blurToggle.checked);
      const tok = (document.getElementById('app-data') as HTMLElement | null)?.dataset.token ?? '';
      await fetch('/api/proxy/auth/settings', {
        method: 'PATCH',
        headers: { 'Authorization': `Bearer ${tok}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({ blur_explicit: blurToggle.checked }),
      });
    });
  }

  // Sync time_format_24h cookie from the server-rendered value on page load.
  const timeFormatToggle = document.getElementById('time-format-24h-toggle') as HTMLInputElement | null;
  if (timeFormatToggle) {
    document.cookie = `time_format_24h=${timeFormatToggle.checked ? 'true' : 'false'}; path=/; SameSite=Lax; Max-Age=31536000`;

    timeFormatToggle.addEventListener('change', async () => {
      document.cookie = `time_format_24h=${timeFormatToggle.checked ? 'true' : 'false'}; path=/; SameSite=Lax; Max-Age=31536000`;
      const tok = (document.getElementById('app-data') as HTMLElement | null)?.dataset.token ?? '';
      await fetch('/api/proxy/auth/settings', {
        method: 'PATCH',
        headers: { 'Authorization': `Bearer ${tok}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({ time_format_24h: timeFormatToggle.checked }),
      });
    });
  }

  // Sync use_hls_player cookie from the server-rendered value on page load.
  const hlsPlayerToggle = document.getElementById('use-hls-player-toggle') as HTMLInputElement | null;
  if (hlsPlayerToggle) {
    document.cookie = `use_hls_player=${hlsPlayerToggle.checked ? 'true' : 'false'}; path=/; SameSite=Lax; Max-Age=31536000`;

    hlsPlayerToggle.addEventListener('change', async () => {
      document.cookie = `use_hls_player=${hlsPlayerToggle.checked ? 'true' : 'false'}; path=/; SameSite=Lax; Max-Age=31536000`;
      const tok = (document.getElementById('app-data') as HTMLElement | null)?.dataset.token ?? '';
      await fetch('/api/proxy/auth/settings', {
        method: 'PATCH',
        headers: { 'Authorization': `Bearer ${tok}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({ use_hls_player: hlsPlayerToggle.checked }),
      });
    });
  }
  setupExportData();
  setupHealButton();
  setupClearSessionsButton();

  document.addEventListener('astro:after-swap', () => {
    setupAccentSwatches();
    setupActions();
    setupPasswordToggles();
    setupSettingsForm();
    setupPasswordForm();
    setupExportData();
    setupHealButton();
    setupClearSessionsButton();
  });

  function escapeHtml(s: string): string {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
</script>

<script>
  import QRCode from 'qrcode';

  const appData = document.getElementById('app-data') as HTMLElement | null;
  const token: string = appData?.dataset.token ?? '';

  let pendingTotpSecret = '';

  function show2faSetupError(msg: string) {
    const el = document.getElementById('2fa-setup-error');
    if (!el) return;
    el.textContent = msg;
    el.classList.remove('hidden');
  }

  function hide2faSetupError() {
    document.getElementById('2fa-setup-error')?.classList.add('hidden');
  }

  function show2faDisableError(msg: string) {
    const el = document.getElementById('2fa-disable-error');
    if (!el) return;
    el.textContent = msg;
    el.classList.remove('hidden');
  }

  function setup2fa() {
    // Enable flow
    const enableBtn = document.getElementById('enable-2fa-btn');
    const setupPanel = document.getElementById('2fa-setup-panel');
    const cancelSetupBtn = document.getElementById('cancel-2fa-setup-btn');
    const confirmEnableBtn = document.getElementById('confirm-enable-2fa-btn') as HTMLButtonElement | null;
    const verifyInput = document.getElementById('totp-verify-code') as HTMLInputElement | null;
    const secretDisplay = document.getElementById('totp-secret-display');
    const qrCanvas = document.getElementById('totp-qr-canvas') as HTMLCanvasElement | null;
    const newCodesPanel = document.getElementById('2fa-new-codes-panel');
    const newCodesGrid = document.getElementById('2fa-new-codes-grid');
    const newCodesDoneBtn = document.getElementById('2fa-new-codes-done-btn');

    enableBtn?.addEventListener('click', async () => {
      enableBtn.textContent = 'Loading...';
      (enableBtn as HTMLButtonElement).disabled = true;
      hide2faSetupError();

      try {
        const res = await fetch(`/api/proxy/auth/2fa/setup`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}` },
        });
        if (!res.ok) {
          const data = await res.json();
          throw new Error(data.detail || 'Failed to start 2FA setup');
        }
        const data = await res.json() as { provisioning_uri: string; secret: string };
        pendingTotpSecret = data.secret;

        if (secretDisplay) secretDisplay.textContent = data.secret;

        if (qrCanvas) {
          await QRCode.toCanvas(qrCanvas, data.provisioning_uri, {
            width: 160,
            margin: 1,
            color: { dark: '#000000', light: '#ffffff' },
          });
        }

        setupPanel?.classList.remove('hidden');
      } catch (e: unknown) {
        show2faSetupError(e instanceof Error ? e.message : 'Setup failed');
      } finally {
        enableBtn.textContent = 'Enable 2FA';
        (enableBtn as HTMLButtonElement).disabled = false;
      }
    });

    cancelSetupBtn?.addEventListener('click', () => {
      setupPanel?.classList.add('hidden');
      pendingTotpSecret = '';
      hide2faSetupError();
      if (verifyInput) verifyInput.value = '';
    });

    confirmEnableBtn?.addEventListener('click', async () => {
      const code = verifyInput?.value.trim() ?? '';
      if (!code || !pendingTotpSecret) return;

      confirmEnableBtn.disabled = true;
      const orig = confirmEnableBtn.textContent;
      confirmEnableBtn.textContent = 'Verifying...';
      hide2faSetupError();

      try {
        const res = await fetch(`/api/proxy/auth/2fa/enable`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ secret: pendingTotpSecret, code }),
        });
        if (!res.ok) {
          const data = await res.json();
          throw new Error(data.detail || 'Invalid code');
        }
        const data = await res.json() as { codes: { id: number; code: string; used: boolean }[] };

        setupPanel?.classList.add('hidden');

        if (newCodesGrid) {
          newCodesGrid.innerHTML = data.codes
            .map(bc => `<span class="font-mono text-sm px-3 py-1.5 rounded-lg border border-zinc-700 bg-zinc-900 text-zinc-300">${escapeHtml(bc.code)}</span>`)
            .join('');
        }
        newCodesPanel?.classList.remove('hidden');
      } catch (e: unknown) {
        show2faSetupError(e instanceof Error ? e.message : 'Failed to enable 2FA');
      } finally {
        confirmEnableBtn.disabled = false;
        confirmEnableBtn.textContent = orig;
      }
    });

    newCodesDoneBtn?.addEventListener('click', () => {
      window.location.reload();
    });

    // Disable flow
    const disableBtn = document.getElementById('disable-2fa-btn');
    const disablePanel = document.getElementById('2fa-disable-panel');
    const cancelDisableBtn = document.getElementById('cancel-disable-2fa-btn');
    const confirmDisableBtn = document.getElementById('confirm-disable-2fa-btn') as HTMLButtonElement | null;
    const disableCodeInput = document.getElementById('totp-disable-code') as HTMLInputElement | null;

    disableBtn?.addEventListener('click', () => {
      disablePanel?.classList.remove('hidden');
      disableBtn.classList.add('hidden');
    });

    cancelDisableBtn?.addEventListener('click', () => {
      disablePanel?.classList.add('hidden');
      disableBtn?.classList.remove('hidden');
      if (disableCodeInput) disableCodeInput.value = '';
      document.getElementById('2fa-disable-error')?.classList.add('hidden');
    });

    confirmDisableBtn?.addEventListener('click', async () => {
      const code = disableCodeInput?.value.trim() ?? '';
      if (!code) return;

      confirmDisableBtn.disabled = true;
      const orig = confirmDisableBtn.textContent;
      confirmDisableBtn.textContent = 'Disabling...';
      document.getElementById('2fa-disable-error')?.classList.add('hidden');

      try {
        const res = await fetch(`/api/proxy/auth/2fa/disable`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ code }),
        });
        if (!res.ok) {
          const data = await res.json();
          throw new Error(data.detail || 'Failed to disable 2FA');
        }
        window.location.reload();
      } catch (e: unknown) {
        show2faDisableError(e instanceof Error ? e.message : 'Failed to disable 2FA');
        confirmDisableBtn.disabled = false;
        confirmDisableBtn.textContent = orig;
      }
    });
  }

  setup2fa();
  document.addEventListener('astro:after-swap', setup2fa);
</script>
