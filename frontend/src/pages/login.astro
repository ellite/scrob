---
import Base from "../layouts/Base.astro";
import { api } from "../lib/api";
import type { OidcConfig } from "../lib/api";

let error = "";
let success = "";
let showTotpStep = false;
let tempToken = "";

const oidcConfig: OidcConfig = await api.auth.oidcConfig().catch(() => ({
  enabled: false,
  provider_name: "SSO",
  disable_password_login: false,
}));

const { enabled: registrationEnabled, smtp_configured: smtpConfigured } = await api.auth.registrationStatus().catch(() => ({ enabled: false, smtp_configured: false }));
const { has_users: hasUsers } = await api.auth.hasUsers().catch(() => ({ has_users: true }));
const { enable_logged_out_navigation: showNav } = await api.profile.publicAccessStatus().catch(() => ({ enable_logged_out_navigation: false }));

// Only a same-site path is a safe redirect target - anything else (an
// absolute URL, or a protocol-relative "//evil.com") could send a
// successful login to an attacker-controlled site.
const rawNext = Astro.url.searchParams.get("next") || "";
const nextPath = rawNext.startsWith("/") && !rawNext.startsWith("//") ? rawNext : "/";

if (Astro.url.searchParams.get("restored") === "true") {
  success = "Database restored successfully. You can now log in.";
}

const oidcError = Astro.url.searchParams.get("oidc_error");
if (oidcError) {
  error = decodeURIComponent(oidcError.replace(/\+/g, " "));
}

const urlError = Astro.url.searchParams.get("error");
if (urlError === "invalid_activation_token") {
  error = "This activation link is invalid.";
} else if (urlError === "activation_token_expired") {
  error = "This activation link has expired. Please register again or contact an administrator.";
}

if (Astro.url.searchParams.get("email_activated") === "true") {
  success = "Your email has been confirmed! You can now sign in.";
}

if (Astro.url.searchParams.get("password_reset") === "true") {
  success = "Your password has been reset. You can now sign in with your new password.";
}


if (Astro.request.method === "POST") {
  const data = await Astro.request.formData();
  const step = (data.get("_step") as string) || "login";

  // The hidden field, not the query string, is authoritative here - it's
  // what the form that was actually rendered (and might have moved through
  // the 2FA step) carried, rather than assuming the POST landed back on the
  // same URL the page was first loaded with.
  const submittedNext = (data.get("_next") as string) || "";
  const postNext = submittedNext.startsWith("/") && !submittedNext.startsWith("//") ? submittedNext : nextPath;

  if (step === "login") {
    try {
      const result = await api.auth.login(data);
      if (result.requires_2fa && result.temp_token) {
        showTotpStep = true;
        tempToken = result.temp_token;
      } else if (result.access_token) {
        Astro.cookies.set("token", result.access_token, {
          path: "/",
          httpOnly: true,
          sameSite: "lax",
          maxAge: 60 * 60 * 24 * 7,
        });
        return Astro.redirect(postNext);
      }
    } catch (e: unknown) {
      error = e instanceof Error ? e.message : "Login failed";
    }
  } else if (step === "verify_2fa") {
    const submittedTempToken = (data.get("temp_token") as string) || "";
    const code = (data.get("totp_code") as string) || "";
    try {
      const result = await api.auth.totp2faVerifyLogin({ temp_token: submittedTempToken, code });
      if (result.access_token) {
        Astro.cookies.set("token", result.access_token, {
          path: "/",
          httpOnly: true,
          sameSite: "lax",
          maxAge: 60 * 60 * 24 * 7,
        });
        return Astro.redirect(postNext);
      }
    } catch (e: unknown) {
      error = e instanceof Error ? e.message : "Verification failed";
      showTotpStep = true;
      tempToken = submittedTempToken;
    }
  }
}

const token = Astro.cookies.get("token")?.value;
if (token) {
  return Astro.redirect(nextPath);
}

// ── Decorative poster wall (background) ──
const pwIcon = (paths: string): string =>
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;

// Fallback tile used only when the instance has no TMDB key configured yet,
// so there are no real posters to show.
const fallbackIcon = pwIcon('<rect width="20" height="20" x="2" y="2" rx="2.18" ry="2.18"/><line x1="7" x2="7" y1="2" y2="22"/><line x1="17" x2="17" y1="2" y2="22"/><line x1="2" x2="22" y1="7" y2="7"/><line x1="2" x2="22" y1="12" y2="12"/><line x1="2" x2="22" y1="17" y2="17"/>');

const { posters } = await api.media.publicPosterWall().catch(() => ({ posters: [] }));

const PW_COLS = 7;
const PW_ROWS = 4;
const pwDepths = [0.4, 1, 0.65, 1.2, 0.5, 0.9, 0.7]; // per-column parallax intensity
const pwColumns: { poster: (typeof posters)[number] | null; depth: number }[][] = Array.from(
  { length: PW_COLS },
  (_, ci) =>
    Array.from({ length: PW_ROWS }, (_, ri) => {
      const idx = ci * PW_ROWS + ri;
      return {
        poster: posters.length ? posters[idx % posters.length] : null,
        depth: pwDepths[ci % pwDepths.length],
      };
    })
);

// When the nav bar renders (logged-out navigation enabled), it adds real
// height above this section that the fixed 9rem/5rem budget below doesn't
// know about - without this, the page overflows by the nav's height even
// though the hero content itself fits the viewport.
const heroMinHeightClass = showNav
  ? "min-h-[calc(100dvh-14rem)] md:min-h-[calc(100dvh-10rem)]"
  : "min-h-[calc(100dvh-9rem)] md:min-h-[calc(100dvh-5rem)]";
---

<Base title="Welcome" hideNav={!showNav}>
  <!-- Decorative poster-wall background (full viewport, behind content) -->
  <div id="poster-wall-viewport" class="fixed inset-0 z-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="poster-wall">
      {pwColumns.map((col, ci) => (
        <div class={`pw-col pw-drift-${ci % 3}`} data-depth={col[0]?.depth ?? 0.7}>
          {col.map(({ poster }, ri) => (
            poster ? (
              <div class="pw-card pw-card--poster">
                <img
                  src={`https://image.tmdb.org/t/p/w342${poster.poster_path}`}
                  alt=""
                  loading="lazy"
                  referrerpolicy="no-referrer"
                />
              </div>
            ) : (
              <div class={`pw-card pw-g${(ri * 3 + ci) % 5}`}>
                <span class="pw-icon" set:html={fallbackIcon} />
              </div>
            )
          ))}
        </div>
      ))}
    </div>
    <div class="pw-overlay"></div>
  </div>

  {!showNav && (
  <button
    id="theme-toggle"
    tabindex="1"
    class="fixed top-4 right-4 z-20 p-2 rounded-lg bg-zinc-900/80 backdrop-blur-sm border border-zinc-700 text-zinc-400 hover:text-zinc-100 transition-all hover:scale-110 active:scale-95"
    aria-label="Toggle Theme"
  >
    <span id="sun-icon" class="hidden">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
    </span>
    <span id="moon-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
    </span>
  </button>
  )}

  <div class={`relative z-10 ${heroMinHeightClass} flex items-center py-6 md:py-10`}>
    <div class="w-full grid md:grid-cols-2 gap-8 md:gap-12 lg:gap-20 items-center">

      <!-- Hero: what Scrob is -->
      <div class="text-center md:text-left hero-copy">
        <div class="flex items-center justify-center md:justify-start gap-3 mb-5 md:mb-7">
          <img src="/scrob.png" alt="Scrob Logo" class="w-12 md:w-14 object-contain" />
          <span class="text-zinc-100 font-black text-2xl md:text-3xl tracking-tight">Scrob</span>
        </div>
        <h1 class="text-3xl md:text-5xl font-black text-zinc-100 leading-tight mb-4">
          Track <span class="hero-gradient-text text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-blue-600">everything</span> you watch.
        </h1>
        <p class="hero-lead text-zinc-400 text-sm md:text-base leading-relaxed max-w-lg mx-auto md:mx-0">
          <span class="hero-highlight-mark">Scrob is your private, self-hosted home for movies and TV. Sync your
          media servers, keep your watch history, rate and review, and always
          know what to watch next.</span>
        </p>

        <ul class="hidden md:flex flex-col gap-4 mt-8">
          <li class="flex items-start gap-3">
            <span class="shrink-0 w-9 h-9 rounded-lg bg-zinc-900/80 border border-zinc-700 flex items-center justify-center text-blue-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>
            </span>
            <span>
              <span class="block text-sm font-semibold text-zinc-100">Syncs with your servers</span>
              <span class="hero-lead block text-sm text-zinc-400">Jellyfin, Plex, Emby, Kodi and more - in and out.</span>
            </span>
          </li>
          <li class="flex items-start gap-3">
            <span class="shrink-0 w-9 h-9 rounded-lg bg-zinc-900/80 border border-zinc-700 flex items-center justify-center text-blue-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </span>
            <span>
              <span class="block text-sm font-semibold text-zinc-100">Complete watch history</span>
              <span class="hero-lead block text-sm text-zinc-400">Every movie, episode and rewatch, with ratings and reviews.</span>
            </span>
          </li>
          <li class="flex items-start gap-3">
            <span class="shrink-0 w-9 h-9 rounded-lg bg-zinc-900/80 border border-zinc-700 flex items-center justify-center text-blue-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h.01"/><path d="M3 18h.01"/><path d="M3 6h.01"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M8 6h13"/></svg>
            </span>
            <span>
              <span class="block text-sm font-semibold text-zinc-100">Lists and collections</span>
              <span class="hero-lead block text-sm text-zinc-400">Watchlists, custom lists and lists shared by the community.</span>
            </span>
          </li>
          <li class="flex items-start gap-3">
            <span class="shrink-0 w-9 h-9 rounded-lg bg-zinc-900/80 border border-zinc-700 flex items-center justify-center text-blue-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/></svg>
            </span>
            <span>
              <span class="block text-sm font-semibold text-zinc-100">Discover and stats</span>
              <span class="hero-lead block text-sm text-zinc-400">Trending titles, personal recommendations and your viewing stats.</span>
            </span>
          </li>
        </ul>

        <div class="hidden md:flex items-center gap-2 mt-8 text-xs text-zinc-500">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.8 1.3 3.49 1 .1-.78.42-1.31.76-1.61-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.25 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z"/></svg>
          <span>Open source and self-hosted.</span>
          <a href="https://github.com/ellite/scrob" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-zinc-100 underline underline-offset-2 transition-colors">GitHub</a>
        </div>
      </div>

      <!-- Login card -->
      <div class="w-full max-w-md mx-auto md:justify-self-end">
        <div class="p-8 bg-zinc-900/85 backdrop-blur-md rounded-xl border border-zinc-800 shadow-2xl">
    <h2 class="text-2xl font-bold mb-6 text-zinc-100 text-center">Sign in</h2>

    {error && (
      <div class="bg-red-500/10 border border-red-500 text-red-500 p-3 rounded-lg mb-6">
        {error}
      </div>
    )}

    {success && (
      <div class="bg-green-500/10 border border-green-500 text-green-400 p-3 rounded-lg mb-6">
        {success}
      </div>
    )}

    {!showTotpStep ? (
      <>
        {/* OIDC button */}
        {oidcConfig.enabled && (
          <a
            href={`/oidc-start?next=${encodeURIComponent(nextPath)}`}
            tabindex="2"
            class="flex items-center justify-center gap-2 w-full bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-100 font-bold py-2 rounded-lg transition-colors cursor-pointer mb-4"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" />
            </svg>
            Login with {oidcConfig.provider_name}
          </a>
        )}

        {/* Divider when both options are visible */}
        {oidcConfig.enabled && !oidcConfig.disable_password_login && (
          <div class="relative my-4">
            <div class="absolute inset-0 flex items-center">
              <div class="w-full border-t border-zinc-800"></div>
            </div>
            <div class="relative flex justify-center">
              <span class="bg-zinc-900 px-3 text-xs text-zinc-400">or</span>
            </div>
          </div>
        )}

        {/* Password form */}
        {!oidcConfig.disable_password_login && (
          <form method="POST" class="space-y-4">
            <input type="hidden" name="_step" value="login" />
            <input type="hidden" name="_next" value={nextPath} />
            <div>
              <label for="username" class="block text-sm font-medium text-zinc-400 mb-1">Username</label>
              <input
                type="text"
                name="username"
                id="username"
                autocomplete="username"
                required
                tabindex="3"
                class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
              />
            </div>
            <div>
            <div class="flex items-center justify-between">
                <label for="password" class="block text-sm font-medium text-zinc-400">Password</label>
                {smtpConfigured && (
                  <a href="/forgot-password" tabindex="7" class="text-xs text-zinc-500 hover:text-zinc-300 transition-colors">Forgot password?</a>
                )}
              </div>
              <div class="relative group/field">
                <input
                  type="password"
                  name="password"
                  id="password"
                  autocomplete="current-password"
                  required
                  tabindex="4"
                  class="w-full bg-zinc-800 border border-zinc-700 rounded-lg pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
                />
                <button
                  type="button"
                  tabindex="5"
                  class="password-toggle absolute right-2 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 p-1 cursor-pointer transition-colors"
                  aria-label="Toggle password visibility"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.644C3.412 7.943 7.213 5 12 5c4.787 0 8.588 2.943 9.964 6.678.066.18.066.362 0 .544C20.588 16.057 16.787 19 12 19c-4.787 0-8.588-2.943-9.964-6.678z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-slash-icon hidden">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                  </svg>
                </button>
              </div>
            </div>
            <button
              type="submit"
              tabindex="6"
              class="w-full bg-zinc-100 text-zinc-950 font-bold py-2 rounded-lg hover:bg-zinc-200 transition-colors cursor-pointer mt-4"
            >
              Sign In
            </button>
          </form>
        )}

        {!oidcConfig.disable_password_login && registrationEnabled && (
          <div class="mt-6 text-center text-sm text-zinc-500">
            Don't have an account? <a href="/register" tabindex="8" class="text-zinc-100 hover:underline">Register</a>
          </div>
        )}
      </>
    ) : (
      <form method="POST" class="space-y-4">
        <input type="hidden" name="_step" value="verify_2fa" />
        <input type="hidden" name="temp_token" value={tempToken} />
        <input type="hidden" name="_next" value={nextPath} />
        <div class="text-center mb-2">
          <div class="w-12 h-12 bg-zinc-800 rounded-full flex items-center justify-center mx-auto mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-zinc-300">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
            </svg>
          </div>
          <p class="text-sm text-zinc-400">Enter the 6-digit code from your authenticator app, or a backup code.</p>
        </div>
        <div>
          <label for="totp_code" class="block text-sm font-medium text-zinc-400 mb-1">Verification Code</label>
          <input
            type="text"
            name="totp_code"
            id="totp_code"
            required
            autocomplete="one-time-code"
            inputmode="numeric"
            placeholder="000000 or XXXX-XXXX"
            class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all text-center tracking-widest text-lg font-mono"
          />
        </div>
        <button
          type="submit"
          class="w-full bg-zinc-100 text-zinc-950 font-bold py-2 rounded-lg hover:bg-zinc-200 transition-colors cursor-pointer mt-4"
        >
          Verify
        </button>
        <div class="text-center">
          <a href={`/login?next=${encodeURIComponent(nextPath)}`} class="text-sm text-zinc-500 hover:text-zinc-300 transition-colors">Back to login</a>
        </div>
      </form>
    )}
        </div>

        {!hasUsers && (
          <div class="mt-4">
            <div class="flex items-center gap-3 mb-4">
              <div class="flex-1 border-t border-zinc-800"></div>
              <span class="text-xs text-zinc-600">or restore from backup</span>
              <div class="flex-1 border-t border-zinc-800"></div>
            </div>
            <div class="p-6 bg-zinc-900/85 backdrop-blur-md border border-zinc-800 rounded-xl shadow-2xl">
              <h2 class="font-semibold text-zinc-100 mb-1">Restore Database</h2>
              <p class="text-sm text-zinc-400 mb-4">Upload a <code class="text-zinc-300">.bak</code> file to restore a previous installation.</p>
              <div class="flex flex-col gap-3">
                <input id="bootstrap-restore-file" type="file" accept=".bak"
                  class="block w-full text-sm text-zinc-400 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-zinc-800 file:text-zinc-300 hover:file:bg-zinc-700 file:cursor-pointer cursor-pointer" />
                <button id="bootstrap-restore-btn" disabled
                  class="w-full px-5 py-2.5 bg-red-600 hover:bg-red-500 text-white text-sm font-semibold rounded-xl transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
                  Restore Database
                </button>
              </div>
