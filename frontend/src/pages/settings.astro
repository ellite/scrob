---
import Base from "../layouts/Base.astro";
import { api } from "../lib/api";
import type { TotpBackupCode } from "../lib/api";
import { UI_LANGUAGES } from "../lib/ui-languages";
import { m } from "../paraglide/messages.js";

const { token } = Astro.locals;
const [settings, me] = await Promise.all([
  Astro.locals.settings ?? api.auth.getSettings(token!),
  api.auth.me(token!),
]);
const hasTmdbKey = settings.has_effective_tmdb_key;
let backupCodes: TotpBackupCode[] = [];
if (me.totp_enabled) {
  try {
    const res = await api.auth.totp2faBackupCodes(token!);
    backupCodes = res.codes;
  } catch {
    // non-fatal — codes panel will just be empty
  }
}
---

<Base title={m.nav_settings()}>
  <div id="app-data" data-token={token} class="hidden" aria-hidden="true"></div>
  <div class="max-w-4xl mx-auto">
    <h1 class="page-title mb-8">{m.nav_settings()}</h1>

    <div id="js-message" class="hidden fixed right-4 z-[200] max-w-sm p-4 rounded-lg shadow-2xl border"></div>

    <div class="space-y-12">
      <!-- General Settings -->
      <section>
        <div class="flex items-center justify-between mb-4 border-b border-zinc-800 pb-2">
          <h2 class="section-headline">{m.settings_general()}</h2>
        </div>
        <form id="settings-form" class="space-y-6">
          <div class="space-y-6 max-w-xl">
          <!-- TMDB Read Access Token -->
          <div class="space-y-2">
            <label for="tmdb_api_key" class="block text-sm font-medium text-zinc-400">{m.settings_tmdb_read_access_token()}</label>
            <div class="flex gap-2">
              <div class="relative flex-1 group/field">
                <input
                  type="password"
                  name="tmdb_api_key"
                  id="tmdb_api_key"
                  value={settings.tmdb_api_key || ""}
                  class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
                />
                <button
                  type="button"
                  class="password-toggle absolute right-2 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 p-1 cursor-pointer transition-colors"
                  aria-label={m.auth_toggle_password()}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.644C3.412 7.943 7.213 5 12 5c4.787 0 8.588 2.943 9.964 6.678.066.18.066.362 0 .544C20.588 16.057 16.787 19 12 19c-4.787 0-8.588-2.943-9.964-6.678z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-slash-icon hidden">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                  </svg>
                </button>
              </div>
              <button
                type="button"
                data-action="test_tmdb"
                title={m.settings_test_tmdb_token()}
                class="js-action-btn px-3 py-2 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 rounded-lg transition-colors cursor-pointer disabled:opacity-50"
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 010 1.972l-11.54 6.347a1.125 1.125 0 01-1.667-.986V5.653z" />
                </svg>
              </button>
            </div>
            {settings.has_global_tmdb_key && !settings.tmdb_api_key ? (
              <p class="text-xs text-blue-400">{m.settings_a_server_wide_tmdb_token_is()}</p>
            ) : settings.has_global_tmdb_key && settings.tmdb_api_key ? (
              <p class="text-xs text-blue-400">{m.settings_a_server_wide_tmdb_token_is_2()}</p>
            ) : (
              <p class="text-xs text-zinc-500">{m.settings_paste_the_api_read_access_token()}</p>
            )}
          </div>

          <!-- TVDB API Key -->
          <div class="space-y-2">
            <label for="tvdb_api_key" class="block text-sm font-medium text-zinc-400">{m.settings_tvdb_api_key()}</label>
            <div class="flex gap-2">
              <div class="relative flex-1 group/field">
                <input
                  type="password"
                  name="tvdb_api_key"
                  id="tvdb_api_key"
                  value={settings.tvdb_api_key || ""}
                  placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                  class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
                />
                <button
                  type="button"
                  class="password-toggle absolute right-2 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 p-1 cursor-pointer transition-colors"
                  aria-label={m.auth_toggle_password()}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.644C3.412 7.943 7.213 5 12 5c4.787 0 8.588 2.943 9.964 6.678.066.18.066.362 0 .544C20.588 16.057 16.787 19 12 19c-4.787 0-8.588-2.943-9.964-6.678z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-slash-icon hidden">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                  </svg>
                </button>
              </div>
              <button
                type="button"
                data-action="test_tvdb"
                title={m.settings_test_tvdb_key()}
                class="js-action-btn px-3 py-2 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 rounded-lg transition-colors cursor-pointer disabled:opacity-50"
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 010 1.972l-11.54 6.347a1.125 1.125 0 01-1.667-.986V5.653z" />
                </svg>
              </button>
            </div>
            {settings.has_global_tvdb_key && !settings.tvdb_api_key ? (
              <p class="text-xs text-blue-400">{m.settings_a_server_wide_tvdb_key_is()}</p>
            ) : settings.has_global_tvdb_key && settings.tvdb_api_key ? (
              <p class="text-xs text-blue-400">{m.settings_a_server_wide_tvdb_key_is_2()}</p>
            ) : null}

            <label for="tvdb_subscriber_pin" class="block text-sm font-medium text-zinc-400 pt-2" set:html={m.settings_tvdb_pin_label()} />
            <div class="relative group/field">
              <input
                type="password"
                name="tvdb_subscriber_pin"
                id="tvdb_subscriber_pin"
                value={settings.tvdb_subscriber_pin || ""}
                placeholder={m.settings_only_for_a_subscriber_supported_key()}
                class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
              />
              <button
                type="button"
                class="password-toggle absolute right-2 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 p-1 cursor-pointer transition-colors"
                aria-label={m.auth_toggle_password()}
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-icon">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.644C3.412 7.943 7.213 5 12 5c4.787 0 8.588 2.943 9.964 6.678.066.18.066.362 0 .544C20.588 16.057 16.787 19 12 19c-4.787 0-8.588-2.943-9.964-6.678z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-slash-icon hidden">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                </svg>
              </button>
            </div>

            <div class="text-xs text-zinc-500 space-y-1 pt-1">
              <p>{m.settings_powers_shows_and_episodes_not_on()}</p>
              <p set:html={m.settings_tvdb_key_help()} />
            </div>
          </div>
          <!-- RPDB API Key -->
          <div class="space-y-2">
            <label for="rpdb_api_key" class="block text-sm font-medium text-zinc-400">{m.settings_rpdb_api_key()}</label>
            <div class="flex gap-2">
              <div class="relative flex-1 group/field">
                <input
                  type="password"
                  name="rpdb_api_key"
                  id="rpdb_api_key"
                  value={settings.rpdb_api_key || ""}
                  maxlength="255"
                  class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
                />
                <button
                  type="button"
                  class="password-toggle absolute right-2 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 p-1 cursor-pointer transition-colors"
                  aria-label={m.auth_toggle_password()}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.644C3.412 7.943 7.213 5 12 5c4.787 0 8.588 2.943 9.964 6.678.066.18.066.362 0 .544C20.588 16.057 16.787 19 12 19c-4.787 0-8.588-2.943-9.964-6.678z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-slash-icon hidden">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                  </svg>
                </button>
              </div>
              <button
                type="button"
                data-action="test_rpdb"
                title={m.settings_test_rpdb_key()}
                class="js-action-btn px-3 py-2 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 rounded-lg transition-colors cursor-pointer disabled:opacity-50"
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 010 1.972l-11.54 6.347a1.125 1.125 0 01-1.667-.986V5.653z" />
                </svg>
              </button>
            </div>
            <div class="text-xs text-zinc-500 space-y-1">
              <p>{m.settings_optional_personal_key_for_rating_posters()}</p>
              <p set:html={m.settings_rpdb_help()} />
            </div>
          </div>
          </div>

          <div class="pt-6">
            <button
              id="save-settings-btn"
              type="submit"
              class="w-full sm:w-auto bg-zinc-100 text-zinc-950 font-bold px-8 py-3 rounded-xl hover:bg-zinc-200 transition-colors cursor-pointer disabled:opacity-50"
            >
              {m.common_save_changes()}
            </button>
          </div>
        </form>
      </section>

      <!-- Display Settings -->
      <section>
        <h2 class="section-headline mb-4 border-b border-zinc-800 pb-2">{m.settings_display_settings()}</h2>
        <div class="space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 sm:gap-6 p-4 bg-zinc-900/60 rounded-xl border border-zinc-800">
            <div>
              <label for="ui-language-select" class="block text-sm font-semibold text-zinc-100 mb-1">{m.settings_ui_language_title()}</label>
              <p class="text-xs text-zinc-400">{m.settings_ui_language_description()}</p>
            </div>
            <select
              id="ui-language-select"
              class="shrink-0 bg-zinc-900 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
            >
              <option value="" selected={!settings.ui_language}>{m.settings_ui_language_auto()}</option>
              {UI_LANGUAGES.map(({ code, name }) => (
                <option value={code} lang={code} selected={settings.ui_language === code}>{name}</option>
              ))}
            </select>
          </div>
          <div class="flex items-start justify-between gap-6 p-4 bg-zinc-900/60 rounded-xl border border-zinc-800">
            <div>
              <p class="text-sm font-semibold text-zinc-100 mb-1">{m.settings_shuffle_next_up()}</p>
              <p class="text-xs text-zinc-400">{m.settings_randomize_the_order_of_the_next()}</p>
            </div>
            <label class="relative inline-flex items-center shrink-0 cursor-pointer mt-0.5">
              <input
                type="checkbox"
                name="shuffle_next_up"
                id="shuffle-next-up-toggle"
                class="sr-only peer"
                checked={settings.shuffle_next_up === true}
              />
              <div class="w-11 h-6 bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-500"></div>
            </label>
          </div>
          <div class="flex items-start justify-between gap-6 p-4 bg-zinc-900/60 rounded-xl border border-zinc-800">
            <div>
              <p class="text-sm font-semibold text-zinc-100 mb-1">{m.settings_minimalist_next_up()}</p>
              <p class="text-xs text-zinc-400">{m.settings_show_the_next_up_row_like()}</p>
            </div>
            <label class="relative inline-flex items-center shrink-0 cursor-pointer mt-0.5">
              <input
                type="checkbox"
                name="minimalist_next_up"
                id="minimalist-next-up-toggle"
                class="sr-only peer"
                checked={settings.minimalist_next_up === true}
              />
              <div class="w-11 h-6 bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-500"></div>
            </label>
          </div>
          <div class="flex items-start justify-between gap-6 p-4 bg-zinc-900/60 rounded-xl border border-zinc-800">
            <div>
              <p class="text-sm font-semibold text-zinc-100 mb-1">{m.settings_hide_watched_from_recently_added()}</p>
              <p class="text-xs text-zinc-400">{m.settings_hide_items_you_ve_already_watched()}</p>
            </div>
            <label class="relative inline-flex items-center shrink-0 cursor-pointer mt-0.5">
              <input
                type="checkbox"
                name="hide_watched_from_recently_added"
                id="hide-watched-recently-added-toggle"
                class="sr-only peer"
                checked={settings.hide_watched_from_recently_added === true}
              />
              <div class="w-11 h-6 bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-500"></div>
            </label>
          </div>
          <div class="flex items-start justify-between gap-6 p-4 bg-zinc-900/60 rounded-xl border border-zinc-800">
            <div>
              <p class="text-sm font-semibold text-zinc-100 mb-1">{m.settings_condense_history_by_show()}</p>
              <p class="text-xs text-zinc-400">{m.settings_on_the_watch_history_page_collapse()}</p>
            </div>
            <label class="relative inline-flex items-center shrink-0 cursor-pointer mt-0.5">
              <input
                type="checkbox"
                name="condense_history_by_show"
                id="condense-history-toggle"
                class="sr-only peer"
                checked={settings.condense_history_by_show === true}
              />
              <div class="w-11 h-6 bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-500"></div>
            </label>
          </div>
          <div class="flex items-start justify-between gap-6 p-4 bg-zinc-900/60 rounded-xl border border-zinc-800">
            <div>
              <p class="text-sm font-semibold text-zinc-100 mb-1">{m.settings_prompt_to_rate_after_watching()}</p>
              <p class="text-xs text-zinc-400">{m.settings_when_something_finishes_playing_and_drops()}</p>
            </div>
            <div class="flex flex-col gap-3 shrink-0 mt-0.5">
              <div class="flex items-center gap-2">
                <span class="text-xs text-zinc-400 w-16 text-right">{m.common_movies()}</span>
                <label class="relative inline-flex items-center shrink-0 cursor-pointer">
                  <input
                    type="checkbox"
                    name="rate_prompt_movies"
                    id="rate-prompt-movies-toggle"
                    class="sr-only peer"
                    checked={settings.rate_prompt_movies === true}
                  />
                  <div class="w-11 h-6 bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-500"></div>
                </label>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-xs text-zinc-400 w-16 text-right">{m.show_episodes()}</span>
                <label class="relative inline-flex items-center shrink-0 cursor-pointer">
                  <input
                    type="checkbox"
                    name="rate_prompt_episodes"
                    id="rate-prompt-episodes-toggle"
                    class="sr-only peer"
                    checked={settings.rate_prompt_episodes === true}
                  />
                  <div class="w-11 h-6 bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-500"></div>
                </label>
              </div>
            </div>
          </div>
          <div class="flex items-start justify-between gap-6 p-4 bg-zinc-900/60 rounded-xl border border-zinc-800">
            <div>
              <p class="text-sm font-semibold text-zinc-100 mb-1">{m.settings_duplicate_watch_window()}</p>
              <p class="text-xs text-zinc-400">{m.settings_if_a_movie_or_episode_is()}</p>
            </div>
            <div class="flex items-center gap-2 shrink-0 mt-0.5">
              <input
                type="number"
                min="0"
                step="1"
                name="duplicate_watch_window_minutes"
                id="duplicate-watch-window-input"
                placeholder="5"
                value={settings.duplicate_watch_window_minutes ?? ''}
                class="w-24 bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
              />
              <span class="text-xs text-zinc-500">{m.settings_min()}</span>
            </div>
          </div>
          <div class="flex items-start justify-between gap-6 p-4 bg-zinc-900/60 rounded-xl border border-zinc-800">
            <div>
              <p class="text-sm font-semibold text-zinc-100 mb-1">{m.settings_blur_explicit_content()}</p>
