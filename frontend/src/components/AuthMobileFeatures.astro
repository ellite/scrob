---
// Compact feature strip shown under the auth card on mobile only, where the
// full hero feature list is hidden. Shared by /login and /register.
import { m } from "../paraglide/messages.js";
---

<div class="md:hidden mt-6 grid grid-cols-2 gap-2 text-left">
  <div class="flex items-center gap-2 bg-zinc-900/70 backdrop-blur-sm border border-zinc-800 rounded-lg px-3 py-2.5">
    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-blue-400"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>
    <span class="text-xs text-zinc-300">{m.auth_mobile_sync()}</span>
  </div>
  <div class="flex items-center gap-2 bg-zinc-900/70 backdrop-blur-sm border border-zinc-800 rounded-lg px-3 py-2.5">
    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-blue-400"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    <span class="text-xs text-zinc-300">{m.auth_mobile_history()}</span>
  </div>
  <div class="flex items-center gap-2 bg-zinc-900/70 backdrop-blur-sm border border-zinc-800 rounded-lg px-3 py-2.5">
    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-blue-400"><path d="M3 12h.01"/><path d="M3 18h.01"/><path d="M3 6h.01"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M8 6h13"/></svg>
    <span class="text-xs text-zinc-300">{m.auth_mobile_lists()}</span>
  </div>
  <div class="flex items-center gap-2 bg-zinc-900/70 backdrop-blur-sm border border-zinc-800 rounded-lg px-3 py-2.5">
    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-blue-400"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/></svg>
    <span class="text-xs text-zinc-300">{m.auth_mobile_discover()}</span>
  </div>
</div>
