  // ── Auto connection check on page load ──
  async function checkConnections() {
    const radarrUrl = (document.getElementById('radarr_url') as HTMLInputElement | null)?.value.trim();
    const radarrToken = (document.getElementById('radarr_token') as HTMLInputElement | null)?.value.trim();
    const sonarrUrl = (document.getElementById('sonarr_url') as HTMLInputElement | null)?.value.trim();
    const sonarrToken = (document.getElementById('sonarr_token') as HTMLInputElement | null)?.value.trim();

    const checks: Promise<void>[] = [];

    if (radarrUrl && radarrToken) {
      setConnStatus('radarr-conn-status', 'checking');
      checks.push((async () => {
        try {
          const testRes = await postIntegrationCredentials(
            '/api/proxy/auth/test-radarr',
            { url: radarrUrl, token: radarrToken },
          );
          if (!testRes.ok) { setConnStatus('radarr-conn-status', 'disconnected'); return; }
          const profRes = await postIntegrationCredentials(
            '/api/proxy/auth/radarr/profiles',
            { url: radarrUrl, token: radarrToken },
          );
          const profData = await profRes.json();
          const rootSelect = document.getElementById('radarr_root_folder') as HTMLSelectElement;
          const qualSelect = document.getElementById('radarr_quality_profile') as HTMLSelectElement;
          const currentFolder = rootSelect.value;
          const currentProfile = qualSelect.value;
          rootSelect.innerHTML = `<option value="">${esc(m.admin_select_folder())}</option>` +
            profData.root_folders.map((f: { path: string; freeSpace: number }) =>
              `<option value="${esc(f.path)}" ${f.path === currentFolder ? 'selected' : ''}>${esc(m.admin_folder_free_space({ path: f.path, free: formatNumber(f.freeSpace / 1024**3, { minimumFractionDigits: 1, maximumFractionDigits: 1 }) }))}</option>`).join('');
          qualSelect.innerHTML = `<option value="">${esc(m.admin_select_profile())}</option>` +
            profData.quality_profiles.map((p: { id: number; name: string }) =>
              `<option value="${esc(String(p.id))}" ${String(p.id) === currentProfile ? 'selected' : ''}>${esc(p.name)}</option>`).join('');
          const tagContainer = document.getElementById('radarr_tags_list')!;
          const selectedTags = Array.from(tagContainer.querySelectorAll<HTMLInputElement>('input[name="radarr_tags"]'))
            .filter(i => i.type !== 'checkbox' || i.checked)
            .map(i => parseInt(i.value));
          renderTags('radarr_tags_list', profData.tags, selectedTags, 'radarr');
          setConnStatus('radarr-conn-status', 'connected');
        } catch { setConnStatus('radarr-conn-status', 'disconnected'); }
      })());
    }

    if (sonarrUrl && sonarrToken) {
      setConnStatus('sonarr-conn-status', 'checking');
      checks.push((async () => {
        try {
          const testRes = await postIntegrationCredentials(
            '/api/proxy/auth/test-sonarr',
            { url: sonarrUrl, token: sonarrToken },
          );
          if (!testRes.ok) { setConnStatus('sonarr-conn-status', 'disconnected'); return; }
          const profRes = await postIntegrationCredentials(
            '/api/proxy/auth/sonarr/profiles',
            { url: sonarrUrl, token: sonarrToken },
          );
          const profData = await profRes.json();
          const rootSelect = document.getElementById('sonarr_root_folder') as HTMLSelectElement;
          const qualSelect = document.getElementById('sonarr_quality_profile') as HTMLSelectElement;
          const currentFolder = rootSelect.value;
          const currentProfile = qualSelect.value;
          rootSelect.innerHTML = `<option value="">${esc(m.admin_select_folder())}</option>` +
            profData.root_folders.map((f: { path: string; freeSpace: number }) =>
              `<option value="${esc(f.path)}" ${f.path === currentFolder ? 'selected' : ''}>${esc(m.admin_folder_free_space({ path: f.path, free: formatNumber(f.freeSpace / 1024**3, { minimumFractionDigits: 1, maximumFractionDigits: 1 }) }))}</option>`).join('');
          qualSelect.innerHTML = `<option value="">${esc(m.admin_select_profile())}</option>` +
            profData.quality_profiles.map((p: { id: number; name: string }) =>
              `<option value="${esc(String(p.id))}" ${String(p.id) === currentProfile ? 'selected' : ''}>${esc(p.name)}</option>`).join('');
          const tagContainer = document.getElementById('sonarr_tags_list')!;
          const selectedTags = Array.from(tagContainer.querySelectorAll<HTMLInputElement>('input[name="sonarr_tags"]'))
            .filter(i => i.type !== 'checkbox' || i.checked)
            .map(i => parseInt(i.value));
          renderTags('sonarr_tags_list', profData.tags, selectedTags, 'sonarr');
          setConnStatus('sonarr-conn-status', 'connected');
        } catch { setConnStatus('sonarr-conn-status', 'disconnected'); }
      })());
    }

    await Promise.all(checks);
  }

