---
import Base from "../layouts/Base.astro";
import PosterWall from "../components/PosterWall.astro";
import { api } from "../lib/api";
import { escapeHtml } from "../lib/format";
import { m } from "../paraglide/messages.js";

export const prerender = false;

const { token } = Astro.locals;
Astro.response.headers.set("Cache-Control", "no-store");

const rawCode = (Astro.url.searchParams.get("code") ?? "").trim();
// Canonical XXXX-XXXX for display / the confirm form; the backend normalizes
// again so lenient input still works.
const normalized = rawCode.replace(/[^A-Za-z0-9]/g, "").toUpperCase();
const code = normalized.length === 8 ? `${normalized.slice(0, 4)}-${normalized.slice(4)}` : rawCode;

type State = "signed-out" | "enter-code" | "confirm" | "not-found";
let state: State = "enter-code";
let clientName = "";
let scope = "";

if (!token) {
  state = "signed-out";
} else if (code) {
  try {
    const pending = await api.auth.devicePending(code, token);
    clientName = pending.client_name;
    scope = pending.scope;
    state = "confirm";
  } catch {
    state = "not-found";
  }
}

const loginHref = `/login?next=${encodeURIComponent(`/link${rawCode ? `?code=${rawCode}` : ""}`)}`;
---

<Base title={m.link_page_title()} hideNav>
  <PosterWall />

  <div class="relative z-10 min-h-[calc(100dvh-9rem)] md:min-h-[calc(100dvh-5rem)] flex items-center justify-center py-10">
  <div class="w-full max-w-md p-8 bg-zinc-900/85 backdrop-blur-md rounded-xl border border-zinc-800 shadow-2xl">
    <div class="flex flex-col items-center mb-6">
      <img src="/scrob.png" alt={m.nav_logo_alt()} class="w-36 object-contain mb-2" />
      <span class="text-zinc-100 font-bold text-xl tracking-tight">{m.link_page_title()}</span>
    </div>

    {state === "signed-out" && (
      <div class="text-center py-2">
        <p class="text-sm text-zinc-400 mb-6">
          {m.link_signed_out()}
        </p>
        <a href={loginHref} class="inline-block bg-zinc-100 text-zinc-950 font-bold px-6 py-2 rounded-lg hover:bg-zinc-200 transition-colors">
          {m.auth_sign_in()}
        </a>
      </div>
    )}

    {state === "enter-code" && (
      <form method="get" class="py-2">
        <label for="code" class="block text-sm text-zinc-400 mb-2">
          {m.link_enter_code()}
        </label>
        <input
          id="code"
          name="code"
          type="text"
          autocomplete="one-time-code"
          autocapitalize="characters"
          spellcheck="false"
          placeholder="XXXX-XXXX"
          value={rawCode}
          class="w-full text-center tracking-[0.3em] font-mono text-lg uppercase bg-zinc-950 border border-zinc-700 rounded-lg px-4 py-3 text-zinc-100 focus:outline-none focus:border-blue-500 mb-4"
        />
        <button type="submit" class="w-full bg-zinc-100 text-zinc-950 font-bold px-6 py-2.5 rounded-lg hover:bg-zinc-200 transition-colors cursor-pointer">
          {m.common_continue()}
        </button>
      </form>
    )}

    {state === "not-found" && (
      <div class="text-center py-2">
        <div class="w-14 h-14 bg-yellow-500/10 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-7 h-7 text-yellow-400">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
          </svg>
        </div>
        <h1 class="text-xl font-bold text-zinc-100 mb-2">{m.link_code_not_recognized()}</h1>
        <p class="text-sm text-zinc-400 mb-6">
          {m.link_code_not_recognized_body()}
        </p>
        <a href="/link" class="inline-block bg-zinc-100 text-zinc-950 font-bold px-6 py-2 rounded-lg hover:bg-zinc-200 transition-colors">
          {m.link_enter_different_code()}
        </a>
      </div>
    )}

    {state === "confirm" && (
      <div id="confirm" data-code={code} class="py-2">
        <div class="rounded-lg border border-zinc-800 bg-zinc-950/60 p-4 mb-4">
          <label for="conn-name" class="block text-xs uppercase tracking-wider text-zinc-500 mb-1.5">{m.link_name_connection()}</label>
          <input
            id="conn-name"
            type="text"
            maxlength="120"
            value={clientName}
            autocomplete="off"
            class="w-full bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-2 text-zinc-100 font-semibold focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
          />
          <p class="text-sm text-zinc-400 mt-2" set:html={m.link_code_label({ code: `<span class="font-mono text-zinc-200">${escapeHtml(code)}</span>` })} />
        </div>
        <p class="text-sm text-zinc-300 mb-3">
          {m.link_approve_scope({ scope })}
        </p>
        <p class="text-sm text-amber-300/90 bg-amber-500/10 border border-amber-500/20 rounded-lg px-3 py-2 mb-5">
          {m.link_warning()}
        </p>
        <div class="flex gap-3">
          <button id="deny-btn" class="flex-1 border border-zinc-700 text-zinc-300 font-semibold px-4 py-2.5 rounded-lg hover:bg-zinc-800 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
            {m.link_deny()}
          </button>
          <button id="approve-btn" class="flex-1 bg-blue-600 text-white font-bold px-4 py-2.5 rounded-lg hover:bg-blue-500 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
            {m.link_approve()}
          </button>
        </div>
        <p id="confirm-error" class="hidden text-sm text-red-400 mt-3 text-center"></p>
      </div>
    )}

    {state === "confirm" && (
      <template id="result-tpl-approved">
        <div class="text-center py-2">
          <div class="w-14 h-14 bg-green-500/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-7 h-7 text-green-400">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
          </div>
          <h1 class="text-xl font-bold text-zinc-100 mb-2">{m.link_device_linked()}</h1>
          <p class="text-sm text-zinc-400">{m.link_device_linked_body()}</p>
        </div>
      </template>
    )}

    {state === "confirm" && (
      <template id="result-tpl-denied">
        <div class="text-center py-2">
          <div class="w-14 h-14 bg-zinc-700/30 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-7 h-7 text-zinc-400">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </div>
          <h1 class="text-xl font-bold text-zinc-100 mb-2">{m.link_request_denied()}</h1>
          <p class="text-sm text-zinc-400">{m.link_request_denied_body()}</p>
        </div>
      </template>
    )}
  </div>
  </div>
</Base>

<script>
  import { m } from '../paraglide/messages.js';

  const box = document.getElementById("confirm");
  if (box) {
    const token = (window as any).__AUTH_TOKEN__ ?? "";
    const code = box.dataset.code ?? "";
    const approveBtn = document.getElementById("approve-btn") as HTMLButtonElement | null;
    const denyBtn = document.getElementById("deny-btn") as HTMLButtonElement | null;
    const nameEl = document.getElementById("conn-name") as HTMLInputElement | null;
    const errEl = document.getElementById("confirm-error");

    const finish = (which: "approved" | "denied") => {
      const tpl = document.getElementById(`result-tpl-${which}`) as HTMLTemplateElement | null;
      if (tpl) box.replaceWith(tpl.content.cloneNode(true));
    };

    const send = async (action: "approve" | "deny") => {
      if (approveBtn) approveBtn.disabled = true;
      if (denyBtn) denyBtn.disabled = true;
      if (errEl) errEl.classList.add("hidden");
      const payload: Record<string, string> = { user_code: code, action };
      const chosenName = nameEl?.value.trim();
      if (action === "approve" && chosenName) payload.name = chosenName;
      try {
        const res = await fetch("/api/proxy/auth/device/approve", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            ...(token ? { Authorization: `Bearer ${token}` } : {}),
          },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error();
        finish(action === "approve" ? "approved" : "denied");
      } catch {
        if (approveBtn) approveBtn.disabled = false;
        if (denyBtn) denyBtn.disabled = false;
        if (errEl) {
          errEl.textContent = m.link_error();
          errEl.classList.remove("hidden");
        }
      }
    };

    approveBtn?.addEventListener("click", () => send("approve"));
    denyBtn?.addEventListener("click", () => send("deny"));
  }
</script>
