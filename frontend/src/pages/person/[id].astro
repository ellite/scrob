---
import Base from "../../layouts/Base.astro";
import MediaCard from "../../components/MediaCard.astro";
import ActionBar from "../../components/ActionBar.astro";
import CommentsSection from "../../components/CommentsSection.astro";
import FilterPanel from "../../components/FilterPanel.astro";
import PersonCreditGroups from "../../components/PersonCreditGroups.astro";
import { api, type MediaItem } from "../../lib/api";
import { departmentLabel, genreLabel, sortByLabel } from "../../lib/labels";
import { m } from "../../paraglide/messages.js";
export const prerender = false;

const { id } = Astro.params;
const { token, user } = Astro.locals;
const collectionParam = Astro.url.searchParams.get("collection");
const collection: "in" | "out" | "" = collectionParam === "in" || collectionParam === "out" ? collectionParam : "";
const genre = Astro.url.searchParams.getAll("genre");
const year = Astro.url.searchParams.getAll("year").map(Number).filter((y) => !Number.isNaN(y));
const minRating = Astro.url.searchParams.get("min_rating") ?? "";
const creditJob = Astro.url.searchParams.get("credit_job") ?? "";
const person = await api.media.getPerson(Number(id), 1, token, { collection, genre, year, minRating, grouped: true, creditJob });

const creditGroups = person.credit_groups || [];
const availableJobs = person.available_jobs || [];

const MOVIE_GENRES = [
  "Action", "Adventure", "Animation", "Comedy", "Crime", "Documentary",
  "Drama", "Family", "Fantasy", "History", "Horror", "Music", "Mystery",
  "Romance", "Science Fiction", "Thriller", "War", "Western",
];
const TV_GENRES = [
  "Action & Adventure", "Animation", "Comedy", "Crime", "Documentary",
  "Drama", "Family", "Kids", "Mystery", "News", "Reality",
  "Sci-Fi & Fantasy", "Soap", "Talk", "War & Politics", "Western",
];
const CREDIT_GENRES = Array.from(new Set([...MOVIE_GENRES, ...TV_GENRES])).sort();

const currentYear = new Date().getFullYear();
const years = Array.from({ length: currentYear - 1949 }, (_, i) => currentYear - i);
---

<Base title={person.name}>
  <div class="flex flex-col md:flex-row gap-12 max-w-5xl mx-auto py-8">
    <!-- Sidebar / Photo -->
    <div class="w-full md:w-72 shrink-0">
      <div class="sticky" style="top: calc(var(--nav-h, 0px) + 1rem)">
        {person.profile_path ? (
          <div class="relative w-full aspect-[2/3] rounded-2xl overflow-hidden shadow-2xl mb-6 group/photo">
            <button id="photo-zoom-btn" class="w-full h-full block cursor-zoom-in" aria-label={m.person_enlarge_photo({ name: person.name })}>
              <img
                src={person.profile_path}
                alt={person.name}
                class="w-full h-full object-cover transition-transform duration-300 group-hover/photo:scale-105"
                loading="eager"
                decoding="async"
              />
              <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover/photo:opacity-100 transition-opacity duration-200 bg-black/30">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-8 h-8 text-white drop-shadow-lg">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607ZM10.5 7.5v6m3-3h-6" />
                </svg>
              </div>
            </button>
          </div>
        ) : (
          <div class="w-full aspect-[2/3] bg-zinc-900 rounded-2xl flex items-center justify-center text-zinc-600 mb-6 border border-zinc-800">
            <svg xmlns="http://www.w3.org/2000/svg" width="35%" height="35%" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
        )}

        <div class="space-y-6 px-2">
          <div>
            <h3 class="text-zinc-500 text-xs font-bold uppercase tracking-wider mb-1">{m.person_personal_info()}</h3>
            <div class="space-y-4">
              {person.known_for_department && (
                <div>
                  <p class="text-zinc-100 text-sm font-semibold">{m.person_known_for()}</p>
                  <p class="text-zinc-400 text-sm">{person.known_for_department}</p>
                </div>
              )}
              {person.birthday && (
                <div>
                  <p class="text-zinc-100 text-sm font-semibold">{m.person_birthday()}</p>
                  <p class="text-zinc-400 text-sm">{person.birthday}</p>
                </div>
              )}
              {person.place_of_birth && (
                <div>
                  <p class="text-zinc-100 text-sm font-semibold">{m.person_place_of_birth()}</p>
                  <p class="text-zinc-400 text-sm">{person.place_of_birth}</p>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="flex-1 min-w-0">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
        <h1 class="page-title">{person.name}</h1>
        {user && (
          <ActionBar
            tmdbId={person.tmdb_id}
            mediaType="person"
            watched={false}
            inLists={person.in_lists ?? []}
            inLibrary={false}
            collectionPct={0}
            listOnly={true}
          />
        )}
      </div>

      {person.biography && (
        <div class="mb-12">
          <h2 class="section-headline mb-4">{m.person_biography()}</h2>
          <p class="text-zinc-400 leading-relaxed text-lg whitespace-pre-wrap">{person.biography}</p>
        </div>
      )}

      <div>
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
          <h2 class="section-headline">{m.person_known_for()}</h2>
          <FilterPanel
            id="person-credits-filters"
            basePath={`/person/${id}`}
            sections={[
              { key: "collection", label: m.filter_collection(), options: [{ value: "in", label: m.filter_in_my_collection() }, { value: "out", label: m.filter_not_in_my_collection() }], selected: collection ? [collection] : [], multi: false },
              { key: "genre", label: m.filter_genre(), options: sortByLabel(CREDIT_GENRES.map((g) => ({ value: g, label: genreLabel(g) }))), selected: genre },
              { key: "year", label: m.filter_year(), options: years.map((y) => ({ value: String(y), label: String(y) })), selected: year.map(String) },
              ...(availableJobs.length > 1
                ? [{ key: "credit_job", label: m.person_filter_job(), options: availableJobs.map((j) => ({ value: j, label: departmentLabel(j) })), selected: creditJob ? [creditJob] : [], multi: false }]
                : []),
              {
                key: "min_rating",
                label: m.filter_rating(),
                options: [
                  ...[9, 8, 7, 6, 5].map((r) => ({ value: String(r), label: m.filter_rating_min_stars({ rating: r }) })),
                  { value: "lt5", label: m.filter_rating_less_than_5() },
                ],
                selected: minRating ? [minRating] : [],
                multi: false,
              },
            ]}
          />
        </div>
        {creditGroups.length === 0 ? (
          (collection || genre.length > 0 || year.length > 0 || minRating || creditJob) && (
            <p class="text-zinc-500 text-sm">{m.person_no_matching_credits()}</p>
          )
        ) : (
          <PersonCreditGroups groups={creditGroups} personId={person.tmdb_id} pageSize={person.page_size} />
        )}
      </div>

      <CommentsSection
        mediaType="person"
        tmdbId={person.tmdb_id}
      />
    </div>
  </div>
</Base>

{person.profile_path && (
  <div id="photo-modal" class="fixed inset-0 z-[999] flex items-center justify-center hidden" role="dialog" aria-modal="true">
    <div id="photo-modal-backdrop" class="absolute inset-0 bg-black/90 backdrop-blur-sm cursor-pointer"></div>
    <img
      src={person.profile_path}
      alt={person.name}
      class="relative max-h-[90vh] max-w-[85vw] md:max-w-[50vw] object-contain rounded-2xl shadow-2xl ring-1 ring-white/10"
    />
    <button
      id="photo-modal-close"
      class="absolute top-4 right-4 p-2 rounded-full bg-black/60 hover:bg-black/80 text-white/70 hover:text-white transition-all duration-200 cursor-pointer"
      aria-label={m.common_close()}
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
)}

<script>
  const zoomBtn = document.getElementById('photo-zoom-btn');
  const modal = document.getElementById('photo-modal');
  const backdrop = document.getElementById('photo-modal-backdrop');
  const closeBtn = document.getElementById('photo-modal-close');

  if (zoomBtn && modal) {
    function openModal() {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
    function closeModal() {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }

    zoomBtn.addEventListener('click', openModal);
    backdrop?.addEventListener('click', closeModal);
    closeBtn?.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
  }
</script>
