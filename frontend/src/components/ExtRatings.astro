---
// Lokal patch (Popcornmeter). Laddas en gång i Base.astro.
---

<script>
  // Lokal patch: byt ★ TMDB mot 🍿 Popcornmeter på alla affischkort (.ext-rate) när de syns.
  const cache = new Map<string, Promise<number | null>>();
  let active = 0;
  const waiting: Array<() => void> = [];
  const slot = () => (active < 4 ? (active++, Promise.resolve()) : new Promise<void>((r) => waiting.push(() => { active++; r(); })));
  const release = () => { active--; waiting.shift()?.(); };

  function popcorn(kind: string, id: string): Promise<number | null> {
    const key = `${kind}/${id}`;
    if (!cache.has(key)) {
      cache.set(key, slot().then(() =>
        fetch(`/api/proxy/ext-ratings/${key}`, { credentials: "same-origin" })
          .then((r) => (r.ok ? r.json() : null))
          .then((d) => (d && typeof d.popcorn === "number" ? d.popcorn : null))
          .catch(() => null)
          .finally(release)));
    }
    return cache.get(key)!;
  }

  function color(p: number) {
    return p >= 90 ? "text-[#a335ee]" : p >= 75 ? "text-green-400" : p >= 60 ? "text-yellow-400" : "text-red-400";
  }

  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      const badge = e.target as HTMLElement;
      io.unobserve(badge);
      const card = badge.closest<HTMLElement>("[data-card]");
      const t = card?.dataset.mediaType;
      // Serier, säsonger och avsnitt visar seriens betyg (RT har inget per avsnitt).
      const kind = badge.dataset.extKind || (t === "movie" ? "movie" : t === "series" || t === "episode" ? "show" : null);
      const id = badge.dataset.extId || (kind === "show" ? card?.dataset.showTmdbId || (t === "series" ? card?.dataset.tmdbId : "") : card?.dataset.tmdbId);
      if (!id || !kind) continue;
      popcorn(kind, id).then((p) => {
        if (p == null) return;
        badge.classList.remove("text-yellow-400");
        badge.classList.add(color(p));
        badge.title = "Rotten Tomatoes Popcornmeter";
        badge.innerHTML = `<span class="text-xs leading-none">🍿</span> ${p}%${p >= 90 ? " 🔥" : ""}`;
      });
    }
  }, { rootMargin: "300px" });

  function scan(root: ParentNode = document) {
    root.querySelectorAll<HTMLElement>(".ext-rate:not([data-ext-seen])").forEach((b) => {
      b.dataset.extSeen = "1";
      io.observe(b);
    });
  }

  scan();
  document.addEventListener("astro:page-load", () => scan());
  new MutationObserver(() => scan()).observe(document.body, { childList: true, subtree: true });
</script>
