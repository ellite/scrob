---
import Base from "../layouts/Base.astro";
import { api } from "../lib/api";
import { isSecureRequest } from "../lib/secureCookie";

// Provider redirects the browser here with ?code=&state=. We check state,
// then post the code + PKCE verifier + nonce back to /auth/oidc/exchange.

let error = "";

const urlError = Astro.url.searchParams.get("error");
const errorDescription = Astro.url.searchParams.get("error_description");
if (urlError) {
  error = errorDescription || urlError;
}

const clearOidcCookies = () => {
  Astro.cookies.delete("oidc_state", { path: "/" });
  Astro.cookies.delete("oidc_next", { path: "/" });
  Astro.cookies.delete("oidc_code_verifier", { path: "/" });
  Astro.cookies.delete("oidc_nonce", { path: "/" });
  Astro.cookies.delete("oidc_remember", { path: "/" });
};

if (!error) {
  const code = Astro.url.searchParams.get("code") ?? "";
  const state = Astro.url.searchParams.get("state") ?? "";
  const storedState = Astro.cookies.get("oidc_state")?.value ?? "";
  const codeVerifier = Astro.cookies.get("oidc_code_verifier")?.value;
  const nonce = Astro.cookies.get("oidc_nonce")?.value;
  const storedNext = Astro.cookies.get("oidc_next")?.value ?? "/";
  const remember = Astro.cookies.get("oidc_remember")?.value === "1";

  if (!code) {
    error = "No authorization code returned by provider.";
    clearOidcCookies();
  } else if (!storedState || storedState !== state) {
    error = "Invalid state parameter. Please try logging in again.";
    clearOidcCookies();
  } else {
    clearOidcCookies();
    try {
      const { access_token, expires_in } = await api.auth.oidcExchange({ code, code_verifier: codeVerifier, nonce, remember });
      Astro.cookies.set("token", access_token, {
        path: "/",
        httpOnly: true,
        secure: isSecureRequest(Astro.url, Astro.request),
        sameSite: "lax",
        maxAge: expires_in ?? 60 * 60 * 24 * 7,
      });
      return Astro.redirect(storedNext);
    } catch (e: unknown) {
      error = e instanceof Error ? e.message : "SSO login failed";
    }
  }
}
---

<Base title="Login">
  <div class="max-w-md mx-auto mt-20 p-8 bg-zinc-900 rounded-xl border border-zinc-800 shadow-2xl">
    <h1 class="text-3xl font-bold mb-6 text-zinc-100">Login</h1>
    <div class="bg-red-500/10 border border-red-500 text-red-500 p-3 rounded-lg mb-6">
      {error}
    </div>
    <a href="/login" class="text-sm text-zinc-400 hover:text-zinc-100 transition-colors">Back to login</a>
  </div>
</Base>
