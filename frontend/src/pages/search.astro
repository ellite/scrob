---
import Base from "../layouts/Base.astro";
import MediaCard from "../components/MediaCard.astro";
import Pagination from "../components/Pagination.astro";
import { api, type MediaItem, type UserSearchResult } from "../lib/api";
import { escapeHtml } from "../lib/format";
import { m } from "../paraglide/messages.js";

const { token, user: currentUser } = Astro.locals;
Astro.response.headers.set("Cache-Control", "no-store");
const q = Astro.url.searchParams.get("q") || "";
const type = Astro.url.searchParams.get("type") || undefined;
const page = parseInt(Astro.url.searchParams.get("page") || "1");
const year = Astro.url.searchParams.get("year") ? Number(Astro.url.searchParams.get("year")) : undefined;
const inLibrary = Astro.url.searchParams.get("in_library") === "true";

const isUserSearch = type === "user";
const isStudioSearch = type === "network" || type === "studio";
const showYearFilter = (type === "movie" || type === "series") && !inLibrary;

let hasTmdbKey = false;
let hasTvdbKey = false;
if (token) {
  const settings = await api.auth.getSettings(token);
  hasTmdbKey = !!settings?.has_effective_tmdb_key;
  hasTvdbKey = !!settings?.has_effective_tvdb_key;
} else {
  // Anonymous visitor - only reachable at all when the admin enabled
  // logged-out navigation, which already implies a global TMDB key.
  const status = await api.profile.publicAccessStatus().catch(() => ({ enable_logged_out_navigation: false, has_global_tvdb_key: false }));
  hasTmdbKey = status.enable_logged_out_navigation;
  hasTvdbKey = status.has_global_tvdb_key;
}

// TVDB search (core.tvdb.search_series) only covers series, and is a
// separate, deliberately-not-merged source (see the "Try TheTVDB" fallback
// below) - only worth offering on the tabs where a TVDB-only show (e.g. a
// live-sports/reality series TMDB doesn't catalog) could plausibly belong.
const tvdbFallbackEligible = hasTvdbKey && (type === undefined || type === "series") && !inLibrary;

let results: MediaItem[] = [];
let userResults: UserSearchResult[] = [];
let totalPages = 1;
let totalResults = 0;
let error = "";

if (q.length >= 2) {
  try {
    if (isUserSearch) {
      // Searching for other users has no anonymous use case - keep it
      // strictly behind a real session regardless of logged-out navigation.
      if (!currentUser) {
        error = m.search_login_required();
      } else {
        const data = await api.profile.searchUsers(q, token);
        userResults = data.results;
        totalResults = userResults.length;
      }
    } else {
      const data = await api.media.search(q, type, page, showYearFilter ? year : undefined, token, inLibrary);
      results = data.results;
      totalPages = data.total_pages;
      totalResults = data.total_results;
    }
  } catch (e: unknown) {
    error = e instanceof Error ? e.message : String(e);
  }
}

const baseUrl = `/search?q=${encodeURIComponent(q)}${type ? `&type=${type}` : ""}${showYearFilter && year ? `&year=${year}` : ""}${inLibrary ? "&in_library=true" : ""}`;
const currentYear = new Date().getFullYear();
const years = Array.from({ length: currentYear - 1899 }, (_, i) => currentYear - i);

const tabs: [string | undefined, string][] = [
  [undefined,      m.search_tab_all()],
  ["movie",        m.common_movies()],
  ["series",       m.common_shows()],
  ["episode",      m.search_tab_episodes()],
  ["person",       m.search_tab_people()],
  ["collection",   m.search_tab_collections()],
  ["network",      m.search_tab_networks()],
  ["studio",       m.search_tab_studios()],
  // Searching for other users has no anonymous use case.
  ...(currentUser ? ([["user", m.search_tab_users()]] as [string, string][]) : []),
];

// Empty-state prompt: narrowed to whatever tab is active instead of always
// listing every searchable kind.
const searchPrompt = m.search_prompt({ type: type ?? "" });
---

<Base title={q ? m.search_page_title_query({ query: q }) : m.common_search()}>
  <div id="app-data" data-token={token} class="hidden" aria-hidden="true"></div>

  <div id="search-page-content">
  <div class="mb-8">
    <h1 class="page-title mb-2">
      {q ? m.search_results_for({ query: q }) : m.common_search()}
    </h1>
    <p class="text-zinc-500">{m.search_results_count({ count: totalResults })}</p>
  </div>

  <!-- Tab bar -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
    <div class="flex flex-wrap gap-2">
      {tabs.map(([value, label]) => (
        <a
          href={`/search?q=${encodeURIComponent(q)}${value ? `&type=${value}` : ""}`}
          class={`px-4 py-1.5 rounded-full text-sm font-medium transition ${type === value ? 'bg-zinc-100 text-zinc-900' : 'bg-zinc-900 text-zinc-400 hover:bg-zinc-800 hover:text-zinc-100'}`}
        >
          {label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      {currentUser && !isUserSearch && !isStudioSearch && type !== "person" && type !== "collection" && (
        <a
          href={`/search?q=${encodeURIComponent(q)}${type ? `&type=${type}` : ""}${!inLibrary ? "&in_library=true" : ""}`}
          class={`flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-medium border transition ${inLibrary ? 'bg-blue-600/20 border-blue-500/40 text-blue-400' : 'bg-zinc-900 border-zinc-800 text-zinc-400 hover:bg-zinc-800 hover:text-zinc-100'}`}
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
          </svg>
          {m.filter_in_my_collection()}
        </a>
      )}
      {!hasTmdbKey && q.length >= 2 && !isUserSearch && (
        <div class="text-xs text-zinc-500 bg-zinc-900/50 px-3 py-1.5 rounded-lg border border-zinc-800" set:html={m.search_local_only({ link: `<a href="/settings" class="text-blue-500 hover:underline">${escapeHtml(m.search_add_tmdb_key())}</a>` })} />
      )}
    </div>
  </div>

  <!-- Year filter (media only) -->
  {showYearFilter && (
    <div class="flex items-center gap-3 mb-6">
      <select id="filter-year" data-q={q} data-type={type ?? ""} class="bg-zinc-900 border border-zinc-700 text-zinc-300 text-sm rounded-lg px-3 py-2 focus:outline-none focus:border-blue-500">
        <option value="">{m.search_all_years()}</option>
        {years.map(y => (
          <option value={y} selected={year === y}>{y}</option>
        ))}
      </select>
      {year && (
        <a href={`/search?q=${encodeURIComponent(q)}&type=${type}`} class="text-sm text-zinc-500 hover:text-zinc-300 transition">{m.common_clear()}</a>
      )}
    </div>
  )}

  {error && (
    <div class="bg-red-500/10 border border-red-500 text-red-500 p-4 rounded-lg mb-8">{error}</div>
  )}

  {!q && (
    <div class="text-center py-20">
      <p class="text-zinc-500">{searchPrompt}</p>
    </div>
  )}

  <!-- User results -->
  {isUserSearch && q && userResults.length === 0 && !error && (
    <div class="text-center py-20">
      <p class="text-zinc-500">{m.search_no_users({ query: q })}</p>
    </div>
  )}

  {isUserSearch && userResults.length > 0 && (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {userResults.map((user) => (
        <div class="bg-zinc-900/60 border border-zinc-800 rounded-2xl p-5 flex flex-col gap-4 hover:border-zinc-600 transition-all">
          <!-- Top row: avatar + name + follow -->
          <div class="flex items-center gap-4">
            <a href={`/profile/${user.id}`} class="shrink-0">
              <div class="w-14 h-14 rounded-xl overflow-hidden bg-zinc-800 border border-zinc-700 flex items-center justify-center">
                {user.avatar_url ? (
                  <img src={`/api/proxy${user.avatar_url}`} alt={user.display_name} class="w-full h-full object-cover" loading="lazy" />
                ) : (
                  <span class="text-xl font-black text-zinc-400">{user.display_name[0].toUpperCase()}</span>
                )}
              </div>
            </a>

            <div class="flex-1 min-w-0">
              <a href={`/profile/${user.id}`} class="block">
                <p class="font-bold text-zinc-100 truncate leading-tight">{user.display_name}</p>
                <p class="text-xs text-zinc-500 truncate">@{user.username}{user.country ? ` · ${user.country.toUpperCase()}` : ""}</p>
              </a>
            </div>

            {!user.is_self && currentUser && (
              <button
                class={`follow-btn cursor-pointer shrink-0 px-3 py-1.5 rounded-full text-xs font-bold border transition-all ${user.is_following ? "bg-zinc-800 hover:bg-red-900/40 text-zinc-300 hover:text-red-300 border-zinc-700 hover:border-red-500/40" : "bg-blue-600/80 hover:bg-blue-500 text-white border-blue-500/40"}`}
                data-user-id={user.id}
                data-following={user.is_following ? "true" : "false"}
              >
                {user.is_following ? m.follow_following() : m.follow_follow()}
              </button>
            )}
          </div>

          <!-- Stats row -->
          <div class="grid grid-cols-4 gap-2 pt-1 border-t border-zinc-800">
            <div class="text-center">
              <p class="text-base font-black text-zinc-100 leading-none">{user.movies_watched}</p>
              <p class="text-[10px] text-zinc-400 font-bold uppercase tracking-wide mt-1">{m.stat_movies()}</p>
            </div>
            <div class="text-center">
              <p class="text-base font-black text-zinc-100 leading-none">{user.shows_watched}</p>
              <p class="text-[10px] text-zinc-400 font-bold uppercase tracking-wide mt-1">{m.stat_shows()}</p>
            </div>
            <div class="text-center">
              <p class="text-base font-black text-zinc-100 leading-none">{user.total_rated}</p>
              <p class="text-[10px] text-zinc-400 font-bold uppercase tracking-wide mt-1">{m.stat_rated()}</p>
            </div>
            <div class="text-center">
              <p class="text-base font-black text-zinc-100 leading-none">{user.follower_count}</p>
              <p class="text-[10px] text-zinc-400 font-bold uppercase tracking-wide mt-1">{m.stat_followers()}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  )}

  <!-- Media results -->
  {!isUserSearch && q && results.length === 0 && !error && (
    <div class="text-center py-20">
      <p class="text-zinc-500">{m.search_no_results({ query: q })}</p>
    </div>
  )}

  {!isUserSearch && isStudioSearch && results.length > 0 && (
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
      {results.map((item) => (
        <a
          href={`/${item.type === "network" ? "network" : "studio"}/${item.tmdb_id}`}
          class="group flex flex-col items-center justify-center gap-3 p-5 h-36 rounded-2xl bg-zinc-900 border border-zinc-800 hover:border-blue-500/50 hover:-translate-y-1 transition-all text-center"
        >
          {item.logo_path ? (
            <>
              <div class="logo-swatch backdrop-blur-sm border border-gray-200/60 rounded-lg px-3 py-2 flex items-center justify-center">
                <img src={item.logo_path} alt={item.title} class="h-8 max-w-[120px] object-contain" loading="lazy" />
              </div>
              <span class="text-xs text-zinc-500 truncate max-w-full">
                {item.title}{item.origin_country ? ` · ${item.origin_country}` : ""}
              </span>
            </>
          ) : (
            <>
              <span class="text-base font-bold text-zinc-100 group-hover:text-blue-400 transition-colors">{item.title}</span>
              {item.origin_country && <span class="text-xs text-zinc-500">{item.origin_country}</span>}
            </>
          )}
        </a>
      ))}
    </div>
  )}

  {!isUserSearch && !isStudioSearch && (
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6">
      {results.map((item) => (
        <MediaCard item={item} />
      ))}
    </div>
  )}

  {!isUserSearch && totalPages > 1 && (
    <Pagination currentPage={page} totalPages={totalPages} baseUrl={baseUrl} />
  )}

  <!-- TVDB fallback: a deliberately separate, on-demand search - not merged
       with the TMDB results above (no cross-source dedup to get wrong) and
       not run automatically (no second API call on every keystroke). -->
  {tvdbFallbackEligible && q.length >= 2 && (
    <div class="mt-10 text-center">
      <button
        type="button"
        id="tvdb-fallback-btn"
        data-q={q}
        class="px-4 py-2 text-sm font-bold text-zinc-400 bg-zinc-900 border border-zinc-800 rounded-xl hover:border-zinc-600 hover:text-zinc-200 transition-all cursor-pointer"
      >
        {m.search_tvdb_fallback()}
      </button>
      <div id="tvdb-fallback-results" class="hidden mt-6 text-left"></div>
    </div>
  )}
  </div>
</Base>

<script>
  import { m } from '../paraglide/messages.js';

  function esc(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function setup() {
    const token = (document.getElementById('app-data') as HTMLElement | null)?.dataset.token ?? '';

    const tvdbBtn = document.getElementById('tvdb-fallback-btn') as HTMLButtonElement | null;
    const tvdbResults = document.getElementById('tvdb-fallback-results') as HTMLElement | null;
    if (tvdbBtn && tvdbResults) {
      const defaultLabel = tvdbBtn.textContent ?? '';
      tvdbBtn.addEventListener('click', async () => {
        const q = tvdbBtn.dataset.q ?? '';
        tvdbBtn.disabled = true;
        tvdbBtn.textContent = m.search_tvdb_searching();
        tvdbResults.classList.remove('hidden');
        tvdbResults.innerHTML = `<p class="text-sm text-zinc-500 text-center">${esc(m.common_searching())}</p>`;
        try {
          const res = await fetch(`/api/proxy/media/search-tvdb?q=${encodeURIComponent(q)}`, {
            headers: { 'Authorization': `Bearer ${token}` },
          });
          if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            tvdbResults.innerHTML = `<p class="text-sm text-red-400 text-center">${esc(err.detail ?? m.search_tvdb_failed())}</p>`;
            return;
          }
          const items: any[] = await res.json();
          if (!items.length) {
            tvdbResults.innerHTML = `<p class="text-sm text-zinc-500 text-center">${esc(m.search_tvdb_no_results())}</p>`;
            return;
          }
          tvdbBtn.classList.add('hidden');
          tvdbResults.innerHTML = `
            <p class="group-label mb-4">${esc(m.search_tvdb_results())}</p>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6">
              ${items.map((it) => `
                <a href="/show/tvdb/${it.tvdb_id}" class="group">
                  <div class="aspect-[2/3] rounded-xl overflow-hidden bg-zinc-900 border border-zinc-800 group-hover:border-blue-500/50 transition-colors">
                    ${it.image_url
                      ? `<img src="${esc(it.image_url)}" alt="" class="w-full h-full object-cover" loading="lazy" />`
                      : `<div class="w-full h-full flex items-center justify-center text-zinc-600"><svg xmlns="http://www.w3.org/2000/svg" width="35%" height="35%" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="15" x="2" y="7" rx="2"/><polyline points="17 2 12 7 7 2"/></svg></div>`}
                  </div>
                  <p class="mt-2 text-sm font-bold text-zinc-100 truncate group-hover:text-blue-400 transition-colors">${esc(it.title ?? '')}</p>
                  <p class="text-xs text-zinc-500">${esc(it.year ? String(it.year) : '')}</p>
                </a>
              `).join('')}
            </div>
            <p class="text-xs text-zinc-500 mt-6">${m.tvdb_attribution({ link: '<a href="https://thetvdb.com" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-zinc-200 underline underline-offset-2 transition-colors">TheTVDB</a>' })}</p>
          `;
        } catch {
          tvdbResults.innerHTML = `<p class="text-sm text-red-400 text-center">${esc(m.search_tvdb_failed())}</p>`;
        } finally {
          tvdbBtn.disabled = false;
          tvdbBtn.textContent = defaultLabel;
        }
      });
    }

    const yearSel = document.getElementById('filter-year') as HTMLSelectElement | null;
    if (yearSel) {
      yearSel.addEventListener('change', () => {
        const params = new URLSearchParams();
        const q = yearSel.dataset.q ?? '';
        const type = yearSel.dataset.type ?? '';
        if (q) params.set('q', q);
        if (type) params.set('type', type);
        if (yearSel.value) params.set('year', yearSel.value);
        window.location.href = `/search?${params.toString()}`;
      });
    }

    document.querySelectorAll<HTMLButtonElement>('.follow-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const userId = Number(btn.dataset.userId);
        const isFollowing = btn.dataset.following === 'true';
        btn.disabled = true;

        try {
          const res = await fetch(`/api/proxy/profile/${userId}/follow`, {
            method: isFollowing ? 'DELETE' : 'POST',
            headers: { 'Authorization': `Bearer ${token}` },
          });
          if (!res.ok) throw new Error();

          const nowFollowing = !isFollowing;
          btn.dataset.following = nowFollowing ? 'true' : 'false';
          btn.textContent = nowFollowing ? m.follow_following() : m.follow_follow();
          btn.className = btn.className.replace(
            nowFollowing
              ? 'bg-blue-600/80 hover:bg-blue-500 text-white border-blue-500/40'
              : 'bg-zinc-800 hover:bg-red-900/40 text-zinc-300 hover:text-red-300 border-zinc-700 hover:border-red-500/40',
            nowFollowing
              ? 'bg-zinc-800 hover:bg-red-900/40 text-zinc-300 hover:text-red-300 border-zinc-700 hover:border-red-500/40'
              : 'bg-blue-600/80 hover:bg-blue-500 text-white border-blue-500/40'
          );
        } catch {
          // silently ignore
        } finally {
          btn.disabled = false;
        }
      });
    });
  }

  // Live search: this page has no search input of its own - typing in the
  // global nav search box (Base.astro) normally submits a full-page GET to
  // /search. While already viewing this page, re-run the search in place
  // instead, keeping whatever type/year/in_library filters are already in
  // the URL. Bound once at load, not from setup() - these inputs live in
  // Base.astro and are never replaced by the content swap below, unlike
  // everything else setup() rebinds.
  function setupLiveSearch() {
    if (window.location.pathname !== '/search') return;

    const inputs = [
      document.getElementById('desktop-search-input'),
      document.getElementById('mobile-search-input'),
    ].filter((el): el is HTMLInputElement => el instanceof HTMLInputElement);
    let contentEl = document.getElementById('search-page-content');
    if (inputs.length === 0 || !contentEl) return;

    let debounceTimer: ReturnType<typeof setTimeout> | undefined;
    let controller: AbortController | undefined;

    // Swaps the "/" hint for a spinner on the desktop box, and shows one
    // inside the mobile box - the only cue a slow connection gets that
    // typing actually did something, since nothing else on the page moves
    // until the fetch below resolves.
    const desktopHint = document.getElementById('desktop-search-hint');
    const desktopSpinner = document.getElementById('desktop-search-spinner');
    const mobileSpinner = document.getElementById('mobile-search-spinner');
    function setLoading(loading: boolean) {
      desktopHint?.classList.toggle('hidden', loading);
      desktopSpinner?.classList.toggle('hidden', !loading);
      mobileSpinner?.classList.toggle('hidden', !loading);
    }

    async function runSearch(newQ: string) {
      const params = new URLSearchParams(window.location.search);
      if (newQ) params.set('q', newQ); else params.delete('q');
      params.delete('page'); // a new query starts back at page 1
      const url = `/search${params.toString() ? `?${params}` : ''}`;

      controller?.abort();
      controller = new AbortController();
      setLoading(true);
      let res: Response;
      try {
        res = await fetch(url, { signal: controller.signal });
      } catch (e) {
        // An aborted request was superseded by a newer one already showing
        // its own spinner - only a real failure should turn it off here.
        if ((e as Error).name !== 'AbortError') { console.error('Live search failed:', e); setLoading(false); }
        return;
      }
      if (!res.ok || !contentEl) { setLoading(false); return; }

      const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
      const freshContent = doc.getElementById('search-page-content');
      if (!freshContent) { setLoading(false); return; }

      contentEl.replaceWith(freshContent);
      contentEl = freshContent;
      // Parsed via DOMParser, so any <script> inside (e.g. Pagination's
      // page-jump form) never actually ran - recreate each so it does.
      contentEl.querySelectorAll('script').forEach((old) => {
        const fresh = document.createElement('script');
        fresh.textContent = old.textContent;
        old.replaceWith(fresh);
      });

      // replaceState, not push - a history entry per keystroke would make
      // "back" useless. The page title still needs the manual update since
      // this never actually navigates.
      window.history.replaceState(null, '', url);
      document.title = doc.title;
      setLoading(false);
      setup();
    }

    inputs.forEach((input) => {
      input.addEventListener('input', () => {
        const val = input.value;
        inputs.forEach((other) => { if (other !== input) other.value = val; });
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => runSearch(val), 350);
      });
      // Enter (or the mobile "Go" button) searches immediately instead of
      // waiting out the debounce, without falling through to a real submit.
      input.closest('form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        clearTimeout(debounceTimer);
        runSearch(input.value);
      });
    });
  }

  setup();
  setupLiveSearch();
  document.addEventListener('astro:after-swap', setup);
</script>

