---
import { api } from "../lib/api";
import { isSecureRequest } from "../lib/secureCookie";

// Builds the IdP auth URL on the backend, then stashes state/PKCE verifier/
// nonce as HttpOnly cookies for the callback to send back on /exchange.

let errorMsg = "";

// Only a same-site path is a safe redirect target - anything else (an
// absolute URL, or a protocol-relative "//evil.com") could send the
// successful login to an attacker-controlled site.
const rawNext = Astro.url.searchParams.get("next") || "";
const nextPath = rawNext.startsWith("/") && !rawNext.startsWith("//") ? rawNext : "/";

const remember = Astro.url.searchParams.get("remember") === "1";

try {
  const { auth_url, state, code_verifier, nonce } = await api.auth.oidcAuthorize();

  const cookieOpts = {
    path: "/",
    httpOnly: true,
    secure: isSecureRequest(Astro.url, Astro.request),
    sameSite: "lax" as const,
    maxAge: 600, // 10 minutes
  };
  Astro.cookies.set("oidc_state", state, cookieOpts);
  Astro.cookies.set("oidc_next", nextPath, cookieOpts);
  if (code_verifier) {
    Astro.cookies.set("oidc_code_verifier", code_verifier, cookieOpts);
  }
  if (nonce) {
    Astro.cookies.set("oidc_nonce", nonce, cookieOpts);
  }
  if (remember) {
    Astro.cookies.set("oidc_remember", "1", cookieOpts);
  }

  return Astro.redirect(auth_url);
} catch (e: unknown) {
  errorMsg = e instanceof Error ? e.message : "Failed to initiate SSO login";
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SSO Error</title>
  </head>
  <body>
    <p>{errorMsg}</p>
    <a href="/login">Back to login</a>
  </body>
</html>
