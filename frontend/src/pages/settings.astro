---
import Base from "../layouts/Base.astro";
import { api } from "../lib/api";
import type { TotpBackupCode } from "../lib/api";

const { token } = Astro.locals;
const [settings, me] = await Promise.all([
  api.auth.getSettings(token!),
  api.auth.me(token!),
]);
const hasTmdbKey = settings.has_effective_tmdb_key;
let backupCodes: TotpBackupCode[] = [];
if (me.totp_enabled) {
  try {
    const res = await api.auth.totp2faBackupCodes(token!);
    backupCodes = res.codes;
  } catch {
    // non-fatal — codes panel will just be empty
  }
}
---

<Base title="Settings">
  <div id="app-data" data-token={token} class="hidden" aria-hidden="true"></div>
  <div class="max-w-4xl mx-auto">
    <h1 class="page-title mb-8">Settings</h1>

    <div id="js-message" class="hidden fixed top-4 right-4 z-[200] max-w-sm p-4 rounded-lg shadow-2xl border"></div>

    <div class="space-y-12">
      <!-- General Settings -->
      <section>
        <div class="flex items-center justify-between mb-4 border-b border-zinc-800 pb-2">
          <h2 class="section-headline">General</h2>
        </div>
        <form id="settings-form" class="space-y-6">
          <div class="space-y-6 max-w-xl">
          <!-- TMDB Read Access Token -->
          <div class="space-y-2">
            <label for="tmdb_api_key" class="block text-sm font-medium text-zinc-400">TMDB Read Access Token</label>
            <div class="flex gap-2">
              <div class="relative flex-1 group/field">
                <input
                  type="password"
                  name="tmdb_api_key"
                  id="tmdb_api_key"
                  value={settings.tmdb_api_key || ""}
                  class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
                />
                <button
                  type="button"
                  class="password-toggle absolute right-2 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 p-1 cursor-pointer transition-colors"
                  aria-label="Toggle password visibility"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.644C3.412 7.943 7.213 5 12 5c4.787 0 8.588 2.943 9.964 6.678.066.18.066.362 0 .544C20.588 16.057 16.787 19 12 19c-4.787 0-8.588-2.943-9.964-6.678z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-slash-icon hidden">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                  </svg>
                </button>
              </div>
              <button
                type="button"
                data-action="test_tmdb"
                title="Test TMDB token"
                class="js-action-btn px-3 py-2 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 rounded-lg transition-colors cursor-pointer disabled:opacity-50"
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 010 1.972l-11.54 6.347a1.125 1.125 0 01-1.667-.986V5.653z" />
                </svg>
              </button>
            </div>
            {settings.has_global_tmdb_key && !settings.tmdb_api_key ? (
              <p class="text-xs text-blue-400">A server-wide TMDB token is configured by your admin. You can leave this blank to use it, or enter your own token to override it.</p>
            ) : settings.has_global_tmdb_key && settings.tmdb_api_key ? (
              <p class="text-xs text-blue-400">A server-wide TMDB token is configured, but you are using your own token. Clear this field to fall back to the server token.</p>
            ) : (
              <p class="text-xs text-zinc-500">Paste the API Read Access Token (v4) from TMDB Settings → API. Required for metadata and posters; validated before saving.</p>
            )}
          </div>

          <!-- TVDB API Key -->
          <div class="space-y-2">
            <label for="tvdb_api_key" class="block text-sm font-medium text-zinc-400">TVDB API Key</label>
            <div class="flex gap-2">
              <div class="relative flex-1 group/field">
                <input
                  type="password"
                  name="tvdb_api_key"
                  id="tvdb_api_key"
                  value={settings.tvdb_api_key || ""}
                  placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                  class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
                />
                <button
                  type="button"
                  class="password-toggle absolute right-2 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 p-1 cursor-pointer transition-colors"
                  aria-label="Toggle password visibility"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.644C3.412 7.943 7.213 5 12 5c4.787 0 8.588 2.943 9.964 6.678.066.18.066.362 0 .544C20.588 16.057 16.787 19 12 19c-4.787 0-8.588-2.943-9.964-6.678z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-slash-icon hidden">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                  </svg>
                </button>
              </div>
              <button
                type="button"
                data-action="test_tvdb"
                title="Test TVDB key"
                class="js-action-btn px-3 py-2 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 rounded-lg transition-colors cursor-pointer disabled:opacity-50"
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 010 1.972l-11.54 6.347a1.125 1.125 0 01-1.667-.986V5.653z" />
                </svg>
              </button>
            </div>
            {settings.has_global_tvdb_key && !settings.tvdb_api_key ? (
              <p class="text-xs text-blue-400">A server-wide TVDB key is configured by your admin.</p>
            ) : settings.has_global_tvdb_key && settings.tvdb_api_key ? (
              <p class="text-xs text-blue-400">A server-wide TVDB key is configured, but you are using your own key.</p>
            ) : (
              <p class="text-xs text-zinc-500">Required for TVDB-sourced shows (shows not on TMDB). Get your key at thetvdb.com.</p>
            )}
          </div>
          </div>

          <div class="pt-6">
            <button
              id="save-settings-btn"
              type="submit"
              class="w-full sm:w-auto bg-zinc-100 text-zinc-950 font-bold px-8 py-3 rounded-xl hover:bg-zinc-200 transition-colors cursor-pointer disabled:opacity-50"
            >
              Save Changes
            </button>
          </div>
        </form>
      </section>

      <!-- Appearance -->
      <section>
        <h2 class="section-headline mb-4 border-b border-zinc-800 pb-2">Appearance</h2>
        <div class="space-y-6">
          <div class="flex items-start justify-between gap-6 p-4 bg-zinc-900/60 rounded-xl border border-zinc-800">
            <div>
              <p class="text-sm font-semibold text-zinc-100 mb-1">Blur explicit content</p>
              <p class="text-xs text-zinc-400">Blur posters flagged as adult content by TMDB. Click a blurred poster to reveal it.</p>
            </div>
            <label class="relative inline-flex items-center shrink-0 cursor-pointer mt-0.5">
              <input
                type="checkbox"
                name="blur_explicit"
                id="blur-explicit-toggle"
                class="sr-only peer"
                checked={settings.blur_explicit !== false}
              />
              <div class="w-11 h-6 bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-500"></div>
            </label>
          </div>
          <div class="flex items-start justify-between gap-6 p-4 bg-zinc-900/60 rounded-xl border border-zinc-800">
            <div>
              <p class="text-sm font-semibold text-zinc-100 mb-1">24-hour time format</p>
              <p class="text-xs text-zinc-400">Display watch times in 24-hour format (e.g. 23:31) instead of 12-hour (e.g. 11:31 PM).</p>
            </div>
            <label class="relative inline-flex items-center shrink-0 cursor-pointer mt-0.5">
              <input
                type="checkbox"
                name="time_format_24h"
                id="time-format-24h-toggle"
                class="sr-only peer"
                checked={settings.time_format_24h !== false}
              />
              <div class="w-11 h-6 bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-500"></div>
            </label>
          </div>
          <div>
            <p class="text-sm text-zinc-400">Accent color</p>
            <div class="flex flex-wrap gap-3 mt-3" id="accent-swatches">
              {[
                { id: 'blue',   label: 'Blue',   color: '#3b82f6' },
                { id: 'purple', label: 'Purple', color: '#a855f7' },
                { id: 'pink',   label: 'Pink',   color: '#ec4899' },
                { id: 'red',    label: 'Red',    color: '#ef4444' },
                { id: 'green',  label: 'Green',  color: '#22c55e' },
                { id: 'yellow', label: 'Yellow', color: '#eab308' },
                { id: 'orange', label: 'Orange', color: '#f97316' },
              ].map(({ id, label, color }) => (
                <button
                  type="button"
                  data-accent-id={id}
                  class="accent-swatch flex items-center gap-2.5 px-5 py-3 rounded-xl border border-zinc-800 bg-zinc-900 hover:border-zinc-600 transition-all cursor-pointer text-sm text-zinc-400 hover:text-zinc-100"
                >
                  <span class="w-5 h-5 rounded-full shrink-0" style={`background-color: ${color}`}></span>
                  {label}
                </button>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Experimental Features -->
      <section>
        <h2 class="section-headline mb-4 border-b border-zinc-800 pb-2">Experimental Features</h2>
        <div class="space-y-6">
          <div class="flex items-start justify-between gap-6 p-4 bg-zinc-900/60 rounded-xl border border-zinc-800">
            <div>
              <p class="text-sm font-semibold text-zinc-100 mb-1">HLS player <span class="ml-1.5 text-[10px] font-bold uppercase tracking-wide text-amber-400 bg-amber-400/10 border border-amber-400/30 rounded px-1.5 py-0.5">Experimental</span></p>
              <p class="text-xs text-zinc-400">Use the HLS-based player for Plex and Jellyfin/Emby sources. Enables transcoding if your browser doesn't natively support the file's codecs. Disable this if playback is broken.</p>
            </div>
            <label class="relative inline-flex items-center shrink-0 cursor-pointer mt-0.5">
              <input
                type="checkbox"
                name="use_hls_player"
                id="use-hls-player-toggle"
                class="sr-only peer"
                checked={settings.use_hls_player === true}
              />
              <div class="w-11 h-6 bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-500"></div>
            </label>
          </div>
        </div>
      </section>

      <!-- Maintenance -->
      <section>
        <h2 class="section-headline mb-4 border-b border-zinc-800 pb-2">Maintenance</h2>
        <div class="space-y-3 max-w-xl">
          <div class="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden">
            <div class="flex items-center justify-between px-5 py-4">
              <div>
                <p class="text-sm font-medium text-zinc-200">Heal missing metadata</p>
                <p class="text-xs text-zinc-500 mt-0.5">Re-fetches posters and dates for collection items that are missing them due to TMDB errors during sync.</p>
              </div>
              <button
                id="heal-btn"
                type="button"
                disabled={!hasTmdbKey}
                title={!hasTmdbKey ? "TMDB Read Access Token is required" : ""}
                class="ml-4 shrink-0 text-sm px-4 py-2 rounded-lg transition-colors cursor-pointer disabled:opacity-50 bg-blue-600/20 hover:bg-blue-600/30 text-blue-400 border border-blue-500/30"
              >
                Heal
              </button>
            </div>
            <div id="heal-progress" class="hidden border-t border-zinc-800 px-5 py-3">
              <div class="flex justify-between items-center mb-1.5">
                <span id="heal-job-label" class="text-xs font-semibold uppercase tracking-wider text-zinc-500">Working…</span>
                <div class="flex items-center gap-3">
                  <span id="heal-job-pct" class="text-xs font-bold text-zinc-400"></span>
                  <button type="button" id="heal-job-cancel" class="hidden cursor-pointer text-xs font-semibold text-zinc-400 hover:text-red-400 border border-zinc-700 hover:border-red-500/50 px-2 py-0.5 rounded-md transition-colors">Cancel</button>
                </div>
              </div>
              <div class="w-full bg-zinc-800 rounded-full h-1.5 overflow-hidden">
                <div id="heal-job-bar" class="h-1.5 rounded-full transition-all duration-500 bg-blue-600 animate-pulse" style="width: 100%"></div>
              </div>
              <div class="flex justify-between text-xs text-zinc-500 mt-1">
                <span id="heal-job-items"></span>
              </div>
            </div>
          </div>

          <div class="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden">
            <div class="flex items-center justify-between px-5 py-4">
              <div>
                <p class="text-sm font-medium text-zinc-200">Heal unmatched show titles</p>
                <p class="text-xs text-zinc-500 mt-0.5">Fixes episodes stuck as "unmatched" where the show title was lost — usually affects items synced before the title-preservation fix. Restores the title from sync history so the Match button works.</p>
              </div>
              <button
                id="heal-stub-titles-btn"
                type="button"
                class="ml-4 shrink-0 text-sm px-4 py-2 rounded-lg transition-colors cursor-pointer bg-blue-600/20 hover:bg-blue-600/30 text-blue-400 border border-blue-500/30"
              >
                Heal
              </button>
            </div>
          </div>

          <div class="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden">
            <div class="flex items-center justify-between px-5 py-4">
              <div>
                <p class="text-sm font-medium text-zinc-200">Clear now playing</p>
                <p class="text-xs text-zinc-500 mt-0.5">Removes all active now playing sessions. Use this if a ghost session is stuck in the bar after a restart or network interruption.</p>
              </div>
              <button
                id="clear-sessions-btn"
                type="button"
                class="ml-4 shrink-0 text-sm px-4 py-2 rounded-lg transition-colors cursor-pointer bg-red-600/20 hover:bg-red-600/30 text-red-400 border border-red-500/30"
              >
                Clear
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- Security -->
      <section id="2fa-section">
        <h2 class="section-headline mb-4 border-b border-zinc-800 pb-2">Security</h2>
        <h3 class="text-base font-semibold text-zinc-300 mb-3">Two-Factor Authentication</h3>

        {!me.totp_enabled ? (
          <div class="space-y-4">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-zinc-900/40 border border-zinc-800 rounded-2xl p-6">
              <div>
                <h3 class="font-semibold text-zinc-100 mb-1">Authenticator App</h3>
                <p class="text-sm text-zinc-400">Protect your account with a time-based one-time password (TOTP) from any authenticator app.</p>
              </div>
              <button
                type="button"
                id="enable-2fa-btn"
                class="w-full sm:w-auto sm:shrink-0 px-6 py-3 bg-zinc-100 text-zinc-950 font-bold rounded-xl hover:bg-zinc-200 transition-colors cursor-pointer text-sm"
              >
                Enable 2FA
              </button>
            </div>

            <!-- Setup panel (hidden until "Enable 2FA" is clicked) -->
            <div id="2fa-setup-panel" class="hidden border border-zinc-700 rounded-2xl p-6 space-y-5 bg-zinc-900/30">
              <div class="text-sm text-zinc-400">
                Scan the QR code with your authenticator app (Google Authenticator, Authy, etc.), then enter the 6-digit code to confirm.
              </div>

              <div class="flex flex-col md:flex-row gap-6 items-start">
                <div class="shrink-0">
                  <canvas id="totp-qr-canvas" class="rounded-lg bg-white p-2" width="160" height="160"></canvas>
                </div>
                <div class="space-y-3 flex-1">
                  <div>
                    <p class="text-xs text-zinc-500 mb-1">Manual entry key</p>
                    <code id="totp-secret-display" class="block bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-zinc-300 font-mono text-sm tracking-widest break-all select-all"></code>
                  </div>
                  <div class="space-y-2">
                    <label for="totp-verify-code" class="block text-sm font-medium text-zinc-400">Verification Code</label>
                    <input
                      type="text"
                      id="totp-verify-code"
                      autocomplete="one-time-code"
                      inputmode="numeric"
                      maxlength="6"
                      placeholder="000000"
                      class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-zinc-100 font-mono tracking-widest focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
                    />
                  </div>
                  <div class="flex gap-3">
                    <button
                      type="button"
                      id="confirm-enable-2fa-btn"
                      class="px-5 py-2 bg-zinc-100 text-zinc-950 font-bold rounded-lg hover:bg-zinc-200 transition-colors cursor-pointer text-sm disabled:opacity-50"
                    >
                      Verify &amp; Enable
                    </button>
                    <button
                      type="button"
                      id="cancel-2fa-setup-btn"
                      class="px-5 py-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 rounded-lg text-sm transition-colors cursor-pointer"
                    >
                      Cancel
                    </button>
                  </div>
                  <p id="2fa-setup-error" class="hidden text-sm text-red-400"></p>
                </div>
              </div>
            </div>

            <!-- Backup codes shown after successful enable (hidden initially) -->
            <div id="2fa-new-codes-panel" class="hidden border border-green-500/30 bg-green-500/5 rounded-2xl p-6 space-y-4">
              <div class="flex items-center gap-2 text-green-400 font-semibold">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                2FA Enabled
              </div>
              <p class="text-sm text-zinc-400">Save these backup codes somewhere safe. Each can only be used once. They cannot be shown again — regenerate them in settings if needed.</p>
              <div id="2fa-new-codes-grid" class="grid grid-cols-2 gap-2"></div>
              <button
                type="button"
                id="2fa-new-codes-done-btn"
                class="px-5 py-2 bg-zinc-100 text-zinc-950 font-bold rounded-lg hover:bg-zinc-200 transition-colors cursor-pointer text-sm"
              >
                Done — reload page
              </button>
            </div>
          </div>
        ) : (
          <div class="space-y-4">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-zinc-900/40 border border-zinc-800 rounded-2xl p-6">
              <div class="flex items-center gap-3">
                <span class="w-2.5 h-2.5 rounded-full bg-green-500 shrink-0"></span>
                <div>
                  <h3 class="font-semibold text-zinc-100">2FA is enabled</h3>
                  <p class="text-sm text-zinc-400">Your account is protected with an authenticator app.</p>
                </div>
              </div>
              <button
                type="button"
                id="disable-2fa-btn"
                class="shrink-0 px-5 py-2 bg-red-600/10 hover:bg-red-600/20 text-red-400 border border-red-500/30 font-bold rounded-lg text-sm transition-colors cursor-pointer"
              >
                Disable 2FA
              </button>
            </div>

            <!-- Disable confirmation (hidden initially) -->
            <div id="2fa-disable-panel" class="hidden border border-zinc-700 rounded-2xl p-6 space-y-4 bg-zinc-900/30">
              <p class="text-sm text-zinc-400">Enter your authenticator code or a backup code to disable 2FA.</p>
              <div class="flex gap-3 items-end">
                <div class="space-y-2 flex-1">
                  <label for="totp-disable-code" class="block text-sm font-medium text-zinc-400">Code</label>
                  <input
                    type="text"
                    id="totp-disable-code"
                    autocomplete="one-time-code"
                    placeholder="000000 or XXXX-XXXX"
                    class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-zinc-100 font-mono tracking-widest focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
                  />
                </div>
                <button
                  type="button"
                  id="confirm-disable-2fa-btn"
