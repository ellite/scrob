---
import Base from "../layouts/Base.astro";
import ListCard from "../components/ListCard.astro";
import { api, type UserList, type PublicList } from "../lib/api";
import { m } from "../paraglide/messages.js";
export const prerender = false;

const { token, user } = Astro.locals;
Astro.response.headers.set("Cache-Control", "no-store");

// Remote imports only make sense for a logged-in owner (list
// creation is inherently an authenticated action), so no anonymous fallback
// branch is needed here unlike shows.astro/search.astro's public-browse
// pages. TVDB, IMDb, and MDBList items resolve through TMDB under the hood;
// their entry points may additionally require their own provider key.
let hasTmdbKey = false;
let hasTvdbKey = false;
let hasMdblistKey = false;
if (user && token) {
  const settings = await api.auth.getSettings(token);
  hasTmdbKey = !!settings?.has_effective_tmdb_key;
  hasTvdbKey = !!settings?.has_effective_tvdb_key;
  hasMdblistKey = !!(settings?.mdblist_connected || settings?.has_global_mdblist_key);
}

let lists: UserList[] = [];
let publicLists: PublicList[] = [];
let error = "";

try {
  if (token) {
    const [myData, pubData] = await Promise.all([
      api.lists.getAll(token),
      api.lists.getPublic(token),
    ]);
    lists = myData.lists;
    publicLists = pubData.lists.filter((l) => l.username !== user?.username);
  } else {
    // Anonymous visitor - no "My Lists" to show, and the public listing
    // becomes the whole page rather than a small "From the Community" teaser.
    const pubData = await api.lists.getPublic();
    publicLists = pubData.lists;
  }
} catch (e: unknown) {
  error = e instanceof Error ? e.message : String(e);
}
---

<Base title={m.nav_lists()}>
  <div>
    <h1 class="page-title mb-10">{m.nav_lists()}</h1>

    {user && (
      <div class="flex items-center justify-between mb-6">
        <h2 class="section-headline">{m.lists_my_lists()}</h2>
        <div class="relative">
          <button
            id="new-list-btn"
            class="flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-xl transition-all shadow-lg shadow-blue-600/20 active:scale-95 text-sm cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            {m.lists_new_list()}
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3 h-3 opacity-70">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
          </button>
          <div id="new-list-menu" class="hidden absolute top-full right-0 mt-2 w-56 z-50">
            <div class="bg-zinc-900 border border-zinc-800 rounded-xl shadow-2xl p-2 text-sm">
              <button
                type="button"
                id="open-create-modal-btn"
                class="w-full flex items-center gap-2.5 px-3 py-2 text-zinc-300 hover:text-zinc-100 hover:bg-zinc-800 active:opacity-70 rounded-lg transition cursor-pointer text-left"
              >
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 shrink-0">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                {m.lists_create_list()}
              </button>
              {hasTmdbKey && (
                <button
                  type="button"
                  class="open-import-modal-btn w-full flex items-center gap-2.5 px-3 py-2 text-zinc-300 hover:text-zinc-100 hover:bg-zinc-800 active:opacity-70 rounded-lg transition cursor-pointer text-left"
                  data-provider="tmdb"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 shrink-0">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                  </svg>
                  {m.lists_import_from({ provider: "TMDB" })}
                </button>
              )}
              {hasTvdbKey && (
                <button
                  type="button"
                  class="open-import-modal-btn w-full flex items-center gap-2.5 px-3 py-2 text-zinc-300 hover:text-zinc-100 hover:bg-zinc-800 active:opacity-70 rounded-lg transition cursor-pointer text-left"
                  data-provider="tvdb"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 shrink-0">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                  </svg>
                  {m.lists_import_from({ provider: "TVDB" })}
                </button>
              )}
              {hasTmdbKey && (
                <button
                  type="button"
                  class="open-import-modal-btn w-full flex items-center gap-2.5 px-3 py-2 text-zinc-300 hover:text-zinc-100 hover:bg-zinc-800 active:opacity-70 rounded-lg transition cursor-pointer text-left"
                  data-provider="imdb"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 shrink-0">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                  </svg>
                  {m.lists_import_from({ provider: "IMDb" })}
                </button>
              )}
              {hasTmdbKey && hasMdblistKey && (
                <button
                  type="button"
                  class="open-import-modal-btn w-full flex items-center gap-2.5 px-3 py-2 text-zinc-300 hover:text-zinc-100 hover:bg-zinc-800 active:opacity-70 rounded-lg transition cursor-pointer text-left"
                  data-provider="mdblist"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 shrink-0">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                  </svg>
                  {m.lists_import_from({ provider: "MDBList" })}
                </button>
              )}
            </div>
          </div>
        </div>
      </div>
    )}

    {error && (
      <div class="bg-red-500/10 border border-red-500/20 text-red-400 p-4 rounded-2xl mb-8 text-sm">
        {error}
      </div>
    )}

    <!-- Create List Modal -->
    {user && (
    <div id="create-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
      <div id="modal-backdrop" class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>
      <div class="relative bg-zinc-900 border border-zinc-800 rounded-3xl p-8 w-full max-w-md shadow-2xl">
        <h2 class="text-xl font-black text-zinc-100 mb-6">{m.lists_create_new()}</h2>
        <form id="create-form" class="space-y-4">
          <div>
            <label for="list-name" class="block text-xs font-bold text-zinc-400 uppercase tracking-widest mb-2">{m.lists_name()}</label>
            <input
              type="text"
              id="list-name"
              placeholder={m.lists_name_placeholder()}
              maxlength="255"
              required
              class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
            />
          </div>
          <div>
            <label for="list-desc" class="block text-xs font-bold text-zinc-400 uppercase tracking-widest mb-2" set:html={m.lists_description_label()} />
            <textarea
              id="list-desc"
              placeholder={m.lists_description_placeholder()}
              rows="2"
              class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all resize-none"
            ></textarea>
          </div>
          <div>
            <label class="block text-xs font-bold text-zinc-400 uppercase tracking-widest mb-3 text-center">{m.privacy_label()}</label>
            <div class="grid grid-cols-3 gap-2">
              <label class="relative flex flex-col items-center p-3 rounded-xl border border-zinc-800 bg-zinc-950 cursor-pointer transition-all hover:bg-zinc-900 group">
                <input type="radio" name="privacy_level" value="private" checked class="sr-only peer" />
                <div class="absolute inset-0 rounded-xl border-2 border-transparent peer-checked:border-blue-600 transition-all"></div>
                <span class="text-[10px] font-black uppercase tracking-widest text-zinc-500 peer-checked:text-blue-400 mb-1">{m.privacy_private_short()}</span>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-zinc-400 peer-checked:text-blue-500">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
                </svg>
              </label>
              <label class="relative flex flex-col items-center p-3 rounded-xl border border-zinc-800 bg-zinc-950 cursor-pointer transition-all hover:bg-zinc-900 group">
                <input type="radio" name="privacy_level" value="friends_only" class="sr-only peer" />
                <div class="absolute inset-0 rounded-xl border-2 border-transparent peer-checked:border-blue-600 transition-all"></div>
                <span class="text-[10px] font-black uppercase tracking-widest text-zinc-500 peer-checked:text-blue-400 mb-1">{m.privacy_friends_short()}</span>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-zinc-400 peer-checked:text-blue-500">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.998 5.998 0 0 0-12 0m12 0c0-1.723-.699-3.283-1.838-4.412m-1.148-1.148A5.988 5.988 0 0 1 12 12c-1.353 0-2.585.449-3.568 1.206m8.114-1.83c.915 0 1.656-.74 1.656-1.656V6.142c0-.915-.74-1.656-1.656-1.656H12M8.114 11.372A5.988 5.988 0 0 0 12 12c1.353 0 2.585-.449 3.568-1.206m-8.114 1.83a6.062 6.062 0 0 1-1.062-1.062m1.062 1.062c-1.139 1.129-1.838 2.689-1.838 4.412m3.114-10.43c0-.915.74-1.656 1.656-1.656h3.114c.915 0 1.656.74 1.656 1.656V6.142c0 .915-.74 1.656-1.656 1.656H12" />
                </svg>
              </label>
              <label class="relative flex flex-col items-center p-3 rounded-xl border border-zinc-800 bg-zinc-950 cursor-pointer transition-all hover:bg-zinc-900 group">
                <input type="radio" name="privacy_level" value="public" class="sr-only peer" />
                <div class="absolute inset-0 rounded-xl border-2 border-transparent peer-checked:border-blue-600 transition-all"></div>
                <span class="text-[10px] font-black uppercase tracking-widest text-zinc-500 peer-checked:text-blue-400 mb-1">{m.privacy_public_short()}</span>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-zinc-400 peer-checked:text-blue-500">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-.778.099-1.533.284-2.253" />
                </svg>
              </label>
            </div>
          </div>
          <div id="create-error" class="hidden text-xs text-red-400 bg-red-500/10 border border-red-500/20 rounded-lg px-3 py-2"></div>
          <div class="flex gap-3 pt-2">
            <button
              type="button"
              id="cancel-btn"
              class="flex-1 px-4 py-3 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 font-bold rounded-xl transition-all text-sm cursor-pointer"
            >
              {m.common_cancel()}
            </button>
            <button
              type="submit"
              id="create-submit-btn"
              class="flex-1 px-4 py-3 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-xl transition-all text-sm cursor-pointer disabled:opacity-50"
            >
              {m.lists_create_list()}
            </button>
          </div>
        </form>
      </div>
    </div>
    )}

    <!-- Remote list import modal - one shared modal, contents swapped by
         provider (see openImportModal below) rather than duplicating it. -->
    {user && (hasTmdbKey || hasTvdbKey) && (
    <div id="import-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
      <div id="import-modal-backdrop" class="absolute inset-0 bg-black/70 backdrop-blur-sm"></div>
      <div class="relative bg-zinc-900 border border-zinc-800 rounded-3xl p-8 w-full max-w-md shadow-2xl">
        <h2 id="import-modal-title" class="text-xl font-black text-zinc-100 mb-2">{m.lists_import_title()}</h2>
        <p id="import-modal-hint" class="text-sm text-zinc-500 mb-6"></p>
        <form id="import-form" class="space-y-4">
          <div>
            <label id="import-modal-label" for="list-id-input" class="block text-xs font-bold text-zinc-400 uppercase tracking-widest mb-2">{m.lists_import_label()}</label>
            <input
              type="text"
              id="list-id-input"
              required
              class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
            />
          </div>
          <div id="import-error" class="hidden text-xs text-red-400 bg-red-500/10 border border-red-500/20 rounded-lg px-3 py-2"></div>
          <div class="flex gap-3 pt-2">
            <button
              type="button"
              id="import-cancel-btn"
              class="flex-1 px-4 py-3 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 font-bold rounded-xl transition-all text-sm cursor-pointer"
            >
              {m.common_cancel()}
            </button>
            <button
              type="submit"
              id="import-submit-btn"
              class="flex-1 px-4 py-3 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-xl transition-all text-sm cursor-pointer disabled:opacity-50 inline-flex items-center justify-center gap-2"
            >
              <span id="import-submit-label" class="inline-flex items-center gap-2">{m.lists_import_submit()}</span>
            </button>
          </div>
        </form>
      </div>
    </div>
    )}

    <!-- Lists Grid -->
    {user && (lists.length === 0 && !error ? (
      <div class="text-center py-24 bg-zinc-900/20 border border-zinc-800/50 border-dashed rounded-3xl">
        <div class="text-5xl mb-4">📋</div>
        <h2 class="text-xl font-bold text-zinc-100 mb-2">{m.lists_empty()}</h2>
        <p class="text-zinc-500 mb-6">{m.lists_empty_hint()}</p>
        <div class="flex items-center justify-center gap-3">
          <button
            id="empty-new-list-btn"
            class="px-6 py-3 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-xl transition-all shadow-lg shadow-blue-600/20 active:scale-95 cursor-pointer"
          >
            {m.lists_create_a_list()}
          </button>
          {hasTmdbKey && (
            <button
              class="open-import-modal-btn px-6 py-3 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 font-bold rounded-xl transition-all active:scale-95 cursor-pointer"
              data-provider="tmdb"
            >
              {m.lists_import_from({ provider: "TMDB" })}
            </button>
          )}
          {hasTvdbKey && (
            <button
              class="open-import-modal-btn px-6 py-3 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 font-bold rounded-xl transition-all active:scale-95 cursor-pointer"
              data-provider="tvdb"
            >
              {m.lists_import_from({ provider: "TVDB" })}
            </button>
          )}
          {hasTmdbKey && (
            <button
              class="open-import-modal-btn px-6 py-3 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 font-bold rounded-xl transition-all active:scale-95 cursor-pointer"
              data-provider="imdb"
            >
              {m.lists_import_from({ provider: "IMDb" })}
            </button>
          )}
          {hasTmdbKey && hasMdblistKey && (
            <button
              class="open-import-modal-btn px-6 py-3 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 font-bold rounded-xl transition-all active:scale-95 cursor-pointer"
              data-provider="mdblist"
            >
              {m.lists_import_from({ provider: "MDBList" })}
            </button>
          )}
        </div>
      </div>
    ) : (
      <div id="lists-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {lists.map((list) => (
          <div class="group relative" data-list-id={list.id}>
            <ListCard
              id={list.id}
              name={list.name}
              description={list.description}
              privacy_level={list.privacy_level}
              item_count={list.item_count}
              preview_posters={list.preview_posters}
            />
            <button
              class="delete-list-btn absolute top-3 right-3 p-1.5 rounded-lg text-zinc-500 hover:text-red-400 hover:bg-red-500/10 transition-colors cursor-pointer z-10"
              data-list-id={list.id}
              data-list-name={list.name}
              aria-label={m.lists_delete()}
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
              </svg>
            </button>
          </div>
        ))}
      </div>
    ))}

    {publicLists.length > 0 && (
      <div class={user ? "mt-16 pt-10 border-t border-zinc-800/50" : ""}>
        <h2 class="section-headline mb-6">{user ? m.lists_from_community() : m.lists_public_lists()}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {publicLists.map((list) => (
            <ListCard
              id={list.id}
              name={list.name}
              description={list.description}
              privacy_level={list.privacy_level}
              item_count={list.item_count}
              preview_posters={list.preview_posters}
              username={list.username}
            />
          ))}
        </div>
      </div>
    )}

    {!user && publicLists.length === 0 && !error && (
      <div class="text-center py-24 bg-zinc-900/20 border border-zinc-800/50 border-dashed rounded-3xl">
        <div class="text-5xl mb-4">📋</div>
        <h2 class="text-xl font-bold text-zinc-100 mb-2">{m.lists_no_public()}</h2>
        <p class="text-zinc-500">{m.lists_no_public_hint()}</p>
      </div>
    )}
  </div>
</Base>

<script>
  import { m } from '../paraglide/messages.js';
  import { escapeHtml as esc } from '../lib/format';

  const token = (window as any).__AUTH_TOKEN__ ?? '';
  const modal = document.getElementById('create-modal');
  const createForm = document.getElementById('create-form');
  const cancelBtn = document.getElementById('cancel-btn');
  const createError = document.getElementById('create-error');
  const submitBtn = document.getElementById('create-submit-btn');
  const listsGrid = document.getElementById('lists-grid');

  function openModal() {
    modal.classList.remove('hidden');
    document.getElementById('list-name').focus();
  }

  function closeModal() {
    modal.classList.add('hidden');
    createForm.reset();
    createError.classList.add('hidden');
  }

  document.getElementById('empty-new-list-btn')?.addEventListener('click', openModal);
  cancelBtn?.addEventListener('click', closeModal);
  document.getElementById('modal-backdrop')?.addEventListener('click', closeModal);

  // "New List" dropdown - same toggle pattern as Base.astro's user menu.
  const newListBtn = document.getElementById('new-list-btn');
  const newListMenu = document.getElementById('new-list-menu');
  newListBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = !newListMenu?.classList.contains('hidden');
    newListMenu?.classList.toggle('hidden', isOpen);
  });
  document.addEventListener('click', () => newListMenu?.classList.add('hidden'));

  document.getElementById('open-create-modal-btn')?.addEventListener('click', () => {
    newListMenu?.classList.add('hidden');
    openModal();
  });

  // Remote imports share one modal, with copy and endpoint swapped per provider.
  const PROVIDERS = {
    tmdb: {
      title: m.lists_import_from({ provider: 'TMDB' }),
      hint: m.lists_import_tmdb_hint(),
      label: m.lists_import_provider_label({ provider: 'TMDB' }),
      placeholder: m.lists_import_placeholder({ url: 'https://www.themoviedb.org/list/1-...', id: '1' }),
      endpoint: '/api/proxy/lists/import/tmdb',
    },
    tvdb: {
      title: m.lists_import_from({ provider: 'TVDB' }),
      hint: m.lists_import_tvdb_hint(),
      label: m.lists_import_provider_label({ provider: 'TVDB' }),
      placeholder: m.lists_import_placeholder({ url: 'https://www.thetvdb.com/lists/13131', id: '13131' }),
      endpoint: '/api/proxy/lists/import/tvdb',
    },
    imdb: {
      title: m.lists_import_from({ provider: 'IMDb' }),
      hint: m.lists_import_imdb_hint(),
      label: m.lists_import_provider_label({ provider: 'IMDb' }),
      placeholder: m.lists_import_placeholder({ url: 'https://www.imdb.com/list/ls055592025', id: 'ls055592025' }),
      endpoint: '/api/proxy/lists/import/imdb',
    },
    mdblist: {
      title: m.lists_import_from({ provider: 'MDBList' }),
      hint: m.lists_import_mdblist_hint(),
      label: m.lists_import_mdblist_label(),
      placeholder: 'https://mdblist.com/lists/user/list-name',
      endpoint: '/api/proxy/lists/import/mdblist',
    },
  };
  const SPINNER_SVG = '<svg class="animate-spin" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10" stroke-opacity="0.25"/><path d="M12 2a10 10 0 0 1 10 10"/></svg>';

  const importModal = document.getElementById('import-modal');
  const importForm = document.getElementById('import-form');
  const importCancelBtn = document.getElementById('import-cancel-btn');
  const importError = document.getElementById('import-error');
  const importSubmitBtn = document.getElementById('import-submit-btn');
  const importSubmitLabel = document.getElementById('import-submit-label');
  const importModalTitle = document.getElementById('import-modal-title');
  const importModalHint = document.getElementById('import-modal-hint');
  const importModalLabel = document.getElementById('import-modal-label');
  const listIdInput = document.getElementById('list-id-input');

  function openImportModal(provider) {
    const cfg = PROVIDERS[provider];
    if (!cfg || !importModal) return;
    importModal.dataset.provider = provider;
    importModalTitle.textContent = cfg.title;
    importModalHint.textContent = cfg.hint;
    importModalLabel.textContent = cfg.label;
    listIdInput.placeholder = cfg.placeholder;
    importModal.classList.remove('hidden');
    listIdInput.focus();
  }

  function closeImportModal() {
    importModal?.classList.add('hidden');
    importForm?.reset();
    importError?.classList.add('hidden');
  }

  document.querySelectorAll('.open-import-modal-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      newListMenu?.classList.add('hidden');
      openImportModal(btn.dataset.provider);
    });
  });
  importCancelBtn?.addEventListener('click', closeImportModal);
  document.getElementById('import-modal-backdrop')?.addEventListener('click', closeImportModal);

  importForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const listIdOrUrl = listIdInput.value.trim();
    const provider = importModal?.dataset.provider;
    const cfg = PROVIDERS[provider];
    if (!listIdOrUrl || !cfg) return;

    importSubmitBtn.disabled = true;
    // TVDB resolves each item through its own extra API call (#442 follow-
    // up), so this can take a few seconds on a bigger list - a spinner
    // makes that wait feel like progress instead of a hang.
    importSubmitLabel.innerHTML = `${SPINNER_SVG} ${esc(m.lists_importing())}`;
    importError.classList.add('hidden');

    try {
      const res = await fetch(cfg.endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
        body: JSON.stringify({ list_id_or_url: listIdOrUrl }),
      });

      if (!res.ok) {
        const err = await res.json();
        throw new Error(err.detail || m.lists_import_failed());
      }

      const list = await res.json();
      closeImportModal();
      window.location.href = `/list/${list.id}`;
    } catch (err) {
      importError.textContent = err.message;
      importError.classList.remove('hidden');
      importSubmitBtn.disabled = false;
      importSubmitLabel.textContent = m.lists_import_submit();
    }
  });

  createForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = document.getElementById('list-name').value.trim();
    const description = document.getElementById('list-desc').value.trim() || null;
    const privacyLevel = document.querySelector('input[name="privacy_level"]:checked').value;

    if (!name) return;

    submitBtn.disabled = true;
    submitBtn.textContent = m.common_creating();
    createError.classList.add('hidden');

    try {
      const res = await fetch(`/api/proxy/lists`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
        body: JSON.stringify({ name, description, privacy_level: privacyLevel }),
      });

      if (!res.ok) {
        const err = await res.json();
        throw new Error(err.detail || m.lists_create_failed());
      }

      const list = await res.json();
      closeModal();
      window.location.href = `/list/${list.id}`;
    } catch (err) {
      createError.textContent = err.message;
      createError.classList.remove('hidden');
      submitBtn.disabled = false;
      submitBtn.textContent = m.lists_create_list();
    }
  });

  document.querySelectorAll('.delete-list-btn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      const listId = btn.getAttribute('data-list-id');
      const listName = btn.getAttribute('data-list-name');

      const ok = await (window as any).showConfirm(m.common_delete_named_confirm({ name: listName }), m.common_cannot_be_undone());
      if (!ok) return;

      btn.disabled = true;
      try {
        const res = await fetch(`/api/proxy/lists/${listId}`, {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${token}` },
        });
        if (res.ok) {
          const card = document.querySelector(`[data-list-id="${listId}"]`);
          card?.remove();
        }
      } catch (err) {
        console.error('Failed to delete list', err);
        btn.disabled = false;
      }
    });
  });
</script>
