  const deleteUserModal = document.getElementById('delete-user-modal')!;
  let pendingDelete: { userId: number; row: HTMLTableRowElement; btn: HTMLButtonElement; isSelf: boolean } | null = null;

  function openDeleteModal(userId: number, username: string, row: HTMLTableRowElement, btn: HTMLButtonElement, isSelf: boolean) {
    pendingDelete = { userId, row, btn, isSelf };
    const body = document.getElementById('delete-user-modal-body')!;
    if (isSelf) {
      body.innerHTML = m.admin_delete_self_body({ username: `<strong class="text-zinc-100">${esc(username)}</strong>` });
    } else {
      body.innerHTML = m.admin_delete_user_body({ username: `<strong class="text-zinc-100">${esc(username)}</strong>` });
    }
    deleteUserModal.classList.remove('hidden');
  }

  function closeDeleteModal() {
    deleteUserModal.classList.add('hidden');
    pendingDelete = null;
  }

  document.getElementById('delete-user-cancel-btn')?.addEventListener('click', closeDeleteModal);
  document.getElementById('delete-user-modal-backdrop')?.addEventListener('click', closeDeleteModal);

  document.getElementById('delete-user-confirm-btn')?.addEventListener('click', async () => {
    if (!pendingDelete) return;
    const { userId, row, btn, isSelf } = pendingDelete;
    closeDeleteModal();
    btn.disabled = true;
    try {
      const res = await fetch(`/api/proxy/admin/users/${userId}`, {
        method: 'DELETE', headers: { 'Authorization': `Bearer ${token}` },
      });
      if (!res.ok) throw new Error((await res.json()).detail || m.common_failed());
      if (isSelf) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/logout';
        document.body.appendChild(form);
        form.submit();
      } else {
        const detailRow = document.querySelector(`tr.user-detail-row[data-detail-for="${userId}"]`);
        detailRow?.remove();
        row.remove();
        refreshToggleButtons();
        showMessage(m.admin_user_deleted());
      }
    } catch (err: unknown) {
      showMessage(err instanceof Error ? err.message : m.common_failed(), 'error');
      btn.disabled = false;
    }
  });

  // ── Admin heal ──
  const adminHealBtn = document.getElementById('admin-heal-btn') as HTMLButtonElement;
  const adminHealModal = document.getElementById('admin-heal-modal')!;

  adminHealBtn?.addEventListener('click', () => {
    adminHealModal.classList.remove('hidden');
  });

  document.getElementById('admin-heal-cancel-btn')?.addEventListener('click', () => {
    adminHealModal.classList.add('hidden');
  });

  document.getElementById('admin-heal-modal-backdrop')?.addEventListener('click', () => {
    adminHealModal.classList.add('hidden');
  });

  // ── Admin heal progress tracking ─────────────────────────────────────────
  let adminHealPoller: ReturnType<typeof setTimeout> | null = null;

  function renderAdminHealProgress(job: any) {
    const strip = document.getElementById('admin-heal-progress');
    const bar   = document.getElementById('admin-heal-job-bar');
    const pctEl = document.getElementById('admin-heal-job-pct');
    const label = document.getElementById('admin-heal-job-label');
    const items = document.getElementById('admin-heal-job-items');
    if (!strip) return;

    if (!job) { strip.classList.add('hidden'); return; }
    strip.classList.remove('hidden');

    const isFailed    = job.status === 'failed';
    const isCompleted = job.status === 'completed';
    const isPending   = job.status === 'pending';

    if (isFailed) {
      if (bar) { bar.className = 'h-1.5 rounded-full transition-all duration-500 bg-red-500'; bar.style.width = '100%'; }
      if (label) label.textContent = m.heal_failed();
      if (pctEl) pctEl.textContent = '';
      if (items) items.textContent = job.error_message || m.common_unknown_error();
      return;
    }
    if (isCompleted) {
      if (bar) { bar.className = 'h-1.5 rounded-full transition-all duration-500 bg-blue-600'; bar.style.width = '100%'; }
      if (label) label.textContent = m.heal_complete();
      if (pctEl) pctEl.textContent = '100%';
      if (items) items.textContent = m.heal_items_healed({ count: job.processed_items });
      return;
    }

    const pct = job.total_items > 0 ? Math.min(100, Math.round((job.processed_items / job.total_items) * 100)) : 0;
    const indeterminate = isPending || pct === 0;
    if (bar) {
      bar.className = `h-1.5 rounded-full transition-all duration-500 bg-blue-600${indeterminate ? ' animate-pulse' : ''}`;
      bar.style.width = indeterminate ? '100%' : `${pct}%`;
    }
    if (label) label.textContent = isPending ? m.heal_queued() : m.heal_healing();
    if (pctEl) pctEl.textContent = pct > 0 ? `${pct}%` : '';
    if (items) items.textContent = job.total_items > 0 ? m.common_items_progress({ processed: job.processed_items, total: job.total_items }) : m.common_loading();
  }

  async function pollAdminHealJob() {
    try {
      const res = await fetch('/api/proxy/sync/status', { headers: { 'Authorization': `Bearer ${token}` } });
      if (!res.ok) return;
      const jobs: any[] = await res.json();
      const job = jobs.find((j: any) => j.source === 'tmdb' && j.job_type === 'heal');
      const isActive = job && (job.status === 'pending' || job.status === 'running');
      const isRecentDone = job && (job.status === 'completed' || job.status === 'failed')
        && new Date(job.updated_at).getTime() > Date.now() - 8000;
      renderAdminHealProgress((isActive || isRecentDone) ? job : null);
      if (isActive) {
        adminHealPoller = setTimeout(pollAdminHealJob, 2000);
      } else if (isRecentDone) {
        adminHealPoller = setTimeout(() => { renderAdminHealProgress(null); adminHealPoller = null; }, 4000);
      } else {
        adminHealPoller = null;
      }
    } catch {
      adminHealPoller = null;
    }
  }

  function startAdminHealPoller() {
    if (adminHealPoller != null) clearTimeout(adminHealPoller);
    pollAdminHealJob();
  }

  // Resume active heal on page load
  (async () => {
    try {
      const res = await fetch('/api/proxy/sync/status', { headers: { 'Authorization': `Bearer ${token}` } });
      if (!res.ok) return;
      const jobs: any[] = await res.json();
      const job = jobs.find((j: any) => j.source === 'tmdb' && j.job_type === 'heal');
      if (job && (job.status === 'pending' || job.status === 'running')) startAdminHealPoller();
    } catch { /* non-fatal */ }
  })();

  document.getElementById('admin-heal-confirm-btn')?.addEventListener('click', async () => {
    adminHealModal.classList.add('hidden');
    adminHealBtn.disabled = true;
    adminHealBtn.textContent = m.common_starting();
    try {
      const res = await fetch('/api/proxy/admin/maintenance/heal', {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}` },
      });
      if (!res.ok) throw new Error((await res.json()).detail || m.heal_start_failed());
      startAdminHealPoller();
    } catch (err: unknown) {
      showMessage(err instanceof Error ? err.message : m.heal_start_failed(), 'error');
    } finally {
      adminHealBtn.disabled = false;
      adminHealBtn.textContent = m.admin_run_heal();
    }
  });

  const clearCacheBtn = document.getElementById('admin-clear-cache-btn') as HTMLButtonElement;
  clearCacheBtn?.addEventListener('click', async () => {
    if (!confirm(m.admin_clear_cache_confirm())) {
      return;
    }
    clearCacheBtn.disabled = true;
    const originalText = clearCacheBtn.textContent || m.admin_clear_cache();
    clearCacheBtn.textContent = m.common_clearing();
    try {
      const res = await fetch('/api/proxy/admin/maintenance/clear-cache', {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}` },
      });
      if (!res.ok) throw new Error((await res.json()).detail || m.admin_clear_cache_failed());
      showMessage(m.admin_cache_cleared());
      loadCacheStats();
    } catch (err: unknown) {
      showMessage(err instanceof Error ? err.message : m.admin_clear_cache_failed(), 'error');
    } finally {
      clearCacheBtn.disabled = false;
      clearCacheBtn.textContent = originalText;
    }
  });

  document.getElementById('users-table-body')!.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('.copy-api-key-btn')) return;

    // Resolve the main row and userId from either the main row or detail row
    let mainRow = target.closest('tr.user-main-row') as HTMLTableRowElement | null;
    if (!mainRow) {
      const detailRow = target.closest('tr.user-detail-row') as HTMLTableRowElement | null;
      if (!detailRow) return;
      const detailFor = detailRow.dataset.detailFor!;
      mainRow = document.querySelector<HTMLTableRowElement>(`tr.user-main-row[data-user-id="${detailFor}"]`);
    }
    if (!mainRow) return;
    const userId = parseInt(mainRow.dataset.userId!);

    const actionsBtn = target.closest('.user-actions-btn') as HTMLButtonElement | null;
    if (actionsBtn) {
      if (menuCtx?.btn === actionsBtn) { closeActionsMenu(); return; }
      openActionsMenu(userId, mainRow, actionsBtn);
    }
  });

  // ── User actions dropdown ──
  const actionsMenu = document.getElementById('user-actions-menu')!;
  const menuToggleAdmin = document.getElementById('menu-toggle-admin') as HTMLButtonElement;
  const menuDisable2fa = document.getElementById('menu-disable-2fa') as HTMLButtonElement;
  let menuCtx: { userId: number; row: HTMLTableRowElement; btn: HTMLButtonElement } | null = null;

  function syncActionsMenu() {
    if (!menuCtx) return;
    const isAdmin = menuCtx.row.dataset.isAdmin === 'true';
    menuToggleAdmin.textContent = isAdmin ? m.admin_remove_admin() : m.admin_make_admin();
    const blocked = isAdmin && menuCtx.userId === currentUserId && countAdmins() === 1;
    menuToggleAdmin.disabled = blocked;
    menuToggleAdmin.title = blocked ? m.admin_sole_admin() : '';
    menuDisable2fa.classList.toggle('hidden', menuCtx.row.dataset.totp !== 'true');
  }

  function openActionsMenu(userId: number, row: HTMLTableRowElement, btn: HTMLButtonElement) {
    closeActionsMenu();
    menuCtx = { userId, row, btn };
    syncActionsMenu();
    // flex is toggled with hidden rather than left on, so the two utilities never fight.
    actionsMenu.classList.remove('hidden');
    actionsMenu.classList.add('flex');
    // Content-sized now, so measure from the origin where it has the full viewport to
    // lay out in - a stale or default position could squeeze it and skew the width.
    actionsMenu.style.left = '0px';
    actionsMenu.style.top = '0px';
    btn.setAttribute('aria-expanded', 'true');
    // Fixed-position next to the button, right-aligned to it, flipped above when it would overflow.
    // The button is still mid-press (active:scale-95) when this runs, so its bounding rect
    // is ~5% smaller than its real box. offsetWidth/Height ignore transforms; the scale is
    // about the centre, so rebuild the unscaled box around the rect's centre.
    const br = btn.getBoundingClientRect();
    const cx = br.left + br.width / 2;
    const cy = br.top + br.height / 2;
    const r = {
      left: cx - btn.offsetWidth / 2,
      right: cx + btn.offsetWidth / 2,
      top: cy - btn.offsetHeight / 2,
      bottom: cy + btn.offsetHeight / 2,
    };
    const mw = actionsMenu.offsetWidth;
    const mh = actionsMenu.offsetHeight;
    // The button is at the row's right on both layouts, so the menu's right edge lines up with it.
    const preferred = r.right - mw;
    const left = Math.max(8, Math.min(preferred, window.innerWidth - mw - 8));
    const top = r.bottom + 4 + mh > window.innerHeight ? Math.max(8, r.top - mh - 4) : r.bottom + 4;
    actionsMenu.style.left = `${left}px`;
    actionsMenu.style.top = `${top}px`;
  }

  function closeActionsMenu() {
    actionsMenu.classList.add('hidden');
    actionsMenu.classList.remove('flex');
    menuCtx?.btn.setAttribute('aria-expanded', 'false');
    menuCtx = null;
  }

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('#user-actions-menu') || t.closest('.user-actions-btn')) return;
    closeActionsMenu();
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeActionsMenu(); });
  window.addEventListener('scroll', closeActionsMenu, true);
  window.addEventListener('resize', closeActionsMenu);

  menuToggleAdmin.addEventListener('click', async () => {
    if (!menuCtx || menuToggleAdmin.disabled) return;
    const { userId, row } = menuCtx;
    closeActionsMenu();
    try {
      const res = await fetch(`/api/proxy/admin/users/${userId}/toggle-admin`, {
        method: 'PATCH', headers: { 'Authorization': `Bearer ${token}` },
      });
      if (!res.ok) throw new Error((await res.json()).detail || m.common_failed());
      const updated = await res.json();
      updateRow(row, updated.is_admin);
      showMessage(m.admin_user_updated());
    } catch (err: unknown) {
      showMessage(err instanceof Error ? err.message : m.common_failed(), 'error');
    }
  });

  menuDisable2fa.addEventListener('click', async () => {
    if (!menuCtx) return;
    const { userId, row } = menuCtx;
    closeActionsMenu();
    const username = row.querySelector('td')!.textContent!.trim();
    const ok = await (window as any).showConfirm(
      m.admin_disable_2fa_confirm_title(),
      m.admin_disable_2fa_confirm_body({ username }),
    );
    if (!ok) return;
    try {
      const res = await fetch(`/api/proxy/admin/users/${userId}/disable-2fa`, {
        method: 'POST', headers: { 'Authorization': `Bearer ${token}` },
      });
      if (!res.ok) throw new Error((await res.json()).detail || m.common_failed());
      row.dataset.totp = 'false';
      showMessage(m.admin_2fa_disabled());
    } catch (err: unknown) {
      showMessage(err instanceof Error ? err.message : m.common_failed(), 'error');
    }
  });

  document.getElementById('menu-delete-user')!.addEventListener('click', () => {
    if (!menuCtx) return;
    const { userId, row, btn } = menuCtx;
    closeActionsMenu();
    const username = row.querySelector('td')!.textContent!.trim();
    openDeleteModal(userId, username, row, btn, userId === currentUserId);
  });

  // ── Reset password modal ──
  const resetPwModal = document.getElementById('reset-password-modal')!;
  const resetPwForm = document.getElementById('reset-password-form') as HTMLFormElement;
  const resetPwInput = document.getElementById('reset-password-input') as HTMLInputElement;
  const resetPwConfirm = document.getElementById('reset-password-confirm') as HTMLInputElement;
  const resetPwError = document.getElementById('reset-password-error')!;
  const resetPwSave = document.getElementById('reset-password-save-btn') as HTMLButtonElement;
  let resetPwUserId: number | null = null;

  function closeResetPwModal() {
    resetPwModal.classList.add('hidden');
    resetPwForm.reset();
    // form.reset() doesn't undo a revealed password or its eye icon.
    resetPwForm.querySelectorAll<HTMLInputElement>('input').forEach(i => { i.type = 'password'; });
    resetPwForm.querySelectorAll('.eye-icon').forEach(i => i.classList.remove('hidden'));
    resetPwForm.querySelectorAll('.eye-slash-icon').forEach(i => i.classList.add('hidden'));
    resetPwError.classList.add('hidden');
    resetPwUserId = null;
  }

  document.getElementById('menu-reset-password')!.addEventListener('click', () => {
    if (!menuCtx) return;
    const { userId, row } = menuCtx;
    closeActionsMenu();
    resetPwUserId = userId;
    const username = row.querySelector('td')!.textContent!.trim();
    document.getElementById('reset-password-modal-body')!.innerHTML =
      m.admin_reset_password_body({ username: `<strong class="text-zinc-100">${esc(username)}</strong>` });
    resetPwModal.classList.remove('hidden');
    resetPwInput.focus();
  });

  document.getElementById('reset-password-cancel-btn')!.addEventListener('click', closeResetPwModal);
  document.getElementById('reset-password-modal-backdrop')!.addEventListener('click', closeResetPwModal);

  resetPwForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (resetPwUserId === null) return;
    if (resetPwInput.value !== resetPwConfirm.value) {
      resetPwError.textContent = m.admin_passwords_mismatch();
      resetPwError.classList.remove('hidden');
      return;
    }
    resetPwSave.disabled = true;
    try {
      const res = await fetch(`/api/proxy/admin/users/${resetPwUserId}/reset-password`, {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: resetPwInput.value }),
      });
      if (!res.ok) throw new Error((await res.json()).detail || m.common_failed());
      closeResetPwModal();
      showMessage(m.admin_password_updated());
    } catch (err: unknown) {
      resetPwError.textContent = err instanceof Error ? err.message : m.common_failed();
      resetPwError.classList.remove('hidden');
    } finally {
      resetPwSave.disabled = false;
    }
  });

  // ── Cache stats widget ──

  async function loadCacheStats() {
    try {
      const res = await fetch('/api/proxy/admin/maintenance/cache-stats', {
        headers: { 'Authorization': `Bearer ${token}` },
      });
      if (!res.ok) return;
      const data = await res.json();

      const widget      = document.getElementById('cache-stats-widget')!;
      const label       = document.getElementById('cache-stats-label')!;
      const pctEl       = document.getElementById('cache-stats-pct')!;
      const progressWrap = document.getElementById('cache-progress-wrap')!;
      const progressBar = document.getElementById('cache-progress-bar') as HTMLElement;
      const usedLabel   = document.getElementById('cache-used-label')!;
      const limitLabel  = document.getElementById('cache-limit-label')!;

      const usedStr = formatBytes(data.total_size_bytes);
      const count: number = data.entry_count;
      label.textContent = m.admin_cache_stats({ used: usedStr, count, formatted: formatNumber(count) });
      widget.classList.remove('hidden');

      if (data.limit_gb && data.limit_gb > 0) {
        const limitBytes = data.limit_gb * 1073741824;
        const pct = Math.min(100, (data.total_size_bytes / limitBytes) * 100);
        pctEl.textContent = formatNumber(pct / 100, { style: 'percent', minimumFractionDigits: 1, maximumFractionDigits: 1 });
        progressWrap.classList.remove('hidden');
        progressBar.style.width = `${pct}%`;
        progressBar.className = `h-full rounded-full transition-all duration-500 ${
          pct >= 90 ? 'bg-red-500' : pct >= 70 ? 'bg-amber-500' : 'bg-blue-500'
        }`;
        usedLabel.textContent = usedStr;
        limitLabel.textContent = m.admin_cache_limit({ limit: m.unit_gigabytes({ value: formatNumber(Number(data.limit_gb.toFixed(2))) }) });
      } else {
        pctEl.textContent = '';
        progressWrap.classList.add('hidden');
      }
    } catch { /* stats are non-critical */ }
  }

  loadCacheStats();
</script>
