  document.getElementById('backup-btn')?.addEventListener('click', async () => {
    const btn = document.getElementById('backup-btn') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = m.export_preparing();
    try {
      const res = await fetch('/api/proxy/admin/backup', {
        headers: { 'Authorization': `Bearer ${token}` },
      });
      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        throw new Error(data.detail || m.admin_backup_failed());
      }
      const cd = res.headers.get('Content-Disposition');
      const filename = cd?.match(/filename="([^"]+)"/)?.[1] ?? 'scrob_backup.bak';
      const blob = await res.blob();
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      a.click();
      URL.revokeObjectURL(url);
      showMessage(m.admin_backup_done());
    } catch (err: unknown) {
      showMessage(err instanceof Error ? err.message : m.admin_backup_failed(), 'error');
    } finally {
      btn.disabled = false;
      btn.textContent = m.admin_download_backup();
