---
import Base from "../layouts/Base.astro";
import { api } from "../lib/api";
import type { AdminUser } from "../lib/api";
import { connectionIconHtml } from "../lib/connectionIcons";
import { m } from "../paraglide/messages.js";

const { token, user } = Astro.locals;

if (!user?.is_admin) {
  return Astro.redirect("/", 302);
}

Astro.response.headers.set("Cache-Control", "no-store");

const [globalSettings, users] = await Promise.all([
  api.admin.getSettings(token!),
  api.admin.listUsers(token!),
]);

const adminCount = users.filter((u: AdminUser) => u.is_admin).length;
---

<Base title={m.nav_admin()}>
  <div id="app-data"
    data-token={token}
    data-current-user-id={user!.id}
    data-admin-count={adminCount}
    class="hidden" aria-hidden="true">
  </div>

  <div class="max-w-4xl mx-auto space-y-10">
    <h1 class="page-title">{m.admin_admin_panel()}</h1>

    <div id="js-message" class="hidden fixed right-4 z-[200] max-w-sm p-4 rounded-lg shadow-2xl border"></div>

    <!-- ── Global Server Settings ── -->
    <section>
      <h2 class="section-headline border-b border-zinc-800 pb-2 mb-6">{m.admin_global_server_settings()}</h2>
      <p class="text-zinc-400 text-sm mb-6">{m.admin_these_settings_apply_to_all_users()}</p>

      <form id="global-settings-form" class="space-y-3">

        <!-- TMDB -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden">
          <div class="collapsible-header flex items-center justify-between px-6 py-4 hover:bg-zinc-900/40 cursor-pointer transition-colors select-none" data-target="tmdb-body">
            <div class="flex items-center gap-4 pointer-events-none">
              <Fragment set:html={connectionIconHtml("themoviedatabase")} />
              <div class="flex flex-col gap-0.5">
                <span class="font-medium text-zinc-200">TMDB</span>
                <span id="tmdb-conn-status" class="hidden text-xs font-normal px-1.5 py-0.5 rounded self-start pointer-events-auto"></span>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <div onclick="event.stopPropagation()">
                <button type="button" id="test-tmdb-btn" class="text-sm bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 px-3 py-1.5 rounded-lg transition-colors cursor-pointer disabled:opacity-50">{m.conn_test()}</button>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="collapsible-chevron w-4 h-4 text-zinc-500 transition-transform pointer-events-none ml-1 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </div>
          </div>
          <div id="tmdb-body" class="border-t border-zinc-800 hidden">
            <div class="px-6 py-6">
              <div class="space-y-2 max-w-md">
                <label for="tmdb_api_key" class="block text-sm font-medium text-zinc-400">{m.admin_read_access_token()}</label>
                <div class="relative group/field">
                  <input
                    type="password"
                    name="tmdb_api_key"
                    id="tmdb_api_key"
                    value={globalSettings.tmdb_api_key ?? ""}
                    placeholder="eyJhbGciOiJIUzI1NiJ9..."
                    class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
                  />
                  <button type="button" class="password-toggle absolute right-2 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 p-1 cursor-pointer transition-colors" aria-label={m.admin_toggle_visibility()}>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-icon"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.644C3.412 7.943 7.213 5 12 5c4.787 0 8.588 2.943 9.964 6.678.066.18.066.362 0 .544C20.588 16.057 16.787 19 12 19c-4.787 0-8.588-2.943-9.964-6.678z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-slash-icon hidden"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" /></svg>
                  </button>
                </div>
                <p class="text-xs text-zinc-500">{m.admin_required_for_all_users_who_don()}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- TVDB -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden">
          <div class="collapsible-header flex items-center justify-between px-6 py-4 hover:bg-zinc-900/40 cursor-pointer transition-colors select-none" data-target="tvdb-body">
            <div class="flex items-center gap-4 pointer-events-none">
              <Fragment set:html={connectionIconHtml("tvdb")} />
              <div class="flex flex-col gap-0.5">
                <span class="font-medium text-zinc-200">TVDB</span>
                <span id="tvdb-conn-status" class="hidden text-xs font-normal px-1.5 py-0.5 rounded self-start pointer-events-auto"></span>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <div onclick="event.stopPropagation()">
                <button type="button" id="test-tvdb-btn" class="text-sm bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 px-3 py-1.5 rounded-lg transition-colors cursor-pointer disabled:opacity-50">{m.conn_test()}</button>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="collapsible-chevron w-4 h-4 text-zinc-500 transition-transform pointer-events-none ml-1 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </div>
          </div>
          <div id="tvdb-body" class="border-t border-zinc-800 hidden">
            <div class="px-6 py-6">
              <div class="space-y-2 max-w-md">
                <label for="tvdb_api_key" class="block text-sm font-medium text-zinc-400">{m.admin_api_key()}</label>
                <div class="relative group/field">
                  <input
                    type="password"
                    name="tvdb_api_key"
                    id="tvdb_api_key"
                    value={globalSettings.tvdb_api_key ?? ""}
                    placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
                    class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
                  />
                  <button type="button" class="password-toggle absolute right-2 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 p-1 cursor-pointer transition-colors" aria-label={m.admin_toggle_visibility()}>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-icon"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.644C3.412 7.943 7.213 5 12 5c4.787 0 8.588 2.943 9.964 6.678.066.18.066.362 0 .544C20.588 16.057 16.787 19 12 19c-4.787 0-8.588-2.943-9.964-6.678z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-slash-icon hidden"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" /></svg>
                  </button>
                </div>
                <p class="text-xs text-zinc-500" set:html={m.admin_tvdb_help()} />

                <label for="tvdb_subscriber_pin" class="block text-sm font-medium text-zinc-400 pt-3" set:html={m.admin_tvdb_pin_label()} />
                <div class="relative group/field">
                  <input
                    type="password"
                    name="tvdb_subscriber_pin"
                    id="tvdb_subscriber_pin"
                    value={globalSettings.tvdb_subscriber_pin ?? ""}
                    placeholder={m.settings_only_for_a_subscriber_supported_key()}
                    class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
                  />
                  <button type="button" class="password-toggle absolute right-2 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 p-1 cursor-pointer transition-colors" aria-label={m.admin_toggle_visibility()}>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-icon"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.644C3.412 7.943 7.213 5 12 5c4.787 0 8.588 2.943 9.964 6.678.066.18.066.362 0 .544C20.588 16.057 16.787 19 12 19c-4.787 0-8.588-2.943-9.964-6.678z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-slash-icon hidden"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" /></svg>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- MDBList -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden">
          <div class="collapsible-header flex items-center justify-between px-6 py-4 hover:bg-zinc-900/40 cursor-pointer transition-colors select-none" data-target="mdblist-body">
            <div class="flex items-center gap-4 pointer-events-none">
              <Fragment set:html={connectionIconHtml("mdblist")} />
              <div class="flex flex-col gap-0.5">
                <span class="font-medium text-zinc-200">MDBList</span>
                <span id="mdblist-conn-status" class="hidden text-xs font-normal px-1.5 py-0.5 rounded self-start pointer-events-auto"></span>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <div onclick="event.stopPropagation()">
                <button type="button" id="test-mdblist-btn" class="text-sm bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 px-3 py-1.5 rounded-lg transition-colors cursor-pointer disabled:opacity-50">{m.conn_test()}</button>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="collapsible-chevron w-4 h-4 text-zinc-500 transition-transform pointer-events-none ml-1 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </div>
          </div>
          <div id="mdblist-body" class="border-t border-zinc-800 hidden">
            <div class="px-6 py-6">
              <div class="space-y-2 max-w-md">
                <label for="mdblist_api_key" class="block text-sm font-medium text-zinc-400">{m.admin_api_key()}</label>
                <div class="relative group/field">
                  <input
                    type="password"
                    name="mdblist_api_key"
                    id="mdblist_api_key"
                    value={globalSettings.mdblist_api_key ?? ""}
                    placeholder={m.admin_mdblist_key_placeholder()}
                    class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
                  />
                  <button type="button" class="password-toggle absolute right-2 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 p-1 cursor-pointer transition-colors" aria-label={m.admin_toggle_visibility()}>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-icon"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.644C3.412 7.943 7.213 5 12 5c4.787 0 8.588 2.943 9.964 6.678.066.18.066.362 0 .544C20.588 16.057 16.787 19 12 19c-4.787 0-8.588-2.943-9.964-6.678z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-slash-icon hidden"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" /></svg>
                  </button>
                </div>
                <p class="text-xs text-zinc-500">{m.admin_mdblist_help()}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Radarr -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden">
          <div class="collapsible-header flex items-center justify-between px-6 py-4 hover:bg-zinc-900/40 cursor-pointer transition-colors select-none" data-target="radarr-body">
            <div class="flex items-center gap-4 pointer-events-none">
              <Fragment set:html={connectionIconHtml("radarr")} />
              <div class="flex flex-col gap-0.5">
                <span class="font-medium text-zinc-200">Radarr</span>
                <span id="radarr-conn-status" class="hidden text-xs font-normal px-1.5 py-0.5 rounded self-start pointer-events-auto"></span>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <div class="flex gap-2" onclick="event.stopPropagation()">
                <button type="button" id="test-radarr-btn" class="text-sm bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 px-3 py-1.5 rounded-lg transition-colors cursor-pointer">{m.admin_test_fetch()}</button>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="collapsible-chevron w-4 h-4 text-zinc-500 transition-transform pointer-events-none ml-1 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </div>
          </div>
          <div id="radarr-body" class="border-t border-zinc-800 hidden">
            <div class="grid md:grid-cols-2 gap-8 px-6 py-6">
              <div class="space-y-4">
                <div class="space-y-2">
                  <label for="radarr_url" class="block text-sm font-medium text-zinc-400">{m.admin_server_url()}</label>
                  <input type="url" name="radarr_url" id="radarr_url" placeholder="http://192.168.1.100:7878" value={globalSettings.radarr_url ?? ""}
                    class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
                </div>
                <div class="space-y-2">
                  <label for="radarr_token" class="block text-sm font-medium text-zinc-400">{m.admin_api_key()}</label>
                  <div class="relative group/field">
                    <input type="password" name="radarr_token" id="radarr_token" value={globalSettings.radarr_token ?? ""}
                      class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
                    <button type="button" class="password-toggle absolute right-2 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 p-1 cursor-pointer transition-colors" aria-label={m.admin_toggle_visibility()}>
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-icon"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.644C3.412 7.943 7.213 5 12 5c4.787 0 8.588 2.943 9.964 6.678.066.18.066.362 0 .544C20.588 16.057 16.787 19 12 19c-4.787 0-8.588-2.943-9.964-6.678z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-slash-icon hidden"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" /></svg>
                    </button>
                  </div>
                </div>
              </div>
              <div class="space-y-4">
                <div class="space-y-2">
                  <label for="radarr_root_folder" class="block text-sm font-medium text-zinc-400">{m.customize_add_root_folder()}</label>
                  <select name="radarr_root_folder" id="radarr_root_folder"
                    class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all appearance-none">
                    <option value="">{m.admin_select_folder()}</option>
                    {globalSettings.radarr_root_folder && <option value={globalSettings.radarr_root_folder} selected>{globalSettings.radarr_root_folder}</option>}
                  </select>
                </div>
                <div class="space-y-2">
                  <label for="radarr_quality_profile" class="block text-sm font-medium text-zinc-400">{m.customize_add_quality_profile()}</label>
                  <select name="radarr_quality_profile" id="radarr_quality_profile"
                    class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all appearance-none">
                    <option value="">{m.admin_select_profile()}</option>
                    {globalSettings.radarr_quality_profile && <option value={globalSettings.radarr_quality_profile} selected>{m.common_quality_profile_id({ id: globalSettings.radarr_quality_profile })}</option>}
                  </select>
                </div>
                <div class="space-y-2">
                  <label class="block text-sm font-medium text-zinc-400">{m.customize_add_tags()}</label>
                  <div id="radarr_tags_list" class="flex flex-wrap gap-2 min-h-[42px] p-2 bg-zinc-950 border border-zinc-800 rounded-lg">
                    <span class="text-xs text-zinc-500 italic px-2 py-1">{m.admin_fetch_profiles_to_see_tags()}</span>
                    {globalSettings.radarr_tags?.map((tid: number) => (
                      <input type="hidden" name="radarr_tags" value={tid} />
                    ))}
                  </div>
                </div>
                <label class="flex items-center gap-3 cursor-pointer select-none pt-1">
                  <input type="checkbox" name="radarr_require_approval" id="radarr_require_approval" value="true"
                    checked={globalSettings.radarr_require_approval ?? false}
                    class="w-4 h-4 rounded border-zinc-600 bg-zinc-950 text-blue-500 focus:ring-blue-500 cursor-pointer" />
                  <span class="text-sm text-zinc-300">{m.admin_require_admin_approval_for_requests()}</span>
                </label>
                <label class="flex items-center justify-between gap-3 p-3 bg-zinc-950 border border-zinc-800 rounded-lg cursor-pointer hover:bg-zinc-800/60 transition-colors">
                  <span class="text-sm text-zinc-300">{m.admin_let_admins_customize_root_folder_quality()}</span>
                  <input type="checkbox" name="radarr_customize_on_add" id="radarr_customize_on_add" value="true" class="sr-only peer" checked={globalSettings.radarr_customize_on_add ?? false} />
                  <div class="relative w-10 h-5 bg-zinc-700 peer-checked:bg-blue-600 rounded-full transition-colors pointer-events-none shrink-0 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:bg-white after:rounded-full after:transition-transform peer-checked:after:translate-x-5"></div>
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- Sonarr -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden">
          <div class="collapsible-header flex items-center justify-between px-6 py-4 hover:bg-zinc-900/40 cursor-pointer transition-colors select-none" data-target="sonarr-body">
            <div class="flex items-center gap-4 pointer-events-none">
              <Fragment set:html={connectionIconHtml("sonarr")} />
              <div class="flex flex-col gap-0.5">
                <span class="font-medium text-zinc-200">Sonarr</span>
                <span id="sonarr-conn-status" class="hidden text-xs font-normal px-1.5 py-0.5 rounded self-start pointer-events-auto"></span>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <div class="flex gap-2" onclick="event.stopPropagation()">
                <button type="button" id="test-sonarr-btn" class="text-sm bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 px-3 py-1.5 rounded-lg transition-colors cursor-pointer">{m.admin_test_fetch()}</button>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="collapsible-chevron w-4 h-4 text-zinc-500 transition-transform pointer-events-none ml-1 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </div>
          </div>
          <div id="sonarr-body" class="border-t border-zinc-800 hidden">
            <div class="grid md:grid-cols-2 gap-8 px-6 py-6">
              <div class="space-y-4">
                <div class="space-y-2">
                  <label for="sonarr_url" class="block text-sm font-medium text-zinc-400">{m.admin_server_url()}</label>
                  <input type="url" name="sonarr_url" id="sonarr_url" placeholder="http://192.168.1.100:8989" value={globalSettings.sonarr_url ?? ""}
                    class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
                </div>
                <div class="space-y-2">
                  <label for="sonarr_token" class="block text-sm font-medium text-zinc-400">{m.admin_api_key()}</label>
                  <div class="relative group/field">
                    <input type="password" name="sonarr_token" id="sonarr_token" value={globalSettings.sonarr_token ?? ""}
                      class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
                    <button type="button" class="password-toggle absolute right-2 top-1/2 -translate-y-1/2 text-zinc-500 hover:text-zinc-300 p-1 cursor-pointer transition-colors" aria-label={m.admin_toggle_visibility()}>
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-icon"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.644C3.412 7.943 7.213 5 12 5c4.787 0 8.588 2.943 9.964 6.678.066.18.066.362 0 .544C20.588 16.057 16.787 19 12 19c-4.787 0-8.588-2.943-9.964-6.678z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 eye-slash-icon hidden"><path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" /></svg>
                    </button>
                  </div>
                </div>
              </div>
              <div class="space-y-4">
                <div class="space-y-2">
                  <label for="sonarr_root_folder" class="block text-sm font-medium text-zinc-400">{m.customize_add_root_folder()}</label>
                  <select name="sonarr_root_folder" id="sonarr_root_folder"
                    class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all appearance-none">
                    <option value="">{m.admin_select_folder()}</option>
                    {globalSettings.sonarr_root_folder && <option value={globalSettings.sonarr_root_folder} selected>{globalSettings.sonarr_root_folder}</option>}
                  </select>
                </div>
                <div class="space-y-2">
                  <label for="sonarr_quality_profile" class="block text-sm font-medium text-zinc-400">{m.customize_add_quality_profile()}</label>
                  <select name="sonarr_quality_profile" id="sonarr_quality_profile"
                    class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all appearance-none">
                    <option value="">{m.admin_select_profile()}</option>
                    {globalSettings.sonarr_quality_profile && <option value={globalSettings.sonarr_quality_profile} selected>{m.common_quality_profile_id({ id: globalSettings.sonarr_quality_profile })}</option>}
                  </select>
                </div>
                <div class="space-y-2">
                  <label class="block text-sm font-medium text-zinc-400">{m.customize_add_tags()}</label>
                  <div id="sonarr_tags_list" class="flex flex-wrap gap-2 min-h-[42px] p-2 bg-zinc-950 border border-zinc-800 rounded-lg">
                    <span class="text-xs text-zinc-500 italic px-2 py-1">{m.admin_fetch_profiles_to_see_tags()}</span>
                    {globalSettings.sonarr_tags?.map((tid: number) => (
                      <input type="hidden" name="sonarr_tags" value={tid} />
                    ))}
                  </div>
                </div>
                <label class="flex items-center justify-between gap-3 p-3 bg-zinc-950 border border-zinc-800 rounded-lg cursor-pointer hover:bg-zinc-800/60 transition-colors">
                  <span class="text-sm text-zinc-300">{m.customize_add_season_folders()}</span>
                  <input type="checkbox" name="sonarr_season_folder" id="sonarr_season_folder" value="true" class="sr-only peer" checked={globalSettings.sonarr_season_folder !== false} />
                  <div class="relative w-10 h-5 bg-zinc-700 peer-checked:bg-blue-600 rounded-full transition-colors pointer-events-none shrink-0 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:bg-white after:rounded-full after:transition-transform peer-checked:after:translate-x-5"></div>
                </label>
                <label class="flex items-center gap-3 cursor-pointer select-none pt-1">
                  <input type="checkbox" name="sonarr_require_approval" id="sonarr_require_approval" value="true"
                    checked={globalSettings.sonarr_require_approval ?? false}
                    class="w-4 h-4 rounded border-zinc-600 bg-zinc-950 text-blue-500 focus:ring-blue-500 cursor-pointer" />
                  <span class="text-sm text-zinc-300">{m.admin_require_admin_approval_for_requests()}</span>
                </label>
                <label class="flex items-center justify-between gap-3 p-3 bg-zinc-950 border border-zinc-800 rounded-lg cursor-pointer hover:bg-zinc-800/60 transition-colors">
                  <span class="text-sm text-zinc-300">{m.admin_let_admins_customize_root_folder_quality_2()}</span>
                  <input type="checkbox" name="sonarr_customize_on_add" id="sonarr_customize_on_add" value="true" class="sr-only peer" checked={globalSettings.sonarr_customize_on_add ?? false} />
                  <div class="relative w-10 h-5 bg-zinc-700 peer-checked:bg-blue-600 rounded-full transition-colors pointer-events-none shrink-0 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:bg-white after:rounded-full after:transition-transform peer-checked:after:translate-x-5"></div>
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- Privacy -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6">
          <label class="flex items-center justify-between gap-3 has-[:disabled]:opacity-50 has-[:disabled]:cursor-not-allowed cursor-pointer">
            <div>
              <span class="block text-sm font-semibold text-zinc-200">{m.admin_allow_browsing_without_an_account()}</span>
              <span class="block text-xs text-zinc-500 mt-0.5">
                {globalSettings.tmdb_api_key
                  ? m.admin_browse_anon_hint()
                  : m.admin_browse_anon_requires_tmdb()}
              </span>
            </div>
            <input type="checkbox" name="enable_logged_out_navigation" id="enable_logged_out_navigation" value="true" class="sr-only peer"
              checked={globalSettings.enable_logged_out_navigation ?? false}
              disabled={!globalSettings.tmdb_api_key} />
            <div class="relative w-10 h-5 bg-zinc-700 peer-checked:bg-blue-600 rounded-full transition-colors pointer-events-none shrink-0 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:bg-white after:rounded-full after:transition-transform peer-checked:after:translate-x-5"></div>
          </label>
        </div>

        <!-- Comments -->
        <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6">
          <label class="flex items-center justify-between gap-3 cursor-pointer">
            <div>
              <span class="block text-sm font-semibold text-zinc-200">{m.admin_disable_comments()}</span>
              <span class="block text-xs text-zinc-500 mt-0.5">{m.admin_hides_the_comments_section_from_every()}</span>
            </div>
            <input type="checkbox" name="disable_comments" id="disable_comments" value="true" class="sr-only peer"
              checked={globalSettings.disable_comments ?? false} />
            <div class="relative w-10 h-5 bg-zinc-700 peer-checked:bg-blue-600 rounded-full transition-colors pointer-events-none shrink-0 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:bg-white after:rounded-full after:transition-transform peer-checked:after:translate-x-5"></div>
          </label>
        </div>

        <div class="pt-2">
          <button type="submit" id="save-settings-btn"
            class="w-full sm:w-auto bg-zinc-100 text-zinc-950 font-bold px-8 py-3 rounded-xl hover:bg-zinc-200 transition-colors cursor-pointer disabled:opacity-50">
            {m.common_save_changes()}
          </button>
        </div>
      </form>
    </section>

    <!-- ── Performance Settings ── -->
    <section>
      <h2 class="section-headline border-b border-zinc-800 pb-2 mb-6">{m.admin_performance_settings()}</h2>
      <p class="text-zinc-400 text-sm mb-6">{m.admin_configure_media_caching_limits_and_system()}</p>

      <form id="performance-settings-form" class="space-y-6 bg-zinc-900 border border-zinc-800 rounded-2xl p-6">
        <!-- Enable Caching -->
        <label class="flex items-center justify-between gap-3 p-4 bg-zinc-950 border border-zinc-800 rounded-xl cursor-pointer hover:bg-zinc-800/40 transition-colors">
          <div>
            <span class="block text-sm font-semibold text-zinc-200">{m.admin_enable_tmdb_thetvdb_image_cache()}</span>
            <span class="block text-xs text-zinc-500 mt-0.5">{m.admin_cache_poster_backdrop_and_still_images()}</span>
          </div>
          <input type="checkbox" name="image_cache_enabled" id="image_cache_enabled" value="true" class="sr-only peer" checked={globalSettings.image_cache_enabled ?? false} />
          <div class="relative w-10 h-5 bg-zinc-700 peer-checked:bg-blue-600 rounded-full transition-colors pointer-events-none shrink-0 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-4 after:h-4 after:bg-white after:rounded-full after:transition-transform peer-checked:after:translate-x-5"></div>
        </label>

        <!-- Size Limit -->
        <div class="space-y-2 max-w-md">
          <label for="image_cache_limit_gb" class="block text-sm font-medium text-zinc-400">{m.admin_image_cache_size_limit_gb()}</label>
          <input
            type="number"
            name="image_cache_limit_gb"
            id="image_cache_limit_gb"
            min="0"
            step="0.1"
            placeholder={m.admin_0_unlimited()}
            value={globalSettings.image_cache_limit_gb ?? ""}
            class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
          />
          <p class="text-xs text-zinc-500">{m.admin_set_a_maximum_storage_limit_in()}</p>
        </div>

        <!-- Cache Usage -->
        <div id="cache-stats-widget" class="hidden p-4 bg-zinc-950 border border-zinc-800 rounded-xl space-y-2.5">
          <div class="flex items-center justify-between gap-2">
            <span id="cache-stats-label" class="text-sm text-zinc-400"></span>
            <span id="cache-stats-pct" class="text-sm font-semibold text-zinc-300 shrink-0"></span>
          </div>
          <div id="cache-progress-wrap" class="hidden space-y-1">
            <div class="h-2 bg-zinc-800 rounded-full overflow-hidden">
              <div id="cache-progress-bar" class="h-full rounded-full transition-all duration-500 bg-blue-500" style="width:0%"></div>
            </div>
            <div class="flex justify-between text-[11px] text-zinc-600">
              <span id="cache-used-label"></span>
              <span id="cache-limit-label"></span>
            </div>
          </div>
        </div>

        <div class="pt-2">
          <button type="submit" id="save-performance-btn"
            class="w-full sm:w-auto bg-zinc-100 text-zinc-950 font-bold px-8 py-3 rounded-xl hover:bg-zinc-200 transition-colors cursor-pointer disabled:opacity-50">
            {m.admin_save_performance_settings()}
          </button>
        </div>
      </form>
    </section>

    <!-- ── Users ── -->
    <section>
      <h2 class="section-headline border-b border-zinc-800 pb-2 mb-6">{m.search_tab_users()}</h2>

      <div class="bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-zinc-800 text-left">
              <th class="px-4 py-3 text-zinc-400 font-medium">{m.auth_username()}</th>
              <th class="px-4 py-3 text-zinc-400 font-medium hidden md:table-cell">{m.auth_email()}</th>
              <th class="px-4 py-3 text-zinc-400 font-medium">{m.admin_role()}</th>
              <th class="px-4 py-3 text-zinc-400 font-medium text-right hidden md:table-cell">{m.admin_actions()}</th>
              <th class="px-4 py-3 md:hidden w-8"></th>
            </tr>
          </thead>
          <tbody id="users-table-body">
            {users.map((u: AdminUser) => (
              <>
                <tr class="user-main-row border-b border-zinc-800/50 hover:bg-zinc-800/30 transition cursor-pointer select-none"
                    data-user-id={u.id} data-is-admin={u.is_admin} data-totp={u.totp_enabled ?? false} data-api-key={u.api_key}>
                  <td class="px-4 py-3 text-zinc-100 font-medium">
                    <div class="flex items-center gap-3">
                      <div class="w-8 h-8 shrink-0 rounded-full overflow-hidden bg-zinc-800 border border-zinc-700 flex items-center justify-center">
                        {u.avatar_url ? (
                          <img src={`/api/proxy${u.avatar_url}`} alt={u.username} class="w-full h-full object-cover" loading="lazy" />
                        ) : (
                          <span class="text-xs font-black text-zinc-400">{u.username[0].toUpperCase()}</span>
                        )}
                      </div>
                      {u.username}
                    </div>
                  </td>
                  <td class="px-4 py-3 text-zinc-400 hidden md:table-cell">{u.email}</td>
                  <td class="px-4 py-3">
                    {u.is_admin
                      ? <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">{m.admin_role_admin()}</span>
                      : <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold bg-zinc-700/50 text-zinc-400 border border-zinc-700">{m.admin_user()}</span>
                    }
                  </td>
                  <td class="px-4 py-3 text-right hidden md:table-cell">
                    <div class="flex items-center justify-end gap-2">
                      <button type="button" class="user-actions-btn inline-flex items-center gap-1.5 px-3 py-2.5 text-xs font-semibold rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 transition-all active:scale-95 cursor-pointer" aria-haspopup="menu" aria-expanded="false">
                        {m.admin_actions()}
                        <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                      </button>
                    </div>
                  </td>
                  <td class="px-4 py-3 md:hidden">
                    <svg class="row-chevron w-4 h-4 text-zinc-500 transition-transform ml-auto" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                  </td>
                </tr>
                <tr class="user-detail-row hidden border-b border-zinc-800/50 bg-zinc-800/20"
                    data-detail-for={u.id}>
                  <td colspan="5" class="px-4 py-4">
                    <div class="space-y-3">
                      <div class="md:hidden text-xs text-zinc-400">{u.email}</div>
                      <div>
                        <div class="text-xs text-zinc-500 mb-1">{m.admin_api_key()}</div>
                        <div class="flex items-center gap-2">
                          <code class="user-api-key flex-1 block bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-xs text-zinc-300 font-mono break-all">{u.api_key}</code>
                          <button class="copy-api-key-btn shrink-0 p-2 text-zinc-500 hover:text-zinc-300 hover:bg-zinc-700 rounded-lg transition-colors cursor-pointer" title={m.admin_copy_api_key()} aria-label={m.admin_copy_api_key()}>
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 01-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 011.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.976a9.06 9.06 0 00-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 01-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 00-3.375-3.375h-1.5a1.125 1.125 0 01-1.125-1.125v-1.5a3.375 3.375 0 00-3.375-3.375H9.75" />
                            </svg>
                          </button>
                        </div>
                      </div>
                      <div class="flex flex-wrap justify-end gap-2 md:hidden">
                        <button type="button" class="user-actions-btn inline-flex items-center gap-1.5 px-3 py-2.5 text-xs font-semibold rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 transition-all active:scale-95 cursor-pointer" aria-haspopup="menu" aria-expanded="false">
                        {m.admin_actions()}
                        <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                      </button>
                      </div>
                    </div>
                  </td>
                </tr>
              </>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Add a user -->
      <div class="mt-4 bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden">
        <div class="collapsible-header flex items-center justify-between px-6 py-4 hover:bg-zinc-900/40 cursor-pointer transition-colors select-none" data-target="add-user-body">
          <div class="flex items-center gap-3 pointer-events-none">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-zinc-400 shrink-0">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zM4 19.235v-.11a6.375 6.375 0 0112.75 0v.109A12.318 12.318 0 0110.374 21c-2.331 0-4.512-.645-6.374-1.766z" />
            </svg>
            <span class="font-medium text-zinc-200">{m.admin_add_a_user()}</span>
          </div>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="collapsible-chevron w-4 h-4 text-zinc-500 transition-transform pointer-events-none ml-1 shrink-0">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </div>
        <div id="add-user-body" class="border-t border-zinc-800 hidden">
          <form id="add-user-form" class="px-6 py-6 space-y-4 max-w-md">
            <div class="space-y-1.5">
              <label for="new-user-username" class="block text-sm font-medium text-zinc-400">{m.auth_username()}</label>
              <input type="text" id="new-user-username" name="username" required autocomplete="off"
                class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
            </div>
            <div class="space-y-1.5">
              <label for="new-user-email" class="block text-sm font-medium text-zinc-400">{m.auth_email()}</label>
              <input type="email" id="new-user-email" name="email" required autocomplete="off"
                class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
            </div>
            <div class="space-y-1.5">
              <label for="new-user-password" class="block text-sm font-medium text-zinc-400">{m.auth_password()}</label>
              <div class="relative">
                <input type="password" id="new-user-password" name="password" required autocomplete="new-password"
                  class="w-full bg-zinc-950 border border-zinc-800 rounded-lg pl-4 pr-10 py-3 text-zinc-100 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
