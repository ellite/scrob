---
import Base from "../layouts/Base.astro";
import SortButton from "../components/SortButton.astro";
export const prerender = false;

const { token } = Astro.locals;
Astro.response.headers.set("Cache-Control", "no-store");
---

<Base title="Next Up">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
    <div>
      <h1 class="page-title mb-2">Next Up</h1>
      <p class="text-zinc-500">Continue where you left off</p>
    </div>
    <div class="flex items-center gap-3">
    <SortButton
      id="next-up-sort"
      current="recent"
      label="Sort By"
      navigate={false}
      options={[
        { value: "recent", label: "Recently watched" },
        { value: "episodes_asc", label: "Episodes left ↑" },
        { value: "episodes_desc", label: "Episodes left ↓" },
        { value: "time_asc", label: "Time left ↑" },
        { value: "time_desc", label: "Time left ↓" },
      ]}
    />
    <button
      id="toggle-hidden-btn"
      class="flex items-center gap-2 px-4 py-2 text-sm font-bold text-zinc-400 bg-zinc-900 border border-zinc-800 rounded-xl hover:border-zinc-600 hover:text-zinc-200 transition-all cursor-pointer shrink-0"
    >
      <svg id="toggle-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/>
        <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/>
      </svg>
      <span id="toggle-label">Show hidden</span>
    </button>
    </div>
  </div>

  <div id="loading-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6">
    {Array.from({ length: 12 }).map(() => (
      <div class="animate-pulse rounded-2xl overflow-hidden bg-zinc-900 border border-zinc-800">
        <div class="aspect-[2/3] bg-zinc-800"></div>
        <div class="p-3 space-y-2">
          <div class="h-3 bg-zinc-800 rounded w-3/4"></div>
          <div class="h-2 bg-zinc-800 rounded w-1/2"></div>
        </div>
      </div>
    ))}
  </div>

  <div id="next-up-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6 hidden"></div>

  <div id="empty-state" class="hidden text-center py-20 text-zinc-500">
    <p class="text-lg">Nothing to watch next.</p>
    <p class="text-sm mt-2">Start watching a show to see your next episodes here.</p>
  </div>
</Base>

<script define:vars={{ token }}>
  function esc(str) {
    if (str == null) return '';
    return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function tmdbImageUrl(path, size = 'w500') {
    if (!path) return null;
    if (path.startsWith('http://') || path.startsWith('https://')) {
      const m = /image\.tmdb\.org\/t\/p\/([^/]+)(\/.+)$/.exec(path);
      if (m) return `/api/proxy/media/image/${m[1]}${m[2]}`;
      return path;
    }
    return `/api/proxy/media/image/${size}${path.startsWith('/') ? path : '/' + path}`;
  }

  const EYE_SLASH = `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>`;
  const EYE    = `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>`;
  const SPIN   = `<svg class="animate-spin" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10" stroke-opacity="0.25"/><path d="M12 2a10 10 0 0 1 10 10"/></svg>`;

  let showingHidden = false;
  let allItems = [];
  let sortMode = localStorage.getItem('nextUpSort') || 'recent';

  // 'recent' keeps the server's order (most recently watched first). The
  // other modes sort on the #170 stats; items without stats always sink to
  // the bottom, whatever the direction.
  function sortedItems() {
    if (sortMode === 'recent') return allItems;
    const key = sortMode.startsWith('episodes') ? 'episodes_left' : 'remaining_runtime';
    const dir = sortMode.endsWith('_desc') ? -1 : 1;
    return [...allItems].sort((a, b) => {
      const av = a[key], bv = b[key];
      if (av == null && bv == null) return 0;
      if (av == null) return 1;
      if (bv == null) return -1;
      return (av - bv) * dir;
    });
  }

  // Local copy of lib/media-format's formatEpisodesLeft — this define:vars
  // script can't import from lib/ (same reason tmdbImageUrl is re-implemented
  // above).
  function episodesLeftLabel(item) {
    const n = item.episodes_left;
    if (n == null || n <= 0) return null;
    let label = `${n} episode${n === 1 ? '' : 's'} left`;
    const mins = item.remaining_runtime;
    if (mins && mins > 0) {
      const h = Math.floor(mins / 60), m = mins % 60;
      label += ` · ~${h > 0 ? (m > 0 ? `${h}h ${m}m` : `${h}h`) : `${m}m`}`;
    }
    return label;
  }

  function buildCard(item) {
    const isHidden = item.next_up_hidden === true;
    // Local copy of lib/episodeHref's episode branch - this define:vars
    // script can't import (see lib/episodeHref.ts's header comment for the
    // full list of duplicate sites to keep in sync). #186: route to
    // /show/tvdb/... using the translated position when the show is set to
    // TVDB numbering, instead of guessing off tvdb_sourced alone.
    const href = !item.tvdb_sourced && item.show_episode_order === 'tvdb' && item.show_tvdb_id
      && item.tvdb_season_number != null && item.tvdb_episode_number != null
      ? `/show/tvdb/${item.show_tvdb_id}/season/${item.tvdb_season_number}/${item.tvdb_episode_number}`
      : !item.tvdb_sourced && item.show_tmdb_id && item.season_number != null && item.episode_number != null
      ? `/show/${item.show_tmdb_id}/season/${item.season_number}/${item.episode_number}`
      : item.show_tvdb_id && item.season_number != null && item.episode_number != null
        ? `/show/tvdb/${item.show_tvdb_id}/season/${item.season_number}/${item.episode_number}`
        : item.show_tmdb_id ? `/show/${item.show_tmdb_id}`
        : item.show_tvdb_id ? `/show/tvdb/${item.show_tvdb_id}`
        : item.tmdb_id ? `/media/${item.type}/${item.tmdb_id}` : '#';

    const posterSrc = tmdbImageUrl(item.show_poster_path || item.poster_path, 'w500');

    const rating = item.tmdb_rating ? Number(item.tmdb_rating).toFixed(1) : null;
    const sxe = item.season_number != null && item.episode_number != null
      ? `S${String(item.season_number).padStart(2, '0')}E${String(item.episode_number).padStart(2, '0')}`
      : null;

    const hideBtn = item.show_id != null ? `
      <button
        class="nextup-hide-btn absolute top-1.5 right-1.5 z-10 w-7 h-7 rounded-lg flex items-center justify-center transition-all duration-200 cursor-pointer ${isHidden ? 'bg-amber-900/60 border border-amber-600 text-amber-300 hover:bg-amber-700 hover:border-amber-500 hover:text-white' : 'bg-zinc-950/80 border border-zinc-800 text-zinc-500 hover:text-rose-200 hover:border-rose-700 hover:bg-rose-900'}"
        data-show-id="${esc(String(item.show_id))}"
        title="${isHidden ? 'Restore to Next Up' : 'Hide from Next Up'}"
      >${isHidden ? EYE : EYE_SLASH}</button>
    ` : '';

    // Hidden cards: rendered as opacity-50 + hidden (show/hide toggled by JS).
    // A re-render while "Show hidden" is active must keep them visible.
    const wrapperClass = isHidden ? (showingHidden ? 'opacity-50' : 'opacity-50 hidden') : '';

    return `
      <div class="${wrapperClass}" data-next-up-hidden="${isHidden ? 'true' : 'false'}">
        <div class="group relative flex flex-col rounded-2xl overflow-hidden bg-zinc-900 border border-zinc-800 hover:border-blue-500/50 hover:shadow-2xl hover:shadow-blue-900/20 transition-all duration-300 transform hover:-translate-y-1">
          <a href="${esc(href)}" class="block active:scale-95 active:opacity-70 transition-all duration-100">
            <div data-spoiler="next" class="aspect-[2/3] bg-zinc-950 relative overflow-hidden ring-1 ring-white/5 group-hover:ring-blue-500/30 transition-all duration-300">
              ${posterSrc
                ? `<img src="${esc(posterSrc)}" alt="${esc(item.show_title ?? item.title)}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" decoding="async" />`
                : `<div class="w-full h-full flex flex-col items-center justify-center text-zinc-700 bg-zinc-900 p-4 text-center"><span class="text-3xl mb-2 opacity-30">📺</span><span class="text-xs font-bold uppercase tracking-widest">${esc(item.show_title ?? item.title)}</span></div>`
              }
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              ${rating ? `<div data-spoiler="ratings" class="absolute top-2 left-2 bg-black/80 backdrop-blur-md text-yellow-400 text-[10px] font-black px-2 py-0.5 rounded-full shadow-lg border border-zinc-800 flex items-center gap-1"><span class="text-xs leading-none">★</span> ${esc(rating)}</div>` : ''}
            </div>
          </a>
          ${hideBtn}
          <a href="${esc(href)}" class="block p-3 bg-gradient-to-b from-zinc-900 to-zinc-950 flex-1">
            ${item.show_title ? `<h3 class="text-xs font-medium text-zinc-400 truncate mb-0.5">${esc(item.show_title)}</h3>` : ''}
            <h3 data-spoiler="next" class="text-sm font-bold text-zinc-100 group-hover:text-blue-400 truncate transition-colors leading-tight mb-1">${esc(item.title)}</h3>
            ${sxe ? `<p class="text-[11px] font-bold text-blue-400 tracking-wide">${esc(sxe)}</p>` : ''}
            ${episodesLeftLabel(item) ? `<p class="text-[11px] text-zinc-500 font-medium mt-0.5">${esc(episodesLeftLabel(item))}</p>` : ''}
          </a>
        </div>
      </div>
    `;
  }

  function renderGrid() {
    const grid = document.getElementById('next-up-grid');
    grid.innerHTML = sortedItems().map(buildCard).join('');
    document.dispatchEvent(new Event('spoiler-content-added'));
    grid.classList.remove('hidden');
    updateEmptyState();
    bindHideButtons();
  }

  function updateEmptyState() {
    const grid = document.getElementById('next-up-grid');
    const empty = document.getElementById('empty-state');
    const visibleCards = grid.querySelectorAll('[data-next-up-hidden="false"]');
    const anyVisible = visibleCards.length > 0;
    const anyHidden  = grid.querySelectorAll('[data-next-up-hidden="true"]').length > 0;
    const isEmpty = !anyVisible && (!showingHidden || !anyHidden);
    empty.classList.toggle('hidden', !isEmpty);
    grid.classList.toggle('hidden', isEmpty);
  }

  async function loadNextUp() {
    const grid    = document.getElementById('next-up-grid');
    const loading = document.getElementById('loading-grid');
    const empty   = document.getElementById('empty-state');

    try {
      const res = await fetch('/api/proxy/history/next-up?include_hidden=true', {
        headers: { 'Authorization': `Bearer ${token}` },
      });
      if (!res.ok) throw new Error('Failed');
      const data = await res.json();
      allItems = data.next_up ?? [];

      loading.classList.add('hidden');

      if (allItems.length === 0) {
        empty.classList.remove('hidden');
        return;
      }

      renderGrid();
    } catch {
      loading.classList.add('hidden');
      empty.classList.remove('hidden');
    }
  }

  function bindHideButtons() {
    document.querySelectorAll('.nextup-hide-btn').forEach(btn => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = 'true';

      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();

        const showId  = parseInt(btn.dataset.showId, 10);
        const wrapper = btn.closest('[data-next-up-hidden]');
        const isHidden = wrapper.dataset.nextUpHidden === 'true';

        btn.disabled = true;
        btn.innerHTML = SPIN;

        try {
          if (isHidden) {
            await fetch(`/api/proxy/history/next-up/hide?show_id=${showId}`, {
              method: 'DELETE',
              headers: { 'Authorization': `Bearer ${token}` },
            });
            // Restore — also sync allItems so a later re-sort re-render
            // doesn't resurrect the stale hidden state.
            const restored = allItems.find(i => i.show_id === showId);
            if (restored) restored.next_up_hidden = false;
            wrapper.dataset.nextUpHidden = 'false';
            wrapper.classList.remove('opacity-50', 'hidden');
            btn.classList.remove('bg-amber-900/60', 'border-amber-600', 'text-amber-300', 'hover:bg-amber-700', 'hover:border-amber-500', 'hover:text-white');
            btn.classList.add('bg-zinc-950/80', 'border-zinc-800', 'text-zinc-500', 'hover:text-white', 'hover:border-red-600', 'hover:bg-red-700');
            btn.title = 'Hide from Next Up';
            btn.innerHTML = EYE_SLASH;
          } else {
            await fetch('/api/proxy/history/next-up/hide', {
              method: 'POST',
              headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
              body: JSON.stringify({ show_id: showId }),
            });
            // Hide — same allItems sync as the restore branch above.
            const hidden = allItems.find(i => i.show_id === showId);
            if (hidden) hidden.next_up_hidden = true;
            wrapper.dataset.nextUpHidden = 'true';
            wrapper.classList.add('opacity-50');
            if (!showingHidden) {
              wrapper.classList.add('hidden');
            }
            btn.classList.remove('bg-zinc-950/80', 'border-zinc-800', 'text-zinc-500', 'hover:text-white', 'hover:border-red-600', 'hover:bg-red-700');
            btn.classList.add('bg-amber-900/60', 'border-amber-600', 'text-amber-300', 'hover:bg-amber-700', 'hover:border-amber-500', 'hover:text-white');
            btn.title = 'Restore to Next Up';
            btn.innerHTML = EYE;
          }
          btn.disabled = false;
          updateEmptyState();
        } catch {
          btn.disabled = false;
          btn.innerHTML = isHidden ? EYE : EYE_SLASH;
        }
      });
    });
  }

  // Toggle: show/hide hidden items in-place, no refetch
  document.getElementById('toggle-hidden-btn').addEventListener('click', () => {
    showingHidden = !showingHidden;

    document.getElementById('toggle-label').textContent = showingHidden ? 'Hide hidden' : 'Show hidden';

    // Swap the icon between eye-slash (show) and eye (hide)
    document.getElementById('toggle-icon').innerHTML = showingHidden
      ? `<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>`
      : `<path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/>`;

    document.querySelectorAll('[data-next-up-hidden="true"]').forEach(card => {
      card.classList.toggle('hidden', !showingHidden);
    });

    updateEmptyState();
  });

  const sortButton = document.getElementById('next-up-sort');
  const validSortModes = ['recent', 'episodes_asc', 'episodes_desc', 'time_asc', 'time_desc'];
  if (!validSortModes.includes(sortMode)) {
    // Unknown value lingering in localStorage — fall back to the default.
    sortMode = 'recent';
  }
  if (sortMode !== 'recent') {
    // The button is server-rendered as "recent" (localStorage isn't available
    // at that point) — sync the checked option and visible label to match.
    const input = sortButton.querySelector(`[data-role="option"][value="${sortMode}"]`);
    const optionLabel = input?.closest('label')?.querySelector('span')?.textContent;
    const triggerLabel = sortButton.querySelector('[data-role="trigger-label"]');
    if (input) input.checked = true;
    if (triggerLabel && optionLabel) triggerLabel.textContent = optionLabel;
  }
  sortButton.addEventListener('sortchange', (e) => {
    sortMode = e.detail.value;
    localStorage.setItem('nextUpSort', sortMode);
    if (allItems.length) renderGrid();
  });

  loadNextUp();
</script>
